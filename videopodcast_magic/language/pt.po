msgstr "Tocando %s -- a gravação bruta.\nÉ bem mais baixa que o áudio processado; assim que as faixas de auphonic.com\nestiverem prontas, a pré-visualização usa essas."

msgid "%s: not seekable yet, will follow (%s)"
msgstr "%s: ainda não posicionável, será feito depois (%s)"

msgid " SEEKING"
msgstr " BUSCANDO"

msgid "MUTED"
msgstr "MUDO"

msgid "  Player: %s reports an error -- %s"
msgstr "  Reprodutor: %s informa um erro -- %s"

