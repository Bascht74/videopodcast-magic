msgstr "%s kênh -- được cắt thành các rãnh, xem các dòng phía trên."

msgid "%s checked"
msgstr "đã kiểm tra %s"

msgid "%s of %s comparisons are below %s dB -- every recording against every other, in both directions."
msgstr "%s trên %s phép so sánh dưới %s dB -- mỗi bản ghi với mọi bản ghi khác, theo cả hai chiều."

msgid "%s of %s video files carry no curve and no colour space in the colr box%s -- probably log material."
msgstr "%s trên %s tệp video không có đường cong và không gian màu trong hộp colr%s -- có lẽ là tư liệu log."

msgid "%r is a Timecode, but there is no picture here and so no camera to count it from. Then only a value from the window start works, such as +12:30."
msgstr "%r là mã thời gian, nhưng ở đây không có hình ảnh nên cũng không có máy quay để tính từ đó. Khi đó chỉ dùng được giá trị tính từ đầu khoảng thời gian, ví dụ +12:30."

msgid "%r is a Timecode, but the time axis hangs on no clock: no file here carries one, the reference camera %s included. Then only a value from the window start works, such as +12:30."
msgstr "%r là mã thời gian, nhưng trục thời gian không gắn với đồng hồ nào: không tệp nào ở đây có mã thời gian, kể cả máy quay tham chiếu %s. Khi đó chỉ dùng được giá trị tính từ đầu khoảng thời gian, ví dụ +12:30."

msgid "%r is not a Multitrack preset"
msgstr "%r không phải cài đặt sẵn Multitrack"

msgid "%r is not a number."
msgstr "%r không phải là số."

msgid "%s\n   does not fit the other files: sound not recognised, no timecode.\n   %s"
msgstr "%s\n   không khớp với các tệp khác: không nhận ra âm thanh, không có mã thời gian.\n   %s"

msgid "Set to %s; %s is one click away."
msgstr "Đã đặt thành %s; %s chỉ cách một cú nhấp."

msgid "Left out, %s being taken already; %s is one click away."
msgstr "Bị bỏ ra, vì %s đã được dùng; %s chỉ cách một cú nhấp."

msgid "Its sound cannot be used."
msgstr "Âm thanh của nó không dùng được."

msgid "%s\n   sound not recognised; placed by its timecode"
msgstr "%s\n   không nhận ra âm thanh; đặt theo mã thời gian"

msgid "%s   --   the app does not know this format"
msgstr "%s   --   ứng dụng không biết định dạng này"

msgid "%s  (%s)  --  %s  --  %s blocks"
msgstr "%s  (%s)  --  %s  --  %s khối"

msgid "%s -- what should happen with it?\nThe details are in the log."
msgstr "%s -- cần xử lý thế nào?\nChi tiết có trong nhật ký."

msgid "%s kHz instead of %s kHz -- converted during processing."
msgstr "%s kHz thay vì %s kHz -- được chuyển đổi khi xử lý."

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and the file carries no timecode. It needs one that fits the other recordings, and that has to be set with another program."
msgstr "Không đặt được %s: âm thanh của nó không có gì chung với phần còn lại của tư liệu, và tệp không có mã thời gian. Nó cần một mã khớp với các bản ghi khác, và mã đó phải được đặt bằng chương trình khác."

msgid "%s fits nothing in the material and is far shorter than the rest: proposed as the intro, which is put at the front and never measured."
msgstr "%s không khớp với phần nào trong tư liệu và ngắn hơn nhiều so với phần còn lại: đề xuất làm phần mở đầu, được đặt ở đầu và không bao giờ được đo."

msgid "%s is set, and nothing is adjusted here: the tracks leave as they were recorded, and the loudness is set where they are mixed."
msgstr "Đã đặt %s, và ở đây không chỉnh gì: các rãnh ra đi đúng như khi được ghi, và độ to được đặt ở nơi chúng được trộn."

msgid "%s can be placed again and is back in the run."
msgstr "%s lại xếp được vào chỗ và đã trở lại lượt chạy."

msgid "%s could not be installed.\nBy hand:  %s -m pip install %s"
msgstr "Không thể cài đặt %s.\nLàm thủ công:  %s -m pip install %s"

msgid "%s has no audio track."
msgstr "%s không có rãnh âm thanh."

msgid "%s in %s"
msgstr "%s trong %s"

msgid "%s in %s's microphone: %s dB quieter than in their own."
msgstr "%s trong micrô của %s: nhỏ hơn %s dB so với trong micrô của chính mình."

msgid "%s is in %s -- the file is now in the player."
msgstr "%s nằm trong %s -- tệp này hiện đã ở trong trình phát."

msgid "%s is not on the axis of the episode: it is set in front of the material or after it, not cut into it. In point and Out point belong to what lies between."
msgstr "%s không nằm trên trục thời gian của tập: nó được đặt trước hoặc sau tư liệu, không dựng vào bên trong. Điểm vào và điểm ra thuộc về phần nằm giữa."

msgid "%s is in none of the video files. Is there a timecode that fits the material?"
msgstr "%s không nằm trong tệp video nào. Có mã thời gian nào khớp với tư liệu không?"

msgid "%s%s in %s's microphone only %s dB quieter"
msgstr "%s%s trong micrô của %s chỉ nhỏ hơn %s dB"

msgid "%s: not seekable yet, will follow (%s)"
msgstr "%s: chưa tua được, sẽ làm sau (%s)"

msgid "%s: not there"
msgstr "%s: không có ở đó"

msgid "%s: setPosition(%s), attempt %d, then at %s"
msgstr "%s: setPosition(%s), lần thử %d, sau đó ở %s"

msgid "%s: should go to %s%s -- %s"
msgstr "%s: cần chuyển đến %s%s -- %s"

msgid ", no audio"
msgstr ", không có âm thanh"

msgid "-- only one camera"
msgstr "-- chỉ có một máy quay"

msgid "--- jump to %s programme time%s ---"
msgstr "--- nhảy đến %s thời gian chương trình%s ---"

msgid "--- point set, programme time runs from %s ---"
msgstr "--- đã đặt điểm, thời gian chương trình chạy từ %s ---"

msgid "... or add files ..."
msgstr "... hoặc thêm tệp ..."

msgid "/not seekable"
msgstr "/không tua được"

msgid "<span style='color:%(t)s'><b>%(n)s shots</b>, median %(med)s s, shortest %(short)s s, longest camera %(long)s s</span>. Speech time: <b>%(own)s %%</b> on their own camera (%(own_t)s), %(wide)s %% on the wide shot (%(wide_t)s), <span style='color:%(warn)s'>at %(off)s %% (%(off_t)s) the speaker's camera is not active</span>"
msgstr "<span style='color:%(t)s'><b>%(n)s cảnh quay</b>, trung vị %(med)s s, ngắn nhất %(short)s s, máy quay dài nhất %(long)s s</span>. Thời gian nói: <b>%(own)s %%</b> trên máy quay của chính người nói (%(own_t)s), %(wide)s %% trên cảnh rộng (%(wide_t)s), <span style='color:%(warn)s'>ở %(off)s %% (%(off_t)s) máy quay của người nói không hoạt động</span>"

msgid "Every pair of channels is judged on its own: one stereo track, or two microphones and therefore two tracks. Silent inputs drop out. The rows under the file say what was measured, and the tick overrules it."
msgstr "Mỗi cặp kênh được đánh giá riêng: một rãnh stereo, hoặc hai micrô và vì vậy hai rãnh. Đầu vào im lặng bị loại. Các dòng dưới tệp cho biết đã đo được gì, và dấu tích sẽ ghi đè lên đó."

msgid "Add files ..."
msgstr "Thêm tệp ..."

msgid "Alignment goes by the measured offset; the timecode is only the cross-check."
msgstr "Căn chỉnh dựa theo độ lệch đo được; mã thời gian chỉ để đối chiếu."

msgid "All recordings carry the same name -- that makes a single track."
msgstr "Tất cả bản ghi mang cùng một tên -- như vậy chỉ thành một rãnh."

msgid "All rows carry the same name -- that makes a single track, and Multitrack needs at least two."
msgstr "Tất cả các dòng đều cùng một tên -- như vậy chỉ thành một rãnh, mà Multitrack cần ít nhất hai."

msgid "Assignment: which audio track belongs to which camera"
msgstr "Gán: rãnh âm thanh nào thuộc máy quay nào"

msgid "Audio"
msgstr "Âm thanh"

msgid "Audio and video (%s);;All files (*)"
msgstr "Âm thanh và video (%s);;Tất cả tệp (*)"

msgid "Audio at programme time"
msgstr "Âm thanh theo thời gian chương trình"

msgid "Auphonic created different tracks than requested: %s instead of %s"
msgstr "Auphonic đã tạo các rãnh khác với yêu cầu: %s thay vì %s"

msgid "Auphonic reports an error: %s"
msgstr "Auphonic báo lỗi: %s"

msgid "Bleed"
msgstr "Rò tiếng"

msgid "Blocks"
msgstr "Khối"

msgid "Both at once does not work: the returning tracks would go to one value, our own mix to the other. Either set --lufs %.0f or change the preset."
msgstr "Cả hai cùng lúc thì không được: các rãnh trả về sẽ theo một giá trị, bản trộn của chương trình theo giá trị kia. Hoặc đặt --lufs %.0f, hoặc đổi cài đặt sẵn."

msgid "Camera"
msgstr "Máy quay"

msgid "Camera audio, %s to go ..."
msgstr "Âm thanh máy quay, còn %s ..."

msgid "%s -- preview  (length %s)"
msgstr "%s -- xem trước  (độ dài %s)"

msgid "Why the run cannot start"
msgstr "Vì sao lượt chạy không thể bắt đầu"

msgid "Cannot start yet: %s"
msgstr "Chưa thể bắt đầu: %s"

msgid "Change rejected: %s"
msgstr "Thay đổi bị từ chối: %s"

msgid "Check again"
msgstr "Kiểm tra lại"

msgid "Check the connection to Resolve again"
msgstr "Kiểm tra lại kết nối với Resolve"

msgid "Check itself failed: %s"
msgstr "Bản thân việc kiểm tra thất bại: %s"

msgid "Check the key and fetch Presets."
msgstr "Kiểm tra khóa và lấy cài đặt sẵn."

msgid "Chosen"
msgstr "Đã chọn"

msgid "Clock %7.2f%s | B1[%s] %s | B2[%s] %s | Audio %s %s"
msgstr "Đồng hồ %7.2f%s | B1[%s] %s | B2[%s] %s | Âm thanh %s %s"

msgid "Close"
msgstr "Đóng"

msgid "Connects to Resolve again."
msgstr "Kết nối lại với Resolve."

msgid "Content: a camera like any other.\nWide shot: a camera nobody sits in front of -- it takes no speaker, and the cut goes to it in a pause and in a long monologue.\nIntro and outro are finished clips -- not aligned, not processed, only placed in the Timeline.\nIgnore video: the file stays out entirely."
msgstr "Nội dung: một máy quay như mọi máy quay khác.\nCảnh rộng: một máy quay không ai ngồi trước -- nó không nhận người nói nào, và bản dựng chuyển sang nó khi có khoảng lặng và khi độc thoại dài.\nPhần mở đầu và phần kết là các clip hoàn chỉnh -- không căn chỉnh, không xử lý, chỉ đặt vào Timeline.\nBỏ qua video: tệp bị loại hoàn toàn."

msgid "  %s wide shots: the cut uses %s."
msgstr "  %s cảnh rộng: bản dựng dùng %s."

msgid "  Every camera carries a speaker, so there is no wide shot: the four wide shot settings and the tick for the edges do nothing here."
msgstr "  Máy quay nào cũng có người nói, nên không có cảnh rộng: bốn cài đặt cảnh rộng và dấu chọn cho hai đầu ở đây không có tác dụng."

msgid "No camera is free of speakers, so there is no wide shot: the four wide shot settings and the tick for the edges do nothing. Give a camera the Kind \"Wide shot\", or leave one without a speaker."
msgstr "Không có máy quay nào trống người nói, nên không có cảnh rộng: bốn cài đặt cảnh rộng và dấu chọn cho hai đầu không có tác dụng. Hãy đặt Loại \"Cảnh rộng\" cho một máy quay, hoặc để một máy quay không có người nói."

msgid "placed by phase, sharpness %s against a floor of %s, drift unknown"
msgstr "đặt theo pha, độ sắc %s so với ngưỡng %s, độ trôi không rõ"

msgid "placed on the bands that move"
msgstr "đặt theo các dải tần có biến động"

msgid "Why the wide shot settings are grey"
msgstr "Vì sao các cài đặt cảnh rộng bị mờ"

msgid "because no speaker is assigned to it"
msgstr "vì không có người nói nào được gán cho nó"

msgid "marked as the wide shot -- it takes no speakers"
msgstr "được đánh dấu là cảnh rộng -- không nhận người nói"

msgid "no speaker is assigned to it, but the cut uses %s"
msgstr "không có người nói nào được gán cho nó, nhưng bản dựng dùng %s"

msgid "the cut uses %s"
msgstr "bản dựng dùng %s"

msgid "Curve and colour space are missing from the file"
msgstr "Tệp thiếu đường cong và không gian màu"

msgid "In point and Out point are available once the time axis is set -- from the timecode or measured."
msgstr "Điểm vào và điểm ra sẽ dùng được khi trục thời gian đã xác định -- từ mã thời gian hoặc bằng cách đo."

msgid "In point is %s before the first frame"
msgstr "Điểm vào nằm trước khung hình đầu tiên %s"

msgid "In point is now %s, but the existing files belong to %s.\n  The audio in the videos is cut to the old window -- press Start\n  above again."
msgstr "Điểm vào giờ là %s, nhưng các tệp hiện có thuộc về %s.\n  Âm thanh trong video được cắt theo khoảng cũ -- hãy nhấn Bắt đầu\n  ở trên lần nữa."

msgid "Out point is %s after the last frame"
msgstr "Điểm ra nằm sau khung hình cuối cùng %s"

msgid "Out point is now %s; the window would be %s long, the existing\n  files are %s -- press Start above again."
msgstr "Điểm ra giờ là %s; khoảng thời gian sẽ dài %s, các tệp hiện có\n  dài %s -- hãy nhấn Bắt đầu ở trên lần nữa."

msgid "Delivery usually takes the limited range. Full is not wrong, but some players misread it."
msgstr "Khi xuất bản thường dùng dải giới hạn. Dải đầy đủ không sai, nhưng một số trình phát đọc sai."

msgid "Determines how auphonic.com processes the audio.\n\n\"%s\" leaves the key in place and still does not go there.\nThe audio is then only merged and normalised, not unmixed --\nand without separate tracks there is no camera cut."
msgstr "Quyết định auphonic.com xử lý âm thanh thế nào.\n\n\"%s\" giữ nguyên khóa nhưng vẫn không gửi đến đó.\nKhi đó âm thanh chỉ được gộp và chuẩn hóa, không được tách --\nvà không có các rãnh riêng thì không có dựng chuyển máy quay."

msgid "Distance to mean"
msgstr "Độ lệch so với trung bình"

msgid "Drag audio and video files here"
msgstr "Kéo tệp âm thanh và video vào đây"

msgid "Dry run: only measuring, nothing written, nothing uploaded."
msgstr "Chạy thử: chỉ đo, không ghi gì, không tải lên gì."

msgid "During greeting and farewell the picture stays wide."
msgstr "Trong lúc chào đầu và tạm biệt cuối, hình ảnh giữ ở cảnh rộng."

msgid "The frames stand a little longer; the file is not any shorter for it. Editing software repeats about one frame every %s s, and picture and camera audio stay together."
msgstr "Mỗi khung hình hiển thị dài hơn một chút; tệp không vì thế mà ngắn hơn. Phần mềm dựng lặp lại khoảng một khung hình mỗi %s s, và hình ảnh cùng âm thanh máy quay vẫn khớp nhau."

msgid "The frames stand a little shorter; the file is not any longer for it. Editing software leaves out about one frame every %s s, and picture and camera audio stay together."
msgstr "Mỗi khung hình hiển thị ngắn hơn một chút; tệp không vì thế mà dài hơn. Phần mềm dựng bỏ đi khoảng một khung hình mỗi %s s, và hình ảnh cùng âm thanh máy quay vẫn khớp nhau."

msgid "Eight bits are not enough for HDR: every gradient bands, and YouTube requires ten or twelve."
msgstr "Tám bit không đủ cho HDR: mọi dải chuyển màu đều bị phân dải, và YouTube yêu cầu mười hoặc mười hai."

msgid "Envelope"
msgstr "Đường bao"

msgid "  %s is placed on %s, which is no camera of this run -- the cut names it all the same."
msgstr "  %s được đặt trên %s, vốn không phải máy quay của lượt chạy này -- bản dựng vẫn ghi tên nó."

msgid "Envelope failed: %s"
msgstr "Tạo đường bao thất bại: %s"

msgid "Envelopes and camera audio are prepared in the background."
msgstr "Đường bao và âm thanh máy quay được chuẩn bị ở chế độ nền."

msgid "Every row needs a name -- at Auphonic it becomes the track ID."
msgstr "Mỗi dòng cần một tên -- tại Auphonic tên đó trở thành track ID."

msgid "External preview -- the app does not know this format"
msgstr "Xem trước bên ngoài -- ứng dụng không biết định dạng này"

msgid "Fetching audio"
msgstr "Đang lấy âm thanh"

msgid "Fetching audio ..."
msgstr "Đang lấy âm thanh ..."

msgid "File"
msgstr "Tệp"

msgid "Files are missing there -- without a new upload nothing can be computed.\n  With --auphonic-resume upload the script uploads again; this costs credit."
msgstr "Ở đó thiếu tệp -- không tải lên lại thì không tính được gì.\n  Với --auphonic-resume upload, script sẽ tải lên lại; việc này tốn tín dụng."

msgid "For HDR the usual choice is HEVC (Main 10), AV1 or VP9 Profile 2. YouTube takes H.264 too, but it needs more bitrate."
msgstr "Với HDR, lựa chọn thường dùng là HEVC (Main 10), AV1 hoặc VP9 Profile 2. YouTube cũng nhận H.264, nhưng cần bitrate cao hơn."

msgid "For ten bits HEVC needs the Main 10 profile. In Resolve it sits under Deliver as \"Profile\"."
msgstr "Để có mười bit, HEVC cần cấu hình Main 10. Trong Resolve, mục này nằm trong Deliver với tên \"Profile\"."

msgid "%s fps, not the %s in the file -- %s fewer frames in the same length."
msgstr "%s fps, không phải %s như trong tệp -- ít hơn %s khung hình trên cùng độ dài."

msgid "%s fps, not the %s in the file -- %s more frames in the same length."
msgstr "%s fps, không phải %s như trong tệp -- nhiều hơn %s khung hình trên cùng độ dài."

msgid "Frame spacing varies by %s %% -- the frame timing is uneven."
msgstr "Khoảng cách khung hình dao động %s %% -- nhịp khung hình không đều."

msgid "Free space there: %s"
msgstr "Dung lượng trống ở đó: %s"

msgid "Gap of %s between block %d and %d -- the camera stopped."
msgstr "Khoảng trống %s giữa khối %d và %d -- máy quay đã dừng."

msgid "Drag to move the position."
msgstr "Kéo để di chuyển vị trí."

msgid "HDR needs 16 here (PQ, that is HDR10) or 18 (HLG). In Resolve: Gamma tag = ST.2084 or HLG. 14 is not an HDR curve but SDR in the BT.2020 space."
msgstr "HDR cần giá trị 16 ở đây (PQ, tức HDR10) hoặc 18 (HLG). Trong Resolve: Gamma tag = ST.2084 hoặc HLG. 14 không phải đường cong HDR mà là SDR trong không gian BT.2020."

msgid "HDR needs 9 here (BT.2020). In Resolve: Color space tag = Rec.2020."
msgstr "HDR cần giá trị 9 ở đây (BT.2020). Trong Resolve: Color space tag = Rec.2020."

msgid "HDR needs 9 here (BT.2020, non-constant luminance)."
msgstr "HDR cần giá trị 9 ở đây (BT.2020, độ chói không hằng định)."

msgid "HLG is display-referred -- it has no entry for the mastering display."
msgstr "HLG tham chiếu theo màn hình -- không có mục nào cho màn hình mastering."

msgid "If empty: next to each video file."
msgstr "Nếu để trống: cạnh từng tệp video."

msgid "It arose during the recording and cannot be changed now. The less the microphones are separated, the more cautiously De-Bleed at auphonic.com can work. Next time: three times as far from the neighbouring microphone as from your own mouth, then the neighbouring voice sits about %s dB lower."
msgstr "Điều này phát sinh khi ghi âm và giờ không thể thay đổi. Micrô càng ít tách biệt, De-Bleed tại auphonic.com càng phải làm việc thận trọng. Lần sau: đặt cách micrô bên cạnh xa gấp ba lần khoảng cách đến miệng của bạn, khi đó giọng bên cạnh sẽ thấp hơn khoảng %s dB."

msgid "%s fits nothing in the material, so it cannot be cut into the episode: set to Intro."
msgstr "%s không khớp với phần nào trong tư liệu nên không thể dựng vào tập: đặt làm phần mở đầu."

msgid "%s fits nothing in the material either, and the intro is taken: left out."
msgstr "%s cũng không khớp với phần nào trong tư liệu, và phần mở đầu đã có: bỏ ra ngoài."

msgid "%s is already set as %s, and an episode has one of those. Answer differently here, or take the mark off that file first."
msgstr "%s đã được đặt là %s, và một tập chỉ có một cái như vậy. Hãy chọn câu trả lời khác ở đây, hoặc bỏ đánh dấu ở tệp kia trước."

msgid "It is in the logs atom of the picture description -- that is how Resolve recognises the input colour space. Different curves mean different input colour spaces."
msgstr "Nó nằm trong atom logs của phần mô tả hình ảnh -- Resolve nhận ra không gian màu đầu vào qua đó. Đường cong khác nhau nghĩa là không gian màu đầu vào khác nhau."

msgid "Jumps to the end of the window."
msgstr "Nhảy đến cuối khoảng thời gian."

msgid "Jumps to the start of the window."
msgstr "Nhảy đến đầu khoảng thời gian."

msgid "Keychain"
msgstr "Chuỗi khóa"

msgid "Limits the de-bleed: "
msgstr "Hạn chế De-Bleed: "

msgid "Load Presets and pick one, or leave the API Key empty."
msgstr "Tải các cài đặt sẵn và chọn một, hoặc để trống khóa API."

msgid "Main10 rejected -- the default stays"
msgstr "Main10 bị từ chối -- giữ mặc định"

msgid "Measure only -- nothing is written or uploaded."
msgstr "Chỉ đo -- không ghi hay tải lên gì."

msgid "Measuring %s (%s of %s)"
msgstr "Đang đo %s (%s/%s)"

msgid "Measuring not possible: %s"
msgstr "Không thể đo: %s"

msgid "Measuring the yardstick"
msgstr "Đo mức chuẩn"

msgid "Measuring time axis ..."
msgstr "Đang đo trục thời gian ..."

msgid "Missing audio %s filled with silence%s"
msgstr "Âm thanh thiếu %s được lấp bằng im lặng%s"

msgid "Module DaVinciResolveScript cannot be loaded: %s"
msgstr "Không tải được mô-đun DaVinciResolveScript: %s"

msgid "One audio track per person, kept apart all the way to auphonic.com.\nWorks without it as well -- then without de-bleed and leveler.\nIt needs two input tracks: a recording of its own, a channel of a\nmultichannel recorder, or the audio of a video file set to \"use\nthe audio\". The camera cut does not need this tick."
msgstr "Mỗi người một rãnh âm thanh, giữ riêng cho đến tận auphonic.com.\nKhông có nó cũng được -- khi đó không có De-Bleed và Leveler.\nCần hai rãnh đầu vào: một bản ghi riêng, một kênh của máy ghi\nnhiều kênh, hoặc âm thanh của một tệp video được đặt thành\n\"dùng âm thanh tích hợp\". Dựng chuyển máy quay không cần dấu tích này."

msgid "Multitrack (one track per speaker)"
msgstr "Multitrack (mỗi người nói một rãnh)"

msgid "Multitrack needs at least two input tracks. A track is a recording of its own, a channel of a multichannel recorder, or the audio of a video file set to \"use internal audio\". Several blocks of the same recording count as one, tracks set aside not at all."
msgstr "Multitrack cần ít nhất hai rãnh đầu vào. Một rãnh là một bản ghi riêng, một kênh của máy ghi nhiều kênh, hoặc âm thanh của một tệp video được đặt thành \"dùng âm thanh tích hợp\". Nhiều khối của cùng một bản ghi được tính là một, các rãnh để riêng ra thì không tính."

msgid "No API key. Pass --auphonic-api-key KEY, set AUPHONIC_TOKEN or have it remembered once in the interface. The key is in the Auphonic account settings."
msgstr "Không có khóa API. Hãy truyền --auphonic-api-key KHÓA, đặt AUPHONIC_TOKEN hoặc để giao diện ghi nhớ một lần. Khóa nằm trong phần cài đặt tài khoản Auphonic."

msgid "No audio file carries a timecode. In point and Out point count from the start of the material -- the position of the files to each other is measured."
msgstr "Không tệp âm thanh nào có mã thời gian. Điểm vào và điểm ra được tính từ đầu tư liệu -- vị trí tương đối giữa các tệp đã được đo."

msgid "No sound in use yet -- add an audio recording, or set a video file's Camera audio to \"use internal audio\" in the file list."
msgstr "Chưa dùng âm thanh nào -- thêm một bản ghi âm, hoặc trong danh sách tệp đặt Âm thanh máy quay của một tệp video thành \"dùng âm thanh tích hợp\"."

msgid "No audio tracks are assigned."
msgstr "Không có rãnh âm thanh nào được gán."

msgid "No camera is assigned, so there is nothing to cut between."
msgstr "Không có máy quay nào được gán, nên không có gì để chuyển cảnh qua lại."

msgid "No cameras assigned yet -- switch Multitrack on to do that."
msgstr "Chưa gán máy quay nào -- hãy bật Multitrack để làm việc này."

msgid "No connection to Resolve.\n  Is the program running? Is external scripting set to 'Local'\n  under Preferences > System > General?"
msgstr "Không kết nối được với Resolve.\n  Chương trình có đang chạy không? External scripting trong\n  Preferences > System > General có đặt là 'Local' không?"

msgid "No files or project opened yet."
msgstr "Chưa mở tệp hay dự án nào."

msgid "No files selected yet."
msgstr "Chưa chọn tệp nào."

msgid "No input possible. Use %s %s to set what should happen."
msgstr "Không thể nhập. Dùng %s %s để đặt điều sẽ xảy ra."

msgid "No player is built in here -- playback runs in ffplay in its own window."
msgstr "Ở đây không có trình phát tích hợp -- phát lại chạy bằng ffplay trong cửa sổ riêng."

msgid "No preset given, no input possible. Choose one of the above with --auphonic-preset NAME."
msgstr "Chưa chỉ định cài đặt sẵn, không thể nhập. Hãy chọn một cái ở trên bằng --auphonic-preset TÊN."

msgid "No presets stored in the account. One can be created in the web interface."
msgstr "Tài khoản chưa lưu cài đặt sẵn nào. Có thể tạo một cái trong giao diện web."

msgid "No speaker is known here -- without who speaks when there is nothing to cut between."
msgstr "Ở đây chưa biết người nói nào -- không biết ai nói khi nào thì không có gì để chuyển cảnh qua lại."

msgid "No voice has a camera yet -- with that every shot would be the same one."
msgstr "Chưa có giọng nói nào có máy quay -- như vậy mọi cảnh quay sẽ giống hệt nhau."

msgid "No speakers known yet -- nothing measured, nothing separated, and no handover file of an earlier run in %s or its subfolders."
msgstr "Chưa biết người nói nào -- chưa đo gì, chưa tách gì, và không có tệp bàn giao của lượt chạy trước trong %s hoặc các thư mục con của nó."

msgid "Not found again after import: %s"
msgstr "Không tìm lại được sau khi nhập: %s"

msgid "from ffmpeg.org, and the folder into PATH"
msgstr "từ ffmpeg.org, và đưa thư mục vào PATH"

msgid "over the package manager: apt install ffmpeg, dnf install ffmpeg"
msgstr "qua trình quản lý gói: apt install ffmpeg, dnf install ffmpeg"

msgid "Here: %s. Needed: %s or newer."
msgstr "Ở đây: %s. Cần: %s hoặc mới hơn."

msgid "no answer"
msgstr "không có phản hồi"

msgid "Nothing runs until that is put right."
msgstr "Không có gì chạy được cho đến khi việc này được khắc phục."

msgid "Nothing runs until that is put right. This way: %s"
msgstr "Không có gì chạy cho đến khi việc này được khắc phục. Cách làm: %s"

msgid "Get it: %s"
msgstr "Tải về: %s"

msgid "Quit"
msgstr "Thoát"

msgid "That worked."
msgstr "Đã thành công."

msgid "Installing ffmpeg"
msgstr "Đang cài đặt ffmpeg"

msgid "Start the program again to pick it up."
msgstr "Hãy khởi động lại chương trình để áp dụng."

msgid "Getting it takes a few minutes, and what it says appears under Output."
msgstr "Việc tải về mất vài phút, và thông báo của nó hiện trong mục Đầu ra."

msgid "This takes a few minutes -- a package manager may build from source. What it says appears here."
msgstr "Việc này mất vài phút -- trình quản lý gói có thể biên dịch từ mã nguồn. Thông báo của nó hiện ở đây."

msgid "Now it is being compiled, and that is the long part: minutes on a fast machine and a good deal longer on an older one. Nothing is stuck -- a dot appears every few seconds for as long as it works."
msgstr "Bây giờ đang biên dịch, và đây là phần lâu nhất: vài phút trên máy nhanh và lâu hơn khá nhiều trên máy cũ. Không có gì bị treo -- chừng nào còn làm việc thì cứ vài giây lại hiện một dấu chấm."

msgid "ffmpeg is in place."
msgstr "ffmpeg đã sẵn sàng."

msgid "The program reads it when it starts. It can start again now, or you can do that yourself later."
msgstr "Chương trình đọc nó khi khởi động. Chương trình có thể khởi động lại ngay bây giờ, hoặc bạn tự làm việc này sau."

msgid "Start again now"
msgstr "Khởi động lại ngay"

msgid "Starting again did not work. Close the window and start the program the way you did before."
msgstr "Khởi động lại không thành công. Hãy đóng cửa sổ và khởi động chương trình theo cách bạn đã làm trước đó."

msgid "  Taking the ffmpeg that is there out of the way first: %s"
msgstr "  Trước tiên đưa ffmpeg hiện có ra khỏi đường: %s"

msgid "  A built ffmpeg 9.0.1 with soxr can be fetched: %s"
msgstr "  Có thể tải ffmpeg 9.0.1 dựng sẵn kèm soxr: %s"

msgid "  Fetch it now? [Y/n] "
msgstr "  Tải ngay bây giờ? [Y/n] "

msgid "  Fetching a built ffmpeg. It is a big one, so this takes a few minutes: %s"
msgstr "  Đang tải một ffmpeg dựng sẵn. Nó khá lớn, nên sẽ mất vài phút: %s"

msgid "  %s of %s MB"
msgstr "  %s / %s MB"

msgid "The build could not be fetched: %s"
msgstr "Không thể tải bản dựng sẵn: %s"

msgid "  The build could not be unpacked: %s"
msgstr "  Không thể giải nén bản dựng: %s"

msgid "  The archive held %s of the two programs."
msgstr "  Tệp nén chứa %s trong hai chương trình."

msgid "  It is here: %s"
msgstr "  Nó nằm ở đây: %s"

msgid "install Homebrew from brew.sh, then this again"
msgstr "cài Homebrew từ brew.sh, rồi chạy lại việc này"

msgid "This ffmpeg has soxr: the clock drift between cameras comes out in steps of 0.21 ppm."
msgstr "ffmpeg này có soxr: độ trôi đồng hồ giữa các máy quay được bù theo bước 0,21 ppm."

msgid "This ffmpeg has no soxr: the clock drift between cameras comes out in steps of 21 ppm instead of 0.21."
msgstr "ffmpeg này không có soxr: độ trôi đồng hồ giữa các máy quay được bù theo bước 21 ppm thay vì 0,21."

msgid "Everything works without it. Getting a build that has it takes a few minutes, and what it says appears under Output."
msgstr "Mọi thứ vẫn chạy khi không có nó. Tải một bản build có nó mất vài phút, và thông báo hiện trong mục Đầu ra."

msgid "Carry on"
msgstr "Tiếp tục"

msgid "Not mandatory -- YouTube then applies default values (Sony BVM-X300). To get them: in Resolve switch on HDR10+ under Color Management, run \"Analyze All Shots\" on the Color page and tick \"Embed HDR10 Metadata\" when rendering."
msgstr "Không bắt buộc -- khi đó YouTube dùng giá trị mặc định (Sony BVM-X300). Để có chúng: trong Resolve bật HDR10+ tại Color Management, chạy \"Analyze All Shots\" ở trang Color và đánh dấu \"Embed HDR10 Metadata\" khi render."

msgid "Not ready yet:"
msgstr "Chưa sẵn sàng:"

msgid "Nothing was audible in the tracks."
msgstr "Không nghe thấy gì trong các rãnh."

msgid "One audio recording has no speaker name yet."
msgstr "Một bản ghi âm chưa có tên người nói."

msgid "One frame back."
msgstr "Lùi một khung hình."

msgid "One second back."
msgstr "Lùi một giây."

msgid "Each shot in the colour of its camera. Hover for camera and duration, click to jump."
msgstr "Mỗi cảnh quay mang màu của máy quay tương ứng. Di chuột lên để xem máy quay và thời lượng, bấm để nhảy đến."

msgid "Only one speaker"
msgstr "Chỉ một người nói"

msgid "Open json project file"
msgstr "Mở tệp dự án json"

msgid "Open result folder"
msgstr "Mở thư mục kết quả"

msgid "Open the settings, where the key is."
msgstr "Mở cài đặt, nơi có khóa."

msgid "Order does not matter. For a multi-part recording the first block is enough."
msgstr "Thứ tự không quan trọng. Với bản ghi nhiều phần, chỉ cần khối đầu tiên."

msgid "Overwrite"
msgstr "Ghi đè"

msgid "Overwrite files"
msgstr "Ghi đè tệp"

msgid "Pane %d loads %s (%s)"
msgstr "Khung %d tải %s (%s)"

msgid "Pane %d on %s"
msgstr "Khung %d cho %s"

msgid "Play and pause -- the space bar works too."
msgstr "Phát và tạm dừng -- phím cách cũng được."

msgid "Play and pause."
msgstr "Phát và tạm dừng."

msgid "Playback not possible"
msgstr "Không thể phát"

msgid "Playing %s -- the processed track from auphonic.com,\nbrought to broadcast level. The same audio as in the camera cut."
msgstr "Đang phát %s -- rãnh đã xử lý từ auphonic.com,\nđưa về mức phát sóng. Cùng âm thanh như trong bản dựng chuyển máy quay."

msgid "Playing %s -- the raw recording.\nIt is much quieter than the processed audio; once the tracks from auphonic.com\nare there, the preview takes those."
msgstr "Đang phát %s -- bản ghi thô.\nNó nhỏ hơn nhiều so với âm thanh đã xử lý; khi các rãnh từ auphonic.com\ncó mặt, phần xem trước sẽ dùng chúng."

msgid "Prepare pane %d for %s"
msgstr "Chuẩn bị khung %d cho %s"

msgid "Preset not readable: %s"
msgstr "Không đọc được cài đặt sẵn: %s"

msgid "Preview not possible: %s"
msgstr "Không thể xem trước: %s"

msgid "Preview running ..."
msgstr "Đang chạy xem trước ..."

msgid "Prework -- read audio and compute envelopes:\n"
msgstr "Chuẩn bị -- đọc âm thanh và tính đường bao:\n"

msgid "Primaries"
msgstr "Màu cơ bản"

msgid "Primaries number %d"
msgstr "Màu cơ bản số %d"

msgid "Processing at auphonic.com (optional)"
msgstr "Xử lý tại auphonic.com (tùy chọn)"

msgid "Processing at auphonic.com with \"%s\""
msgstr "Xử lý tại auphonic.com với \"%s\""

msgid "Production finished, but no ZIP with the individual tracks"
msgstr "Bản sản xuất đã xong nhưng không có tệp ZIP chứa các rãnh riêng lẻ"

msgid "Production name"
msgstr "Tên bản sản xuất"

msgid "Chosen files"
msgstr "Tệp đã chọn"

msgid "Remove the chosen file from the list"
msgstr "Xóa tệp đã chọn khỏi danh sách"

msgid "Project %r could not be created."
msgstr "Không tạo được dự án %r."

msgid "Project %r could not be created. Is the name already in another folder?"
msgstr "Không tạo được dự án %r. Tên này đã có trong một thư mục khác chưa?"

msgid "Project %r could not be opened."
msgstr "Không mở được dự án %r."

msgid "Puts it back next to each video file."
msgstr "Đặt lại về cạnh từng tệp video."

msgid "ROLLBACK FAILED (%s)"
msgstr "HOÀN TÁC THẤT BẠI (%s)"

msgid "Reading audio track from %s"
msgstr "Đang đọc rãnh âm thanh từ %s"

msgid "Remove %s audio file from the list?\n\n%s"
msgid_plural "Remove all %s audio files from the list?\n\n%s"
msgstr[0] "Xóa %s tệp âm thanh khỏi danh sách?\n\n%s"

msgid "Remove %s video file from the list?\n\n%s"
msgid_plural "Remove all %s video files from the list?\n\n%s"
msgstr[0] "Xóa %s tệp video khỏi danh sách?\n\n%s"

msgid "Resolutions"
msgstr "Độ phân giải"

msgid "Resolve running ..."
msgstr "Resolve đang chạy ..."

msgid "Resolve scales to the Timeline resolution. Anything smaller is scaled up and gets softer."
msgstr "Resolve co giãn theo độ phân giải của Timeline. Cái nhỏ hơn sẽ được phóng to và mềm hơn."

msgid "Response was not JSON: %s"
msgstr "Phản hồi không phải JSON: %s"

msgid "Rows marked red show where the problem is; a tick on the tab means everything is there."
msgstr "Các hàng tô đỏ cho biết vấn đề ở đâu; dấu tích trên thẻ nghĩa là ở đó đã đủ mọi thứ."

msgid "Save in Keychain"
msgstr "Lưu vào Chuỗi khóa"

msgid "Save in Registry"
msgstr "Lưu vào Sổ đăng ký"

msgid "Select audio and video files"
msgstr "Chọn tệp âm thanh và video"

msgid "Speakers, as the run measured them"
msgstr "Người nói, theo số đo của lượt chạy"

msgid "Speakers, self-measured from the tracks"
msgstr "Người nói, tự đo từ các rãnh"

msgid "Started late or stopped early -- this voice is then missing from the mix in places."
msgstr "Bắt đầu muộn hoặc dừng sớm -- khi đó giọng nói này sẽ thiếu ở vài chỗ trong bản trộn."

msgid "Stopped. Choose another production name -- then a new production\n  is created -- or pick one of the other options."
msgstr "Đã dừng. Hãy chọn tên bản sản xuất khác -- khi đó một bản sản xuất mới\n  sẽ được tạo -- hoặc chọn một trong các tùy chọn khác."

msgid "Stopped. Nothing was created."
msgstr "Đã dừng. Không tạo gì cả."

msgid "Stopped. Nothing was uploaded and nothing computed."
msgstr "Đã dừng. Không tải lên gì và không tính gì."

msgid "Used as it stands -- nothing is invented. Check in Resolve under Clip Attributes, tab Color Space: if it says \"Project\" there, the input colour space was not recognised and has to be set by hand."
msgstr "Dùng đúng như hiện có -- không bịa ra gì. Kiểm tra trong Resolve tại Clip Attributes, thẻ Color Space: nếu ở đó ghi \"Project\", không gian màu đầu vào chưa được nhận ra và phải đặt thủ công."

msgid "Takes the position from the picture."
msgstr "Lấy vị trí từ hình ảnh."

msgid "Ten seconds back."
msgstr "Lùi mười giây."

msgid "The Resolve interface is not where I expect it:\n  %s\n  %s"
msgstr "Giao diện Resolve không nằm ở nơi mong đợi:\n  %s\n  %s"

msgid "The Resolve interface is not where it should be."
msgstr "Giao diện lập trình của Resolve không nằm ở nơi cần có."

msgid "The Timeline gets one fixed rate -- the highest of them, or the next rate Resolve has above it. It converts the others; with 23.976 against 24 that is where its audio analysis tends to stall."
msgstr "Timeline nhận một tốc độ cố định -- tốc độ cao nhất trong số đó, hoặc tốc độ kế tiếp phía trên mà Resolve có. Resolve chuyển đổi các tốc độ còn lại; với 23,976 so với 24, phân tích âm thanh của nó hay bị treo."

msgid "The audio recording of every speaker, plus the cameras.\nThe order does not matter -- the program recognises what is what.\nFor a multi-part recording the first block is enough."
msgstr "Bản ghi âm của từng người nói, cùng các máy quay.\nThứ tự không quan trọng -- chương trình tự nhận ra đâu là gì.\nVới bản ghi nhiều phần, chỉ cần khối đầu tiên."

msgid "The cut has no picture there. When the Timeline is built the spot stays empty, the audio runs on."
msgstr "Bản dựng không có hình ở đó. Khi dựng Timeline, chỗ đó để trống, âm thanh vẫn chạy tiếp."

msgid "The existing result is unusable: %s is missing there. With --auphonic-resume rerun it can be recomputed without uploading anything."
msgstr "Kết quả hiện có không dùng được: ở đó thiếu %s. Với --auphonic-resume rerun có thể tính lại mà không cần tải lên gì."

msgid "The cut rules leave no shot standing in these %s. A shorter shortest shot, or less wide shot, gives one again."
msgstr "Các quy tắc dựng không giữ lại cảnh quay nào trong %s này. Cảnh quay ngắn nhất ngắn hơn, hoặc ít cảnh rộng hơn, sẽ lại cho ra một cảnh."

msgid "The programme is %s long here -- nothing can be laid out in that. In point and Out point are what set it."
msgstr "Ở đây chương trình dài %s -- trong khoảng đó không dựng được gì. Điểm vào và điểm ra quyết định độ dài này."

msgid "The time window lies outside the material: In point at %s, Out point at %s, and the material runs %s."
msgstr "Khoảng thời gian nằm ngoài tư liệu: điểm vào ở %s, điểm ra ở %s, và tư liệu dài %s."

msgid "The first preset track sets the settings for all our tracks. Otherwise they come back unprocessed. Create a track in the preset in the web interface."
msgstr "Rãnh đầu tiên của cài đặt sẵn quyết định cài đặt cho mọi rãnh của chương trình. Nếu không, chúng trả về mà không được xử lý. Hãy tạo một rãnh trong cài đặt sẵn trên giao diện web."

msgid "That needs the handover file from a run, and there is none."
msgstr "Việc này cần tệp bàn giao từ một lượt chạy, mà hiện không có."

msgid "The key can only be stored on Mac and Windows -- in the keychain or the registry. It does not go into a file."
msgstr "Khóa chỉ có thể lưu trên Mac và Windows -- trong Chuỗi khóa hoặc Registry. Nó không được lưu vào tệp."

msgid "%s -- being checked"
msgstr "%s -- đang kiểm tra"

msgid "The key was not saved: %s"
msgstr "Chưa lưu được khóa: %s"

msgid "The keychain is locked. Unlock it and try again."
msgstr "Chuỗi khóa đang bị khóa. Hãy mở khóa rồi thử lại."

msgid "This run is a test run and the store still carries its real name, so nothing was written. Point KEY_SERVICE, KEY_ACCOUNT or REG_PATH somewhere else first."
msgstr "Lần chạy này là lần chạy kiểm thử và kho lưu trữ vẫn mang tên thật, nên không ghi gì cả. Hãy trỏ KEY_SERVICE, KEY_ACCOUNT hoặc REG_PATH sang chỗ khác trước."

msgid "The keychain is locked. Unlock it and this button wakes up."
msgstr "Chuỗi khóa đang bị khóa. Hãy mở khóa, nút này sẽ hoạt động trở lại."

msgid "The keychain did not take the key. Keychain Access can say why."
msgstr "Chuỗi khóa không nhận khóa. Truy cập Chuỗi khóa có thể cho biết lý do."

msgid "The registry did not take the key."
msgstr "Registry không nhận khóa."

msgid "Open Keychain Access"
msgstr "Mở Truy cập Chuỗi khóa"

msgid "Opens the app that unlocks the keychain."
msgstr "Mở ứng dụng mở khóa Chuỗi khóa."

msgid "  Keychain Access could not be opened: %s"
msgstr "  Không thể mở Truy cập Chuỗi khóa: %s"

msgid "The stored key is not accepted: %s"
msgstr "Khóa đã lưu không được chấp nhận: %s"

msgid "The key from AUPHONIC_TOKEN is not accepted: %s"
msgstr "Khóa từ AUPHONIC_TOKEN không được chấp nhận: %s"

msgid "What auphonic.com replied"
msgstr "auphonic.com đã trả lời gì"

msgid "There is no key."
msgstr "Không có khóa."

msgid "The key has a space or a line break at one end."
msgstr "Khóa có dấu cách hoặc dấu xuống dòng ở một đầu."

msgid "The key is broken in the middle by a space or a line break."
msgstr "Khóa bị ngắt ở giữa bởi dấu cách hoặc dấu xuống dòng."

msgid "The key has a character in it that cannot be typed."
msgstr "Khóa chứa một ký tự không gõ được."

msgid "The key is then in the %s, never in a file."
msgstr "Khi đó khóa nằm trong %s, không bao giờ trong tệp."

msgid "The production has no name yet."
msgstr "Bản sản xuất chưa có tên."

msgid "The recording assigned to this camera instead of the camera audio."
msgstr "Bản ghi được gán cho máy quay này thay cho âm thanh máy quay."

msgid "The run is still going."
msgstr "Lượt chạy vẫn đang diễn ra."

msgid "No speakers are known yet -- they are worked out of the tracks as soon as this tab is opened. Where everybody is on one recording, \"several speakers\" in the Speaker name field is the way."
msgstr "Chưa biết người nói nào -- họ sẽ được xác định từ các rãnh ngay khi mở thẻ này. Khi mọi người cùng ở trong một bản ghi, cách làm là chọn \"nhiều người nói\" trong ô Tên người nói."

msgid "The three numbers are primaries, curve and matrix. Different tags need different input colour spaces in Resolve -- otherwise one camera looks unlike the other."
msgstr "Ba con số là màu cơ bản, đường cong và ma trận. Nhãn khác nhau cần không gian màu đầu vào khác nhau trong Resolve -- nếu không, máy quay này sẽ trông khác máy quay kia."

msgid "There are no separate audio recordings. Then the audio of the %s cameras is used -- each becomes a track, and Auphonic removes the bleed."
msgstr "Không có bản ghi âm riêng. Khi đó âm thanh của %s máy quay được dùng -- mỗi máy thành một rãnh, và Auphonic loại bỏ rò tiếng."

msgid "There is no result yet."
msgstr "Chưa có kết quả."

msgid "These files are neither audio nor video and stay out:\n\n  %s"
msgstr "Các tệp này không phải âm thanh cũng không phải video nên bị loại ra:\n\n  %s"

msgid "These files do not exist:\n  "
msgstr "Các tệp này không tồn tại:\n  "

msgid "These files exist already and will be written again:\n\n  %s\n\nIs that intended?"
msgstr "Các tệp này đã tồn tại và sẽ được ghi lại:\n\n  %s\n\nĐó có phải điều bạn muốn không?"

msgid "These files no longer exist:\n  "
msgstr "Các tệp này không còn tồn tại:\n  "

msgid "These names occur more than once:\n\n  %s\n\nThe recordings are merged into one track and laid end to end by their timecode. That is right if recording was stopped in between."
msgstr "Những tên này xuất hiện nhiều lần:\n\n  %s\n\nCác bản ghi được gộp thành một rãnh và nối tiếp nhau theo mã thời gian. Điều này đúng nếu việc ghi đã bị dừng giữa chừng."

msgid "These tracks got no file: %s"
msgstr "Các rãnh này không nhận được tệp: %s"

msgid "This Resolve project already exists"
msgstr "Dự án Resolve này đã tồn tại"

msgid "This comes from the recording, not afterwards: the microphones sit too close together or too far from the mouth."
msgstr "Điều này đến từ lúc ghi âm, không phải sau đó: các micrô đặt quá gần nhau hoặc quá xa miệng."

msgid "This file cannot be played here, and ffplay is missing as a fallback."
msgstr "Không thể phát tệp này ở đây, và cũng không có ffplay để thay thế."

msgid "This is not a project file, and there is none in the same folder.\n\nThe search is for %s*.json -- the script writes it into the output folder at start."
msgstr "Đây không phải tệp dự án, và trong cùng thư mục cũng không có tệp nào.\n\nTệp được tìm là %s*.json -- script ghi tệp này vào thư mục đầu ra khi bắt đầu."

msgid "This is what happens next"
msgstr "Đây là những gì sẽ diễn ra tiếp theo"

msgid "This name is on somebody else already. A name is a person, and the cut puts a person on one camera -- please give this voice its own."
msgstr "Tên này đã thuộc về người khác. Một tên là một người, và bản dựng đặt một người vào một máy quay -- hãy đặt cho giọng nói này một tên riêng."

msgid "This name occurs more than once. The recordings would become one track -- for Multitrack auphonic.com needs at least two different ones."
msgstr "Tên này xuất hiện nhiều lần. Các bản ghi sẽ thành một rãnh -- với Multitrack, auphonic.com cần ít nhất hai rãnh khác nhau."

msgid "This production already exists"
msgstr "Bản sản xuất này đã tồn tại"

msgid "This production has no result yet."
msgstr "Bản sản xuất này chưa có kết quả."

msgid "Time limit of %s reached, production still running: %s/engine/status/%s"
msgstr "Đã hết giới hạn thời gian %s, bản sản xuất vẫn đang chạy: %s/engine/status/%s"

msgid "Timecode %s, the other files are at %s -- this clock was not set."
msgstr "Mã thời gian %s, các tệp khác ở %s -- đồng hồ này chưa được đặt."

msgid "Timeline %r could not be created."
msgstr "Không tạo được Timeline %r."

msgid "Title at auphonic.com and start of the new file names."
msgstr "Tiêu đề tại auphonic.com và phần đầu của tên tệp mới."

msgid "To the In point."
msgstr "Đến điểm vào."

msgid "To the start."
msgstr "Về đầu."

msgid "Too many projects with this name."
msgstr "Có quá nhiều dự án mang tên này."

msgid "Track"
msgstr "Rãnh"

msgid "Tracks were added while changing (now %s). That makes the mix\n  wrong. Please delete the tracks without a file at auphonic.com."
msgstr "Trong khi thay đổi đã có thêm rãnh (hiện là %s). Điều đó làm bản trộn\n  sai. Hãy xóa các rãnh không có tệp trên auphonic.com."

msgid "Two cameras would produce the same file. The second would overwrite the first."
msgstr "Hai máy quay sẽ tạo ra cùng một tệp. Tệp thứ hai sẽ ghi đè tệp thứ nhất."

msgid "Two cameras would produce the same file: %s"
msgstr "Hai máy quay sẽ tạo ra cùng một tệp: %s"

msgid "Two cameras would produce the same new file. Please give different names."
msgstr "Hai máy quay sẽ tạo ra cùng một tệp mới. Vui lòng đặt tên khác nhau."

msgid "Uneven frame timing cannot be evened out through the audio. If the sample points spread during alignment as well, convert to a fixed frame rate."
msgstr "Nhịp khung hình không đều không thể cân bằng qua âm thanh. Nếu các điểm mẫu cũng phân tán khi căn chỉnh, hãy chuyển sang tốc độ khung hình cố định."

msgid "Video"
msgstr "Hình ảnh"

msgid "Video 1"
msgstr "Hình ảnh 1"

msgid "Video 2"
msgstr "Hình ảnh 2"

msgid "Video Podcast Magic %s -- raw material becomes an edited podcast"
msgstr "Video Podcast Magic %s -- từ tư liệu thô thành podcast đã dựng"

msgid "Volume. 100 is as loud as it goes -- Qt takes nothing above that."
msgstr "Âm lượng. 100 là to nhất -- Qt không nhận giá trị cao hơn."

msgid "%s (%s) -- talking at once counts twice"
msgstr "%s (%s) -- nói cùng lúc được tính hai lần"

msgid "Wide shot for greeting at the start and farewell at the end"
msgstr "Cảnh rộng cho lời chào đầu và lời tạm biệt cuối"

msgid "Without it every player has to guess, and all guess SDR. In Resolve under Deliver > Advanced Settings set the Color space tag and the Gamma tag instead of leaving them at \"Same as Project\"."
msgstr "Thiếu nó, mọi trình phát đều phải đoán, và tất cả đều đoán là SDR. Trong Resolve, tại Deliver > Advanced Settings, hãy đặt Color space tag và Gamma tag thay vì để ở \"Same as Project\"."

msgid "Without processing at auphonic.com"
msgstr "Không xử lý tại auphonic.com"

msgid "There is no camera cut yet: it needs two people, each with a name and a camera.\nSeparate recordings give that with the Multitrack tick, and so does \"several speakers\" in the Speaker name field of one recording --\nthe voices found there get their camera in the table under the recordings.\nA Resolve project is created anyway -- all cameras at their measured places, ready for Multicam."
msgstr "Chưa có dựng chuyển máy quay: cần hai người, mỗi người có một tên và một máy quay.\nCác bản ghi riêng làm được điều đó với dấu tích Multitrack, và \"nhiều người nói\" trong trường Tên người nói của một bản ghi cũng vậy --\ncác giọng nói tìm thấy ở đó được gán máy quay trong bảng bên dưới các bản ghi.\nDù vậy vẫn tạo một dự án Resolve -- mọi máy quay ở vị trí đã đo, sẵn sàng cho Multicam."

msgid "Without timecode the position of the files is measured."
msgstr "Khi không có mã thời gian, vị trí của các tệp sẽ được đo."

msgid "Works out who speaks when from the tracks themselves -- one microphone per person, level against its own noise floor. Where everybody is on one recording, \"several speakers\" in the Speaker name field is the way."
msgstr "Xác định ai nói khi nào từ chính các rãnh -- mỗi người một micro, mức âm so với nền nhiễu của chính nó. Khi mọi người cùng ở trong một bản ghi, cách làm là chọn \"nhiều người nói\" trong ô Tên người nói."

msgid "a box no longer fits into its parent"
msgstr "một box không còn vừa trong box cha"

msgid "after the device change"
msgstr "sau khi đổi thiết bị"

msgid "auphonic.com does not accept the key: %s"
msgstr "auphonic.com không chấp nhận khóa: %s"

msgid "average"
msgstr "trung bình"

msgid "belongs to"
msgstr "thuộc về"

msgid "bleed too indistinct: %s of %s seconds usable, sharpest %s of %s needed"
msgstr "rò tiếng quá mờ: dùng được %s trên %s giây, độ rõ cao nhất %s, cần %s"

msgid "Midnight"
msgstr "Nửa đêm"

msgid "%s carries a timecode from the other side of midnight -- counted as one night, not as a day apart."
msgstr "%s mang mã thời gian từ phía bên kia nửa đêm -- được tính là cùng một đêm, không phải cách nhau một ngày."

msgid "A timecode counts from midnight and starts over there. The files are put on one axis before anything is subtracted, otherwise the recording after midnight looks almost a day away from the one before. If these really were recorded on different days, the alignment is wrong and the measured offset is the one to trust."
msgstr "Mã thời gian đếm từ nửa đêm và bắt đầu lại ở đó. Các tệp được đặt lên một trục trước khi trừ bất cứ gì, nếu không bản ghi sau nửa đêm trông như cách bản trước gần một ngày. Nếu chúng thật sự được ghi vào những ngày khác nhau, việc căn chỉnh là sai và độ lệch đo được mới đáng tin."

msgid "Channel %d is against the stop: %s times three samples or more in a row, the longest %s (%s ms), the first at %s."
msgstr "Kênh %d chạm ngưỡng: %s lần có ba mẫu trở lên liên tiếp, lần dài nhất %s (%s ms), lần đầu ở %s."

msgid "Counted here, sample by sample, at the rate the file was recorded at: a run of three or more samples on the highest value an integer format can hold. One or two are rounding and are not reported. What is cut off there is gone and no processing brings it back -- but the recording is still the recording, and this holds nothing up. Only integer formats are counted. 32 bit float has no stop at full scale, so there is nothing there to count."
msgstr "Được đếm tại đây, từng mẫu một, ở tần số mà tệp được ghi: một chuỗi ba mẫu trở lên ở giá trị cao nhất mà định dạng số nguyên có thể chứa. Một hoặc hai mẫu là do làm tròn và không được báo. Phần bị cắt ở đó đã mất, không xử lý nào lấy lại được -- nhưng bản ghi vẫn là bản ghi, và điều này không chặn gì cả. Chỉ đếm với định dạng số nguyên. 32 bit float không có ngưỡng ở toàn thang, nên ở đó không có gì để đếm."

msgid "boxes no longer readable"
msgstr "không còn đọc được các box"

msgid "bring up to date -- both Timelines are deleted and\n       rebuilt, the media pool stays as it is"
msgstr "cập nhật -- cả hai Timeline bị xóa và\n       dựng lại, Media Pool giữ nguyên"

msgid "cannot be read back (%s)"
msgstr "không đọc lại được (%s)"

msgid "checking ..."
msgstr "đang kiểm tra ..."

msgid "complete"
msgstr "đầy đủ"

msgid "create a new project alongside (name with suffix)"
msgstr "tạo một dự án mới bên cạnh (tên có hậu tố)"

msgid "curl ended with %d"
msgstr "curl kết thúc với mã %d"

msgid "did not arrive: %s"
msgstr "không đến nơi: %s"

msgid "does not belong: %s"
msgstr "không thuộc về: %s"

msgid "does not exist: %s"
msgstr "không tồn tại: %s"

msgid "does the material fit together?"
msgstr "tư liệu có khớp với nhau không?"

msgid "does the preset fit the run?"
msgstr "cài đặt sẵn có hợp với lượt chạy không?"

msgid "downloaded file is only %s bytes"
msgstr "tệp đã tải xuống chỉ có %s byte"

msgid "gap of %s per timecode, too far apart for one recording"
msgstr "khoảng cách %s theo mã thời gian, quá xa cho một bản ghi"

msgid "gets audio from"
msgstr "lấy âm thanh từ"

msgid "hear assigned audio"
msgstr "nghe âm thanh đã gán"

msgid "keep our names and upload everything again -- this costs\n       credit"
msgstr "giữ tên của chúng ta và tải lên lại tất cả -- việc này tốn\n       tín dụng"

msgid "leave it and put the new Timelines alongside --\n       the existing ones stay"
msgstr "giữ nguyên và đặt các Timeline mới bên cạnh --\n       các Timeline hiện có vẫn giữ lại"

msgid "missing -- the container carries no colour tagging"
msgstr "thiếu -- container không có gắn thẻ màu"

msgid "missing: %s"
msgstr "thiếu: %s"

msgid "moov has not grown"
msgstr "moov không lớn thêm"

msgid "moov is no longer in its place"
msgstr "moov không còn ở vị trí của nó"

msgid "moov no longer ends at the end of the file"
msgstr "moov không còn kết thúc ở cuối tệp"

