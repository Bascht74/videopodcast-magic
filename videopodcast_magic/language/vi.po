msgid "\n  To convert: in the media pool right-click \"%s Multicam\" >\n  \"Convert Timeline to Multicam Clip\" > \"Use Source Audio Channels\".\n  One way only -- but a new run rebuilds the Timeline at any time.\n  Angles:%s\n  Everything else -- audio choice, colour groups, framing -- is in the\n  manual, docs/resolve.md.\n"
msgstr "\n  Để chuyển đổi: trong Media Pool nhấp chuột phải vào \"%s Multicam\" >\n  \"Convert Timeline to Multicam Clip\" > \"Use Source Audio Channels\".\n  Chỉ một chiều -- nhưng một lượt chạy mới dựng lại Timeline bất cứ lúc nào.\n  Góc máy:%s\n  Mọi thứ khác -- chọn âm thanh, nhóm màu, bố cục khung hình -- đều có trong\n  sách hướng dẫn, docs/resolve.md.\n"

msgid "Possible reasons:\n  1. Resolve is not running -- the interface answers only while the program runs.\n  2. Preferences > System > General: external scripting is set to \"None\" instead of \"Local\".\n  3. Free edition: external scripting is reported to be reserved for the Studio edition since version 19.1. I found no official statement -- this check measures it instead of claiming it."
msgstr "Nguyên nhân có thể:\n  1. Resolve không chạy -- giao diện chỉ trả lời khi chương trình đang chạy.\n  2. Preferences > System > General: external scripting được đặt là \"None\" thay vì \"Local\".\n  3. Bản miễn phí: theo một số báo cáo, từ phiên bản 19.1 external scripting chỉ dành cho bản Studio. Tôi không tìm thấy tuyên bố chính thức nào -- phép kiểm tra này đo điều đó thay vì khẳng định."

msgid "  %s cannot be classified: %s -- placed by its clock alone"
msgstr "  Không phân loại được %s: %s -- chỉ được đặt theo đồng hồ của nó"

msgid "  %s: its sound matches by %s, under the floor of %s -- placed by its clock alone"
msgstr "  %s: âm thanh khớp ở mức %s, dưới ngưỡng %s -- chỉ được đặt theo đồng hồ của nó"

msgid "  Offset:          %s   (from its timecode alone -- its sound could not place it, so nothing is checked)"
msgstr "  Độ lệch:           %s   (chỉ từ mã thời gian của nó -- âm thanh không xác định được vị trí, nên không có gì được kiểm tra)"

msgid "  Resolve refused audio track A%d twice on the Timeline \"%s\" -- the cameras are laid on the %s audio tracks there are."
msgstr "  Resolve đã từ chối rãnh âm thanh A%d hai lần trên Timeline \"%s\" -- các máy quay được đặt trên %s rãnh âm thanh hiện có."

msgid "  Resolve refused video track V%d twice -- the Timeline \"%s\" lacks %s."
msgstr "  Resolve đã từ chối rãnh video V%d hai lần -- Timeline \"%s\" thiếu %s."

msgid "  Status:      %s"
msgstr "  Trạng thái: %s"

msgid "  The sound of %s matched too weakly to trust -- placed by the timecode alone."
msgstr "  Âm thanh của %s khớp quá yếu để tin cậy -- chỉ đặt theo mã thời gian."

msgid "%s\n   does not fit the other files: sound not recognised,\n   nothing to set its timecode against.\n   %s"
msgstr "%s\n   không khớp với các tệp khác: không nhận ra âm thanh,\n   không có gì để đối chiếu mã thời gian của nó.\n   %s"

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and no camera the sound placed carries a timecode to set its own against. One of those needs a timecode that fits this one, and that has to be set with another program."
msgstr "Không đặt được %s: âm thanh của nó không có gì chung với phần còn lại của tư liệu, và không máy quay nào được âm thanh đặt vị trí có mã thời gian để đối chiếu. Một trong các máy quay đó cần một mã thời gian khớp với tệp này, và mã đó phải được đặt bằng chương trình khác."

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against, so it cannot be cut into the episode: set to Intro."
msgstr "%s không khớp với phần nào trong tư liệu, và không máy quay nào được âm thanh đặt vị trí có mã thời gian để đối chiếu, nên không thể dựng vào tập: đặt làm phần mở đầu."

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against; the intro is taken: left out."
msgstr "%s không khớp với phần nào trong tư liệu, và không máy quay nào được âm thanh đặt vị trí có mã thời gian để đối chiếu; phần mở đầu đã có: bỏ ra ngoài."

