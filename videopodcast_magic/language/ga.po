msgstr "  Seatanna ar an Timeline: níl ach %s as %s."

msgid "  Peaks:             %s dB above %s dBTP -- the limiter catches them"
msgstr "  Buaicí:            %s dB os cionn %s dBTP -- beireann an teorannóir orthu"

