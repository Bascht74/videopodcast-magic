msgstr "  Ní féidir na méadrachtaí a scríobh: %s"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  Mixdown ó auphonic.com: %s LUFS, buaic %s dBTP (%s)"

