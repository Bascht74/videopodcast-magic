msgstr "Mõõtmine: %s"

msgid "  %-20s not measurable -- left as it is"
msgstr "  %-20s pole mõõdetav -- jäetakse nii, nagu on"

msgid "  %-20s %s LUFS -- nothing on it, left as it is"
msgstr "  %-20s %s LUFS -- sellel pole midagi, jäetakse nii, nagu on"

