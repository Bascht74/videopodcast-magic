msgstr "траје само %s, најдужи снимак има %s."

msgid "overlap of %s per timecode"
msgstr "преклапање од %s по тајмкоду"

msgid "per track"
msgstr "по траци"

msgid "preset does not fit the run"
msgstr "пресет не одговара покретању"

msgid "previous block is shorter than the rest"
msgstr "претходни блок је краћи од осталих"

msgid "processed tracks found -- nothing is uploaded"
msgstr "нађене су обрађене траке -- ништа се не отпрема"

msgid "production finished, but no output file"
msgstr "продукција завршена, али нема излазне датотеке"

msgid "recompute with the chosen preset -- the files stay\n       where they are, costs no credit"
msgstr "поново израчунај са изабраним пресетом -- датотеке остају\n       где јесу, не троши кредит"

msgid "reset"
msgstr "поништи"

msgid "running ..."
msgstr "у току ..."

msgid "selected"
msgstr "изабрано"

msgid "stays out"
msgstr "остаје изван"

msgid "stored file %s"
msgstr "сачувана датотека %s"

msgid "take the existing result (nothing computed, nothing paid)"
msgstr "преузми постојећи резултат (ништа се не рачуна, ништа се не плаћа)"

msgid "take the names from there and carry on with them --\n       no upload, costs nothing"
msgstr "преузми имена одатле и настави са њима --\n       без отпремања, не кошта ништа"

msgid "the Multitrack preset has no track stored."
msgstr "Multitrack пресет нема сачувану траку."

msgid "the finished mixdown"
msgstr "финални микс"

msgid "the individual tracks"
msgstr "појединачне траке"

msgid "the individual tracks, packed"
msgstr "појединачне траке, запаковане"

msgid "the media data is no longer where it was"
msgstr "медијски подаци више нису тамо где су били"

