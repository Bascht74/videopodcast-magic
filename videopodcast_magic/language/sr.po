msgstr "  Направите га помоћу \"Направи Resolve пројекат\" у интерфејсу. Resolve мора да ради."

msgid "  The handover file could not be written."
msgstr "  Датотека предаје није могла бити записана."

msgid "  This produces the project, the import and %s:"
msgstr "  Из тога настају пројекат, увоз и %s:"

msgid " (paused)"
msgstr " (пауза)"

msgid " (playing)"
msgstr " (репродукција)"

msgid " -- an In or Out point saves the upload"
msgstr " -- тачка In или Out штеди отпремање"

msgid " -- not readable"
msgstr " -- нечитљиво"

msgid " -- nothing to fault."
msgstr " -- нема замерки."

msgid " -- only the matrix says BT.2020"
msgstr " -- само матрица каже BT.2020"

msgid " and "
msgstr " и "

msgid " from %s files"
msgstr " (датотека: %s)"

msgid " not."
msgstr " изостаје."

msgid "%s blocks"
msgstr "блокова: %s"

msgid "%s brought to the preset"
msgstr "%s пребачено на пресет"

msgid "%s channels -- cut into tracks, see the rows above."
msgstr "%s канала -- подељено у траке, погледајте редове изнад."

msgid "%s checked"
msgstr "%s проверено"

msgid "%s of %s comparisons are below %s dB -- every recording against every other, in both directions."
msgstr "%s од %s поређења је испод %s dB -- сваки снимак наспрам сваког другог, у оба смера."

msgid "%s of %s video files carry no curve and no colour space in the colr box%s -- probably log material."
msgstr "видео датотека без криве и простора боја у colr блоку: %s од %s%s -- вероватно Log материјал."

msgid "%r is a Timecode, but there is no picture here and so no camera to count it from. Then only a value from the window start works, such as +12:30."
msgstr "%r је тајмкод, али овде нема слике па ни камере од које би се бројао. Тада ради само вредност од почетка прозора, као што је +12:30."

msgid "%r is a Timecode, but the time axis hangs on no clock: no file here carries one, the reference camera %s included. Then only a value from the window start works, such as +12:30."
msgstr "%r је тајмкод, али временска оса не виси ни о једном сату: ниједна датотека овде га нема, укључујући референтну камеру %s. Тада ради само вредност од почетка прозора, као што је +12:30."

msgid "%r is not a Multitrack preset"
msgstr "%r није Multitrack пресет"

msgid "%r is not a number."
msgstr "%r није број."

msgid "%s\n   does not fit the other files: sound not recognised, no timecode.\n   %s"
msgstr "%s\n   не уклапа се уз остале датотеке: звук није препознат, нема тајмкода.\n   %s"

msgid "Set to %s; %s is one click away."
msgstr "Постављено као %s; %s је на један клик."

msgid "Left out, %s being taken already; %s is one click away."
msgstr "Изостављено, %s је већ заузето; %s је на један клик."

msgid "Its sound cannot be used."
msgstr "Његов звук не може да се користи."

msgid "%s\n   sound not recognised; placed by its timecode"
msgstr "%s\n   звук није препознат; постављен по свом тајмкоду"

msgid "%s   --   the app does not know this format"
msgstr "%s   --   апликација не познаје овај формат"

msgid "%s  (%s)  --  %s  --  %s blocks"
msgstr "%s  (%s)  --  %s  --  блокова: %s"

msgid "%s -- what should happen with it?\nThe details are in the log."
msgstr "%s -- шта да се уради са тим?\nПојединости су у дневнику."

msgid "%s kHz instead of %s kHz -- converted during processing."
msgstr "%s kHz уместо %s kHz -- претвара се током обраде."

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and the file carries no timecode. It needs one that fits the other recordings, and that has to be set with another program."
msgstr "%s се не може сместити: његов звук нема ништа заједничко са остатком материјала, а датотека не носи тајмкод. Потребан јој је онај који се уклапа са осталим снимцима, а то се мора подесити другим програмом."

msgid "%s fits nothing in the material and is far shorter than the rest: proposed as the intro, which is put at the front and never measured."
msgstr "%s се не поклапа ни са чим у материјалу и много је краће од осталог: предложено као интро, који се ставља на почетак и никада се не мери."

msgid "%s is set, and nothing is adjusted here: the tracks leave as they were recorded, and the loudness is set where they are mixed."
msgstr "%s је подешено, а овде се ништа не подешава: траке одлазе онакве какве су снимљене, а гласноћа се поставља тамо где се миксују."

msgid "%s can be placed again and is back in the run."
msgstr "%s поново може да се смести и враћено је у покретање."

msgid "%s could not be installed.\nBy hand:  %s -m pip install %s"
msgstr "%s није могао да се инсталира.\nРучно:  %s -m pip install %s"

msgid "%s has no audio track."
msgstr "%s нема аудио траку."

msgid "%s in %s"
msgstr "%s у %s"

msgid "%s in %s's microphone: %s dB quieter than in their own."
msgstr "%s у микрофону говорника %s: %s dB тише него у сопственом."

msgid "%s is in %s -- the file is now in the player."
msgstr "%s се налази у %s -- датотека је сада у плејеру."

msgid "%s is not on the axis of the episode: it is set in front of the material or after it, not cut into it. In point and Out point belong to what lies between."
msgstr "%s није на оси епизоде: ставља се испред материјала или иза њега, не монтира се у њега. Тачка In и тачка Out припадају ономе што лежи између."

msgid "%s is in none of the video files. Is there a timecode that fits the material?"
msgstr "%s није ни у једној видео датотеци. Постоји ли тајмкод који одговара материјалу?"

msgid "%s%s in %s's microphone only %s dB quieter"
msgstr "%s%s у микрофону говорника %s само %s dB тише"

msgid "%s: not seekable yet, will follow (%s)"
msgstr "%s: премотавање још није могуће, биће накнадно (%s)"

msgid "%s: not there"
msgstr "%s: не постоји тамо"

msgid "%s: setPosition(%s), attempt %d, then at %s"
msgstr "%s: setPosition(%s), покушај %d, затим на %s"

msgid "%s: should go to %s%s -- %s"
msgstr "%s: треба да оде на %s%s -- %s"

msgid ", no audio"
msgstr ", без аудија"

msgid "-- only one camera"
msgstr "-- само једна камера"

msgid "--- jump to %s programme time%s ---"
msgstr "--- скок на %s програмског времена%s ---"

msgid "--- point set, programme time runs from %s ---"
msgstr "--- тачка постављена, програмско време тече од %s ---"

msgid "... or add files ..."
msgstr "... или додај датотеке ..."

msgid "/not seekable"
msgstr "/премотавање није могуће"

msgid "<span style='color:%(t)s'><b>%(n)s shots</b>, median %(med)s s, shortest %(short)s s, longest camera %(long)s s</span>. Speech time: <b>%(own)s %%</b> on their own camera (%(own_t)s), %(wide)s %% on the wide shot (%(wide_t)s), <span style='color:%(warn)s'>at %(off)s %% (%(off_t)s) the speaker's camera is not active</span>"
msgstr "<span style='color:%(t)s'><b>кадрова: %(n)s</b>, медијана %(med)s с, најкраћи %(short)s с, најдужа камера %(long)s с</span>. Време говора: <b>%(own)s %%</b> на сопственој камери (%(own_t)s), %(wide)s %% на широком кадру (%(wide_t)s), <span style='color:%(warn)s'>на %(off)s %% (%(off_t)s) камера говорника није активна</span>"

msgid "Every pair of channels is judged on its own: one stereo track, or two microphones and therefore two tracks. Silent inputs drop out. The rows under the file say what was measured, and the tick overrules it."
msgstr "Сваки пар канала се процењује засебно: једна стерео трака, или два микрофона и тиме две траке. Тихи улази отпадају. Редови испод датотеке кажу шта је измерено, а квачица то надјачава."

msgid "Add files ..."
msgstr "Додај датотеке ..."

msgid "Alignment goes by the measured offset; the timecode is only the cross-check."
msgstr "Поравнање иде по измереном померају; тајмкод је само унакрсна провера."

msgid "All recordings carry the same name -- that makes a single track."
msgstr "Сви снимци носе исто име -- то даје једну једину траку."

msgid "All rows carry the same name -- that makes a single track, and Multitrack needs at least two."
msgstr "Сви редови носе исто име -- то даје једну једину траку, а Multitrack захтева најмање две."

msgid "Assignment: which audio track belongs to which camera"
msgstr "Додела: која аудио трака припада којој камери"

msgid "Audio"
msgstr "Аудио"

msgid "Audio and video (%s);;All files (*)"
msgstr "Аудио и видео (%s);;Све датотеке (*)"

msgid "Audio at programme time"
msgstr "Аудио на програмском времену"

msgid "Auphonic created different tracks than requested: %s instead of %s"
msgstr "Auphonic је направио другачије траке од затражених: %s уместо %s"

msgid "Auphonic reports an error: %s"
msgstr "Auphonic пријављује грешку: %s"

msgid "Bleed"
msgstr "Преслушавање"

msgid "Blocks"
msgstr "Блокови"

msgid "Both at once does not work: the returning tracks would go to one value, our own mix to the other. Either set --lufs %.0f or change the preset."
msgstr "Обоје одједном не иде: траке које се враћају отишле би на једну вредност, наш микс на другу. Или поставите --lufs %.0f или промените пресет."

msgid "Camera"
msgstr "Камера"

msgid "Camera audio, %s to go ..."
msgstr "Аудио камере, још %s ..."

msgid "%s -- preview  (length %s)"
msgstr "%s -- преглед  (трајање %s)"

msgid "Why the run cannot start"
msgstr "Зашто покретање не може да почне"

msgid "Cannot start yet: %s"
msgstr "Још се не може покренути: %s"

msgid "Change rejected: %s"
msgstr "Измена одбијена: %s"

msgid "Check again"
msgstr "Провери поново"

msgid "Check the connection to Resolve again"
msgstr "Провери поново везу са Resolve-ом"

msgid "Check itself failed: %s"
msgstr "Сама провера није успела: %s"

msgid "Check the key and fetch Presets."
msgstr "Проверите кључ и преузмите пресете."

msgid "Chosen"
msgstr "Изабрано"

msgid "Clock %7.2f%s | B1[%s] %s | B2[%s] %s | Audio %s %s"
msgstr "Сат %7.2f%s | B1[%s] %s | B2[%s] %s | Аудио %s %s"

msgid "Close"
msgstr "Затвори"

msgid "Connects to Resolve again."
msgstr "Поново се повезује са Resolve-ом."

msgid "Content: a camera like any other.\nWide shot: a camera nobody sits in front of -- it takes no speaker, and the cut goes to it in a pause and in a long monologue.\nIntro and outro are finished clips -- not aligned, not processed, only placed in the Timeline.\nIgnore video: the file stays out entirely."
msgstr "Садржај: камера као свака друга.\nШироки кадар: камера испред које нико не седи -- не добија говорника, а монтажа прелази на њу у паузи и у дугом монологу.\nИнтро и аутро су готови клипови -- нису поравнати, нису обрађени, само постављени у Timeline-у.\nЗанемари видео: датотека остаје потпуно изван."

msgid "  %s wide shots: the cut uses %s."
msgstr "  Широких кадрова: %s; монтажа користи %s."

msgid "  Every camera carries a speaker, so there is no wide shot: the four wide shot settings and the tick for the edges do nothing here."
msgstr "  Свака камера носи говорника, па нема широког кадра: четири подешавања широког кадра и квачица за ивице овде не раде ништа."

msgid "No camera is free of speakers, so there is no wide shot: the four wide shot settings and the tick for the edges do nothing. Give a camera the Kind \"Wide shot\", or leave one without a speaker."
msgstr "Ниједна камера није без говорника, па нема широког кадра: четири подешавања широког кадра и квачица за ивице не раде ништа. Дајте некој камери Тип \"Широки кадар\", или оставите једну без говорника."

msgid "placed by phase, sharpness %s against a floor of %s, drift unknown"
msgstr "смештено по фази, оштрина %s наспрам прага %s, одступање непознато"

msgid "placed on the bands that move"
msgstr "смештено по опсезима који се крећу"

msgid "Why the wide shot settings are grey"
msgstr "Зашто су подешавања широког кадра сива"

msgid "because no speaker is assigned to it"
msgstr "јер јој није додељен ниједан говорник"

msgid "marked as the wide shot -- it takes no speakers"
msgstr "означена као широки кадар -- не прима говорнике"

msgid "no speaker -- this is the wide shot"
msgstr "нема говорника -- ово је широки кадар"

msgid "no speaker is assigned to it, but the cut uses %s"
msgstr "ниједан говорник јој није додељен, али монтажа користи %s"

msgid "the cut uses %s"
msgstr "монтажа користи %s"

msgid "this is the wide shot -- %s moved to \"no camera of its own\""
msgstr "ово је широки кадар -- пребачено на \"без сопствене камере\": %s"

msgid "Curve and colour space are missing from the file"
msgstr "Крива и простор боја недостају у датотеци"

msgid "In point and Out point are available once the time axis is set -- from the timecode or measured."
msgstr "Тачка In и тачка Out доступне су чим је временска оса постављена -- из тајмкода или измерена."

msgid "In point is %s before the first frame"
msgstr "Тачка In је %s пре првог кадра"

msgid "In point is now %s, but the existing files belong to %s.\n  The audio in the videos is cut to the old window -- press Start\n  above again."
msgstr "Тачка In је сада %s, али постојеће датотеке припадају %s.\n  Аудио у видео снимцима је исечен на стари прозор -- притисните поново\n  Покрени горе."

msgid "Out point is %s after the last frame"
msgstr "Тачка Out је %s после последњег кадра"

msgid "Out point is now %s; the window would be %s long, the existing\n  files are %s -- press Start above again."
msgstr "Тачка Out је сада %s; прозор би трајао %s, постојеће\n  датотеке трају %s -- притисните поново Покрени горе."

msgid "Delivery usually takes the limited range. Full is not wrong, but some players misread it."
msgstr "За испоруку се обично узима ограничени опсег. Пуни није погрешан, али га неки плејери погрешно тумаче."

msgid "Determines how auphonic.com processes the audio.\n\n\"%s\" leaves the key in place and still does not go there.\nThe audio is then only merged and normalised, not unmixed --\nand without separate tracks there is no camera cut."
msgstr "Одређује како auphonic.com обрађује аудио.\n\n„%s“ оставља кључ на месту, а ипак не иде тамо.\nАудио се тада само спаја и нормализује, не раздваја --\nа без раздвојених трака нема монтаже камера."

msgid "Distance to mean"
msgstr "Одступање од просека"

msgid "Drag audio and video files here"
msgstr "Превуците овде аудио и видео датотеке"

msgid "Dry run: only measuring, nothing written, nothing uploaded."
msgstr "Пробно покретање: само се мери, ништа се не записује, ништа се не отпрема."

msgid "During greeting and farewell the picture stays wide."
msgstr "Током поздрава и опроштаја слика остаје у широком кадру."

msgid "The frames stand a little longer; the file is not any shorter for it. Editing software repeats about one frame every %s s, and picture and camera audio stay together."
msgstr "Кадрови стоје мало дуже; датотека због тога није краћа. Програм за монтажу понавља отприлике један кадар сваких %s с, а слика и аудио камере остају заједно."

msgid "The frames stand a little shorter; the file is not any longer for it. Editing software leaves out about one frame every %s s, and picture and camera audio stay together."
msgstr "Кадрови стоје мало краће; датотека због тога није дужа. Програм за монтажу изоставља отприлике један кадар сваких %s с, а слика и аудио камере остају заједно."

msgid "Eight bits are not enough for HDR: every gradient bands, and YouTube requires ten or twelve."
msgstr "Осам бита није довољно за HDR: сваки прелив добија пруге, а YouTube захтева десет или дванаест."

msgid "Envelope"
msgstr "Обвојница"

msgid "  %s is placed on %s, which is no camera of this run -- the cut names it all the same."
msgstr "  %s стоји на %s, што није камера овог покретања -- монтажа је ипак именује."

msgid "Envelope failed: %s"
msgstr "Обвојница није успела: %s"

msgid "Envelopes and camera audio are prepared in the background."
msgstr "Обвојнице и аудио камере припремају се у позадини."

msgid "Every row needs a name -- at Auphonic it becomes the track ID."
msgstr "Сваки ред треба име -- код Auphonic-а оно постаје track ID."

msgid "External preview -- the app does not know this format"
msgstr "Спољни преглед -- апликација не познаје овај формат"

msgid "Fetching audio"
msgstr "Преузимање аудија"

msgid "Fetching audio ..."
msgstr "Преузимање аудија ..."

msgid "File"
msgstr "Датотека"

msgid "Files are missing there -- without a new upload nothing can be computed.\n  With --auphonic-resume upload the script uploads again; this costs credit."
msgstr "Тамо недостају датотеке -- без новог отпремања ништа се не може израчунати.\n  Помоћу --auphonic-resume upload скрипта поново отпрема; ово троши кредит."

msgid "For HDR the usual choice is HEVC (Main 10), AV1 or VP9 Profile 2. YouTube takes H.264 too, but it needs more bitrate."
msgstr "За HDR уобичајен избор је HEVC (Main 10), AV1 или VP9 Profile 2. YouTube прима и H.264, али му треба више битрејта."

msgid "For ten bits HEVC needs the Main 10 profile. In Resolve it sits under Deliver as \"Profile\"."
msgstr "За десет бита HEVC треба профил Main 10. У Resolve-у стоји под Deliver као „Profile”."

msgid "%s fps, not the %s in the file -- %s fewer frames in the same length."
msgstr "%s fps, а не %s из датотеке -- кадрова мање у истом трајању: %s."

msgid "%s fps, not the %s in the file -- %s more frames in the same length."
msgstr "%s fps, а не %s из датотеке -- кадрова више у истом трајању: %s."

msgid "Frame spacing varies by %s %% -- the frame timing is uneven."
msgstr "Размак између кадрова варира за %s %% -- временски распоред кадрова је неуједначен."

msgid "Free space there: %s"
msgstr "Слободан простор тамо: %s"

msgid "Gap of %s between block %d and %d -- the camera stopped."
msgstr "Празнина од %s између блока %d и %d -- камера је стала."

msgid "Drag to move the position."
msgstr "Превуците да померите позицију."

msgid "HDR needs 16 here (PQ, that is HDR10) or 18 (HLG). In Resolve: Gamma tag = ST.2084 or HLG. 14 is not an HDR curve but SDR in the BT.2020 space."
msgstr "HDR овде захтева 16 (PQ, то јест HDR10) или 18 (HLG). У Resolve-у: Gamma tag = ST.2084 или HLG. 14 није HDR крива, него SDR у BT.2020 простору."

msgid "HDR needs 9 here (BT.2020). In Resolve: Color space tag = Rec.2020."
msgstr "HDR овде захтева 9 (BT.2020). У Resolve-у: Color space tag = Rec.2020."

msgid "HDR needs 9 here (BT.2020, non-constant luminance)."
msgstr "HDR овде захтева 9 (BT.2020, неконстантна луминанса)."

msgid "HLG is display-referred -- it has no entry for the mastering display."
msgstr "HLG је везан за приказ -- нема унос за мастеринг монитор."

msgid "If empty: next to each video file."
msgstr "Ако је празно: поред сваке видео датотеке."

msgid "It arose during the recording and cannot be changed now. The less the microphones are separated, the more cautiously De-Bleed at auphonic.com can work. Next time: three times as far from the neighbouring microphone as from your own mouth, then the neighbouring voice sits about %s dB lower."
msgstr "Настало је током снимања и сада више не може да се промени. Што су микрофони мање раздвојени, то опрезније De-Bleed на auphonic.com може да ради. Следећи пут: три пута даље од суседног микрофона него од сопствених уста, тада суседни глас лежи око %s dB ниже."

msgid "It fits nowhere in the material: no timecode, and its sound has nothing in common with the rest. The wide shot is what the cut falls back on, so it has to lie on the time axis."
msgstr "Не уклапа се нигде у материјал: нема тајмкода, а њен звук нема ништа заједничко са остатком. Широки кадар је оно на шта се монтажа ослања, па мора да лежи на временској оси."

msgid "It fits nowhere in the material, so it cannot be cut into the episode. It can be set in front of it or after it."
msgstr "Не уклапа се нигде у материјал, па се не може умонтирати у епизоду. Може се поставити испред ње или иза ње."

msgid "%s fits nothing in the material, so it cannot be cut into the episode: set to Intro."
msgstr "%s се не поклапа ни са чим у материјалу, па не може да се умонтира у епизоду: постављено као интро."

msgid "%s fits nothing in the material either, and the intro is taken: left out."
msgstr "%s се такође не поклапа ни са чим у материјалу, а интро је већ заузет: изостављено."

msgid "%s is already set as %s, and an episode has one of those. Answer differently here, or take the mark off that file first."
msgstr "%s је већ постављен као %s, а епизода има само један такав. Одговорите овде другачије или прво уклоните ознаку са те датотеке."

msgid "It is in the logs atom of the picture description -- that is how Resolve recognises the input colour space. Different curves mean different input colour spaces."
msgstr "Стоји у logs атому описа слике -- по томе Resolve препознаје улазни простор боја. Различите криве значе различите улазне просторе боја."

msgid "Jumps to the end of the window."
msgstr "Скаче на крај прозора."

msgid "Jumps to the start of the window."
msgstr "Скаче на почетак прозора."

msgid "Keychain"
msgstr "Keychain"

msgid "Limits the de-bleed: "
msgstr "Ограничава уклањање преслушавања: "

msgid "Load Presets and pick one, or leave the API Key empty."
msgstr "Учитајте пресете и изаберите један, или оставите API Key празан."

msgid "Main10 rejected -- the default stays"
msgstr "Main10 одбијен -- остаје подразумевано"

msgid "Measure only -- nothing is written or uploaded."
msgstr "Само мерење -- ништа се не записује нити отпрема."

msgid "Measuring %s (%s of %s)"
msgstr "Мерење %s (%s од %s)"

msgid "Measuring not possible: %s"
msgstr "Мерење није могуће: %s"

msgid "Measuring the yardstick"
msgstr "Мерење мерила"

msgid "Measuring time axis ..."
msgstr "Мерење временске осе ..."

msgid "Missing audio %s filled with silence%s"
msgstr "Аудио који недостаје %s попуњен тишином%s"

msgid "Module DaVinciResolveScript cannot be loaded: %s"
msgstr "Модул DaVinciResolveScript не може да се учита: %s"

msgid "One audio track per person, kept apart all the way to auphonic.com.\nWorks without it as well -- then without de-bleed and leveler.\nIt needs two input tracks: a recording of its own, a channel of a\nmultichannel recorder, or the audio of a video file set to \"use\nthe audio\". The camera cut does not need this tick."
msgstr "Једна аудио трака по особи, држана одвојено све до auphonic.com.\nРади и без тога -- али онда без de-bleed-а и нивелатора.\nПотребне су две улазне траке: засебан снимак, канал\nвишеканалног снимача, или аудио видео датотеке постављен на „користи\nаудио“. Монтажа камера не захтева ову квачицу."

msgid "Multitrack (one track per speaker)"
msgstr "Multitrack (једна трака по говорнику)"

msgid "Multitrack needs at least two input tracks. A track is a recording of its own, a channel of a multichannel recorder, or the audio of a video file set to \"use internal audio\". Several blocks of the same recording count as one, tracks set aside not at all."
msgstr "Multitrack захтева најмање две улазне траке. Трака је засебан снимак, канал вишеканалног снимача или аудио видео датотеке подешене на \"користи интерни аудио\". Више блокова истог снимка рачуна се као један, траке стављене са стране уопште не."

msgid "No API key. Pass --auphonic-api-key KEY, set AUPHONIC_TOKEN or have it remembered once in the interface. The key is in the Auphonic account settings."
msgstr "Нема API кључа. Наведите --auphonic-api-key КЉУЧ, поставите AUPHONIC_TOKEN или га једном запамтите у интерфејсу. Кључ се налази у подешавањима Auphonic налога."

msgid "No audio file carries a timecode. In point and Out point count from the start of the material -- the position of the files to each other is measured."
msgstr "Ниједна аудио датотека не носи тајмкод. Тачка In и тачка Out броје се од почетка материјала -- међусобни положај датотека се мери."

msgid "No sound in use yet -- add an audio recording, or set a video file's Camera audio to \"use internal audio\" in the file list."
msgstr "Још се не користи никакав звук -- додајте аудио снимак или у листи датотека поставите Аудио камере неке видео датотеке на „користи интерни аудио“."

msgid "No audio tracks are assigned."
msgstr "Ниједна аудио трака није додељена."

msgid "No camera is assigned, so there is nothing to cut between."
msgstr "Ниједна камера није додељена, па нема између чега да се монтира."

msgid "No cameras assigned yet -- switch Multitrack on to do that."
msgstr "Још нису додељене камере -- за то укључите Multitrack."

msgid "No connection to Resolve.\n  Is the program running? Is external scripting set to 'Local'\n  under Preferences > System > General?"
msgstr "Нема везе са Resolve-ом.\n  Да ли програм ради? Да ли је спољно скриптовање постављено на 'Local'\n  под Preferences > System > General?"

msgid "No files or project opened yet."
msgstr "Још нису отворене датотеке ни пројекат."

msgid "No files selected yet."
msgstr "Још нису изабране датотеке."

msgid "No input possible. Use %s %s to set what should happen."
msgstr "Унос није могућ. Користите %s %s да одредите шта треба да се деси."

msgid "No player is built in here -- playback runs in ffplay in its own window."
msgstr "Овде нема уграђеног плејера -- репродукција иде у ffplay-у у засебном прозору."

msgid "No preset given, no input possible. Choose one of the above with --auphonic-preset NAME."
msgstr "Није наведен пресет, унос није могућ. Изаберите један од горњих помоћу --auphonic-preset ИМЕ."

msgid "No presets stored in the account. One can be created in the web interface."
msgstr "У налогу нема сачуваних пресета. Један се може направити у веб интерфејсу."

msgid "No speaker is known here -- without who speaks when there is nothing to cut between."
msgstr "Овде није познат ниједан говорник -- без тога ко када говори нема између чега да се монтира."

msgid "No voice has a camera yet -- with that every shot would be the same one."
msgstr "Ниједан глас још нема камеру -- тако би сваки кадар био исти."

msgid "No speakers known yet -- nothing measured, nothing separated, and no handover file of an earlier run in %s or its subfolders."
msgstr "Још нису познати говорници -- ништа није измерено, ништа раздвојено, и нема датотеке предаје ранијег покретања у %s нити у њеним подфасциклама."

msgid "Not found again after import: %s"
msgstr "Није поново пронађено после увоза: %s"

msgid "from ffmpeg.org, and the folder into PATH"
msgstr "са ffmpeg.org, а фасциклу у PATH"

msgid "over the package manager: apt install ffmpeg, dnf install ffmpeg"
msgstr "преко менаџера пакета: apt install ffmpeg, dnf install ffmpeg"

msgid "Here: %s. Needed: %s or newer."
msgstr "Овде: %s. Потребно: %s или новије."

msgid "no answer"
msgstr "нема одговора"

msgid "Nothing runs until that is put right."
msgstr "Ништа не ради док се то не исправи."

msgid "Nothing runs until that is put right. This way: %s"
msgstr "Ништа не ради док се то не доведе у ред. Овако: %s"

msgid "Get it: %s"
msgstr "Набави: %s"

msgid "Quit"
msgstr "Изађи"

msgid "That worked."
msgstr "То је успело."

msgid "Installing ffmpeg"
msgstr "Инсталирање ffmpeg-а"

msgid "Start the program again to pick it up."
msgstr "Поново покрените програм да би га приметио."

msgid "Getting it takes a few minutes, and what it says appears under Output."
msgstr "Набављање траје неколико минута, а оно што каже појављује се под Излаз."

msgid "This takes a few minutes -- a package manager may build from source. What it says appears here."
msgstr "Ово траје неколико минута -- менаџер пакета можда гради из изворног кода. Оно што каже појављује се овде."

msgid "Now it is being compiled, and that is the long part: minutes on a fast machine and a good deal longer on an older one. Nothing is stuck -- a dot appears every few seconds for as long as it works."
msgstr "Сада се компајлира, а то је дуги део: минути на брзом рачунару и знатно дуже на старијем. Ништа није заглавило -- док год ради, сваких неколико секунди појављује се тачка."

msgid "ffmpeg is in place."
msgstr "ffmpeg је инсталиран."

msgid "The program reads it when it starts. It can start again now, or you can do that yourself later."
msgstr "Програм га чита при покретању. Може да се поново покрене сада, или то можете сами урадити касније."

msgid "Start again now"
msgstr "Поново покрени сада"

msgid "Starting again did not work. Close the window and start the program the way you did before."
msgstr "Поновно покретање није успело. Затворите прозор и покрените програм онако како сте то радили раније."

msgid "  Taking the ffmpeg that is there out of the way first: %s"
msgstr "  Прво се постојећи ffmpeg склања с пута: %s"

msgid "  A built ffmpeg 9.0.1 with soxr can be fetched: %s"
msgstr "  Може се преузети готов ffmpeg 9.0.1 са soxr: %s"

msgid "  Fetch it now? [Y/n] "
msgstr "  Преузети сада? [Y/n] "

msgid "  Fetching a built ffmpeg. It is a big one, so this takes a few minutes: %s"
msgstr "  Преузима се готов ffmpeg. Велик је, па ово траје неколико минута: %s"

msgid "  %s of %s MB"
msgstr "  %s од %s MB"

msgid "The build could not be fetched: %s"
msgstr "Готова верзија није могла да се преузме: %s"

msgid "  The build could not be unpacked: %s"
msgstr "  Готова верзија није могла да се распакује: %s"

msgid "  The archive held %s of the two programs."
msgstr "  Архива је садржала %s од два програма."

msgid "  It is here: %s"
msgstr "  Налази се овде: %s"

msgid "install Homebrew from brew.sh, then this again"
msgstr "инсталирајте Homebrew са brew.sh, затим поново ово"

msgid "This ffmpeg has soxr: the clock drift between cameras comes out in steps of 0.21 ppm."
msgstr "Овај ffmpeg има soxr: одступање сата између камера изравнава се у корацима од 0,21 ppm."

msgid "This ffmpeg has no soxr: the clock drift between cameras comes out in steps of 21 ppm instead of 0.21."
msgstr "Овај ffmpeg нема soxr: одступање сата између камера изравнава се у корацима од 21 ppm уместо 0,21."

msgid "Everything works without it. Getting a build that has it takes a few minutes, and what it says appears under Output."
msgstr "Све ради и без тога. Набављање верзије која то има траје неколико минута, а оно што каже појављује се под Излаз."

msgid "Carry on"
msgstr "Настави"

msgid "Not mandatory -- YouTube then applies default values (Sony BVM-X300). To get them: in Resolve switch on HDR10+ under Color Management, run \"Analyze All Shots\" on the Color page and tick \"Embed HDR10 Metadata\" when rendering."
msgstr "Није обавезно -- YouTube тада примењује подразумеване вредности (Sony BVM-X300). Да бисте их добили: у Resolve-у укључите HDR10+ под Color Management, покрените „Analyze All Shots” на страници Color и штиклирајте „Embed HDR10 Metadata” при рендеровању."

msgid "Not ready yet:"
msgstr "Још није спремно:"

msgid "Nothing was audible in the tracks."
msgstr "У тракама се ништа није чуло."

msgid "One audio recording has no speaker name yet."
msgstr "Један аудио снимак још нема име говорника."

msgid "One frame back."
msgstr "Један кадар уназад."

msgid "One second back."
msgstr "Једна секунда уназад."

msgid "Each shot in the colour of its camera. Hover for camera and duration, click to jump."
msgstr "Сваки кадар у боји своје камере. Пређите мишем за камеру и трајање, кликните да скочите."

msgid "Only one speaker"
msgstr "Само један говорник"

msgid "Open json project file"
msgstr "Отвори json датотеку пројекта"

msgid "Open result folder"
msgstr "Отвори фасциклу са резултатом"

msgid "Open the settings, where the key is."
msgstr "Отворите подешавања, где се налази кључ."

msgid "Order does not matter. For a multi-part recording the first block is enough."
msgstr "Редослед није битан. Код вишеделног снимка довољан је први блок."

msgid "Overwrite"
msgstr "Препиши"

msgid "Overwrite files"
msgstr "Препиши датотеке"

msgid "Pane %d loads %s (%s)"
msgstr "Окно %d учитава %s (%s)"

msgid "Pane %d on %s"
msgstr "Окно %d на %s"

msgid "Play and pause -- the space bar works too."
msgstr "Репродукција и пауза -- ради и размакница."

msgid "Play and pause."
msgstr "Репродукција и пауза."

msgid "Playback not possible"
msgstr "Репродукција није могућа"

msgid "Playing %s -- the processed track from auphonic.com,\nbrought to broadcast level. The same audio as in the camera cut."
msgstr "Репродукција %s -- обрађена трака са auphonic.com,\nдоведена на ниво за емитовање. Исти аудио као у монтажи камера."

msgid "Playing %s -- the raw recording.\nIt is much quieter than the processed audio; once the tracks from auphonic.com\nare there, the preview takes those."
msgstr "Репродукција %s -- сирови снимак.\nМного је тиши од обрађеног аудија; чим траке са auphonic.com\nбуду ту, преглед узима њих."

msgid "Prepare pane %d for %s"
msgstr "Припрема окна %d за %s"

msgid "Preset not readable: %s"
msgstr "Пресет је нечитљив: %s"

msgid "Preview not possible: %s"
msgstr "Преглед није могућ: %s"

msgid "Preview running ..."
msgstr "Преглед у току ..."

msgid "Prework -- read audio and compute envelopes:\n"
msgstr "Припрема -- читање аудија и рачунање обвојница:\n"

msgid "Primaries"
msgstr "Примарне боје"

msgid "Primaries number %d"
msgstr "Примарне боје број %d"

msgid "Processing at auphonic.com (optional)"
msgstr "Обрада на auphonic.com (опционо)"

msgid "Processing at auphonic.com with \"%s\""
msgstr "Обрада на auphonic.com са „%s“"

msgid "Production finished, but no ZIP with the individual tracks"
msgstr "Продукција завршена, али нема ZIP-а са појединачним тракама"

msgid "Production name"
msgstr "Име продукције"

msgid "Chosen files"
msgstr "Изабране датотеке"

msgid "Remove the chosen file from the list"
msgstr "Уклони изабрану датотеку са листе"

msgid "Project %r could not be created."
msgstr "Пројекат %r није могао бити направљен."

msgid "Project %r could not be created. Is the name already in another folder?"
msgstr "Пројекат %r није могао бити направљен. Да ли то име већ постоји у другој фасцикли?"

msgid "Project %r could not be opened."
msgstr "Пројекат %r није могао бити отворен."

msgid "Puts it back next to each video file."
msgstr "Враћа је поред сваке видео датотеке."

msgid "ROLLBACK FAILED (%s)"
msgstr "ВРАЋАЊЕ НИЈЕ УСПЕЛО (%s)"

msgid "Reading audio track from %s"
msgstr "Читање аудио траке из %s"

msgid "Remove all %s %ss from the list?\n\n%s"
msgstr "Уклонити са листе све датотеке ове врсте? Има их %s, врста: %s.\n\n%s"

msgid "Resolutions"
msgstr "Резолуције"

msgid "Resolve running ..."
msgstr "Resolve у току ..."

msgid "Resolve scales to the Timeline resolution. Anything smaller is scaled up and gets softer."
msgstr "Resolve скалира на резолуцију Timeline-а. Све што је мање увећава се и постаје мекше."

msgid "Response was not JSON: %s"
msgstr "Одговор није био JSON: %s"

msgid "Rows marked red show where the problem is; a tick on the tab means everything is there."
msgstr "Редови означени црвеном показују где је проблем; квачица на картици значи да је тамо све на месту."

msgid "Save in Keychain"
msgstr "Сачувај у Keychain-у"

msgid "Save in Registry"
msgstr "Сачувај у регистар"

msgid "Select audio and video files"
msgstr "Изаберите аудио и видео датотеке"

msgid "Speakers, as the run measured them"
msgstr "Говорници, како их је измерило покретање"

msgid "Speakers, self-measured from the tracks"
msgstr "Говорници, које је програм сам измерио из трака"

msgid "Started late or stopped early -- this voice is then missing from the mix in places."
msgstr "Покренут касно или заустављен рано -- овај глас тада местимично недостаје у миксу."

msgid "Stopped. Choose another production name -- then a new production\n  is created -- or pick one of the other options."
msgstr "Заустављено. Изаберите друго име продукције -- тада се прави нова\n  продукција -- или изаберите једну од других могућности."

msgid "Stopped. Nothing was created."
msgstr "Заустављено. Ништа није направљено."

msgid "Stopped. Nothing was uploaded and nothing computed."
msgstr "Заустављено. Ништа није отпремљено и ништа није израчунато."

msgid "Used as it stands -- nothing is invented. Check in Resolve under Clip Attributes, tab Color Space: if it says \"Project\" there, the input colour space was not recognised and has to be set by hand."
msgstr "Користи се како стоји -- ништа се не измишља. Проверите у Resolve-у под Clip Attributes, картица Color Space: ако тамо пише „Project”, улазни простор боја није препознат и мора да се подеси ручно."

msgid "Takes the position from the picture."
msgstr "Узима позицију из слике."

msgid "Ten seconds back."
msgstr "Десет секунди уназад."

msgid "The Resolve interface is not where I expect it:\n  %s\n  %s"
msgstr "Интерфејс Resolve-а није тамо где га очекујем:\n  %s\n  %s"

msgid "The Resolve interface is not where it should be."
msgstr "Интерфејс Resolve-а није тамо где би требало да буде."

msgid "The Timeline gets one fixed rate -- the highest of them, or the next rate Resolve has above it. It converts the others; with 23.976 against 24 that is where its audio analysis tends to stall."
msgstr "Timeline добија један фиксан број кадрова -- највећи међу њима, или следећи који Resolve има изнад њега. Остале претвара; код 23,976 наспрам 24 његова аудио анализа обично застане."

msgid "The audio recording of every speaker, plus the cameras.\nThe order does not matter -- the program recognises what is what.\nFor a multi-part recording the first block is enough."
msgstr "Аудио снимак сваког говорника, плус камере.\nРедослед није битан -- програм препознаје шта је шта.\nКод вишеделног снимка довољан је први блок."

msgid "The cut has no picture there. When the Timeline is built the spot stays empty, the audio runs on."
msgstr "Монтажа тамо нема слику. Када се Timeline гради, то место остаје празно, аудио тече даље."

msgid "The existing result is unusable: %s is missing there. With --auphonic-resume rerun it can be recomputed without uploading anything."
msgstr "Постојећи резултат је неупотребљив, тамо недостаје следеће: %s. Помоћу --auphonic-resume rerun може се поново израчунати без отпремања."

msgid "The cut rules leave no shot standing in these %s. A shorter shortest shot, or less wide shot, gives one again."
msgstr "Правила монтаже не остављају ниједан кадар у овим %s. Краћи најкраћи кадар, или мање широког кадра, поново даје један."

msgid "The programme is %s long here -- nothing can be laid out in that. In point and Out point are what set it."
msgstr "Емисија овде траје %s -- у толико се ништа не може поставити. Тачка In и тачка Out су оно што то одређује."

msgid "The time window lies outside the material: In point at %s, Out point at %s, and the material runs %s."
msgstr "Временски прозор је изван материјала: тачка In на %s, тачка Out на %s, а материјал траје %s."

msgid "The first preset track sets the settings for all our tracks. Otherwise they come back unprocessed. Create a track in the preset in the web interface."
msgstr "Прва трака пресета одређује подешавања за све наше траке. Иначе се враћају необрађене. Направите траку у пресету у веб интерфејсу."

msgid "That needs the handover file from a run, and there is none."
msgstr "За то је потребна датотека предаје из извршавања, а нема је."

msgid "The key can only be stored on Mac and Windows -- in the keychain or the registry. It does not go into a file."
msgstr "Кључ може да се чува само на Mac-у и Windows-у -- у Keychain-у или у регистру. У датотеку не иде."

msgid "%s -- being checked"
msgstr "%s -- проверава се"

msgid "The key was not saved: %s"
msgstr "Кључ није сачуван: %s"

msgid "The key was not saved"
msgstr "Кључ није сачуван"

msgid "The keychain is locked. Unlock it and try again."
msgstr "Keychain је закључан. Откључајте га и покушајте поново."

msgid "This run is a test run and the store still carries its real name, so nothing was written. Point KEY_SERVICE, KEY_ACCOUNT or REG_PATH somewhere else first."
msgstr "Ово покретање је тестно, а складиште још носи своје право име, па ништа није записано. Прво усмерите KEY_SERVICE, KEY_ACCOUNT или REG_PATH на друго место."

msgid "The keychain is locked. Unlock it and this button wakes up."
msgstr "Keychain је закључан. Откључајте га и ово дугме ће се пробудити."

msgid "The keychain did not take the key. Keychain Access can say why."
msgstr "Keychain није прихватио кључ. Keychain Access може да каже зашто."

msgid "The registry did not take the key."
msgstr "Регистар није прихватио кључ."

msgid "Open Keychain Access"
msgstr "Отвори Keychain Access"

msgid "Opens the app that unlocks the keychain."
msgstr "Отвара апликацију која откључава Keychain."

msgid "  Keychain Access could not be opened: %s"
msgstr "  Keychain Access није могао да се отвори: %s"

msgid "The stored key is not accepted: %s"
msgstr "Сачувани кључ није прихваћен: %s"

msgid "The key from AUPHONIC_TOKEN is not accepted: %s"
msgstr "Кључ из AUPHONIC_TOKEN није прихваћен: %s"

msgid "What auphonic.com replied"
msgstr "Шта је auphonic.com одговорио"

msgid "There is no key."
msgstr "Нема кључа."

msgid "The key has a space or a line break at one end."
msgstr "Кључ има размак или прелом реда на једном крају."

msgid "The key is broken in the middle by a space or a line break."
msgstr "Кључ је у средини прекинут размаком или преломом реда."

msgid "The key has a character in it that cannot be typed."
msgstr "Кључ садржи знак који се не може откуцати."

msgid "The key is then in the %s, never in a file."
msgstr "Кључ тада не иде у датотеку, него овде: %s."

msgid "The production has no name yet."
msgstr "Продукција још нема име."

msgid "The recording assigned to this camera instead of the camera audio."
msgstr "Снимак додељен овој камери уместо аудија камере."

msgid "The run is still going."
msgstr "Извршавање још траје."

msgid "No speakers are known yet -- they are worked out of the tracks as soon as this tab is opened. Where everybody is on one recording, \"several speakers\" in the Speaker name field is the way."
msgstr "Још нису познати говорници -- утврђују се из трака чим се отвори ова картица. Где су сви на једном снимку, пут је \"више говорника\" у пољу Име говорника."

msgid "The three numbers are primaries, curve and matrix. Different tags need different input colour spaces in Resolve -- otherwise one camera looks unlike the other."
msgstr "Три броја су примарне боје, крива и матрица. Различите ознаке захтевају различите улазне просторе боја у Resolve-у -- иначе једна камера изгледа другачије од друге."

msgid "There are no separate audio recordings. Then the audio of the %s cameras is used -- each becomes a track, and Auphonic removes the bleed."
msgstr "Нема засебних аудио снимака. Тада се користи аудио камера (%s) -- свака постаје трака, а Auphonic уклања преслушавање."

msgid "There is no result yet."
msgstr "Још нема резултата."

msgid "These files are neither audio nor video and stay out:\n\n  %s"
msgstr "Ове датотеке нису ни аудио ни видео и остају напољу:\n\n  %s"

msgid "These files do not exist:\n  "
msgstr "Ове датотеке не постоје:\n  "

msgid "These files exist already and will be written again:\n\n  %s\n\nIs that intended?"
msgstr "Ове датотеке већ постоје и биће поново записане:\n\n  %s\n\nДа ли је то намера?"

msgid "These files no longer exist:\n  "
msgstr "Ове датотеке више не постоје:\n  "

msgid "These names occur more than once:\n\n  %s\n\nThe recordings are merged into one track and laid end to end by their timecode. That is right if recording was stopped in between."
msgstr "Ова имена се појављују више пута:\n\n  %s\n\nСнимци се спајају у једну траку и ређају један за другим по свом тајмкоду. То је исправно ако је снимање у међувремену заустављано."

msgid "These tracks got no file: %s"
msgstr "Ове траке нису добиле датотеку: %s"

msgid "This Resolve project already exists"
msgstr "Овај Resolve пројекат већ постоји"

msgid "This comes from the recording, not afterwards: the microphones sit too close together or too far from the mouth."
msgstr "Ово потиче из снимања, не од касније: микрофони стоје преблизу један другом или предалеко од уста."

msgid "This file cannot be played here, and ffplay is missing as a fallback."
msgstr "Ова датотека се овде не може репродуковати, а ffplay као резерва недостаје."

msgid "This is not a project file, and there is none in the same folder.\n\nThe search is for %s*.json -- the script writes it into the output folder at start."
msgstr "Ово није датотека пројекта, а у истој фасцикли нема ниједне.\n\nТражи се %s*.json -- скрипта је уписује у излазну фасциклу при покретању."

msgid "This is what happens next"
msgstr "Ево шта следи"

msgid "This name is on somebody else already. A name is a person, and the cut puts a person on one camera -- please give this voice its own."
msgstr "Ово име већ носи неко други. Име је особа, а монтажа ставља особу на једну камеру -- дајте овом гласу сопствено."

msgid "This name occurs more than once. The recordings would become one track -- for Multitrack auphonic.com needs at least two different ones."
msgstr "Ово име се јавља више пута. Снимци би постали једна трака -- за Multitrack auphonic.com треба бар две различите."

msgid "This production already exists"
msgstr "Ова продукција већ постоји"

msgid "This production has no result yet."
msgstr "Ова продукција још нема резултат."

msgid "Time limit of %s reached, production still running: %s/engine/status/%s"
msgstr "Достигнуто временско ограничење од %s, продукција још траје: %s/engine/status/%s"

msgid "Timecode %s, the other files are at %s -- this clock was not set."
msgstr "Тајмкод %s, остале датотеке су на %s -- овај сат није био подешен."

msgid "Timeline %r could not be created."
msgstr "Timeline %r није могао бити направљен."

msgid "Title at auphonic.com and start of the new file names."
msgstr "Наслов на auphonic.com и почетак нових имена датотека."

msgid "To the In point."
msgstr "На тачку In."

msgid "To the start."
msgstr "На почетак."

msgid "Too many projects with this name."
msgstr "Превише пројеката са овим именом."

msgid "Track"
msgstr "Трака"

msgid "Tracks were added while changing (now %s). That makes the mix\n  wrong. Please delete the tracks without a file at auphonic.com."
msgstr "Током измене додате су траке (сада %s). То чини микс\n  погрешним. Обришите на auphonic.com траке без датотеке."

msgid "Two cameras are one camera in the cut. Their files carry the same name, so rename one of them."
msgstr "Две камере су једна камера у монтажи. Њихове датотеке носе исто име, зато преименујте једну од њих."

msgid "Two cameras are one camera in the cut: %s. Their files carry the same name, so rename one of them."
msgstr "Две камере су једна камера у монтажи: %s. Њихове датотеке носе исто име, па преименујте једну од њих."

msgid "Two cameras would produce the same file. The second would overwrite the first."
msgstr "Две камере би дале исту датотеку. Друга би преписала прву."

msgid "Two cameras would produce the same file: %s"
msgstr "Две камере би дале исту датотеку: %s"

msgid "Two cameras would produce the same new file. Please give different names."
msgstr "Две камере би дале исту нову датотеку. Дајте различита имена."

msgid "Uneven frame timing cannot be evened out through the audio. If the sample points spread during alignment as well, convert to a fixed frame rate."
msgstr "Неуједначен временски распоред кадрова не може да се изравна преко аудија. Ако се и тачке узорковања расипају при поравнању, претворите у фиксан број кадрова у секунди."

msgid "Video"
msgstr "Видео"

msgid "Video 1"
msgstr "Видео 1"

msgid "Video 2"
msgstr "Видео 2"

msgid "Video Podcast Magic %s -- raw material becomes an edited podcast"
msgstr "Video Podcast Magic %s -- од сировог материјала настаје монтиран подкаст"

msgid "Volume. 100 is as loud as it goes -- Qt takes nothing above that."
msgstr "Јачина звука. 100 је највише што иде -- Qt не прима ништа изнад тога."

msgid "%s (%s) -- talking at once counts twice"
msgstr "%s (%s) -- истовремени говор се рачуна двапут"

msgid "Wide shot for greeting at the start and farewell at the end"
msgstr "Широки кадар за поздрав на почетку и опроштај на крају"

msgid "Without it every player has to guess, and all guess SDR. In Resolve under Deliver > Advanced Settings set the Color space tag and the Gamma tag instead of leaving them at \"Same as Project\"."
msgstr "Без ње сваки плејер мора да нагађа, а сви нагађају SDR. У Resolve-у под Deliver > Advanced Settings поставите Color space tag и Gamma tag уместо да их оставите на „Same as Project”."

msgid "Without processing at auphonic.com"
msgstr "Без обраде на auphonic.com"

msgid "There is no camera cut yet: it needs two people, each with a name and a camera.\nSeparate recordings give that with the Multitrack tick, and so does \"several speakers\" in the Speaker name field of one recording --\nthe voices found there get their camera in the table under the recordings.\nA Resolve project is created anyway -- all cameras at their measured places, ready for Multicam."
msgstr "Још нема монтаже камера: потребне су две особе, свака са именом и камером.\nОдвојени снимци то дају уз квачицу Multitrack, а исто тако и „више говорника“ у пољу Име говорника једног снимка --\nтамо нађени гласови добијају своју камеру у табели испод снимака.\nResolve пројекат се свакако прави -- све камере на својим измереним местима, спремне за Multicam."

msgid "Without timecode the position of the files is measured."
msgstr "Без тајмкода положај датотека се мери."

msgid "Works out who speaks when from the tracks themselves -- one microphone per person, level against its own noise floor. Where everybody is on one recording, \"several speakers\" in the Speaker name field is the way."
msgstr "Из самих трака утврђује ко када говори -- један микрофон по особи, ниво наспрам сопственог шума. Где су сви на једном снимку, пут је \"више говорника\" у пољу Име говорника."

msgid "a box no longer fits into its parent"
msgstr "један бокс више не стаје у свој родитељски"

msgid "after the device change"
msgstr "после промене уређаја"

msgid "auphonic.com does not accept the key: %s"
msgstr "auphonic.com не прихвата кључ: %s"

msgid "average"
msgstr "просек"

msgid "belongs to"
msgstr "припада"

msgid "bleed too indistinct: %s of %s seconds usable, sharpest %s of %s needed"
msgstr "преслушавање превише нејасно: секунди употребљиво: %s од %s, потребно најоштријих: %s од %s"

msgid "Midnight"
msgstr "Поноћ"

msgid "%s carries a timecode from the other side of midnight -- counted as one night, not as a day apart."
msgstr "%s носи тајмкод са друге стране поноћи -- рачуна се као једна ноћ, а не као дан разлике."

msgid "A timecode counts from midnight and starts over there. The files are put on one axis before anything is subtracted, otherwise the recording after midnight looks almost a day away from the one before. If these really were recorded on different days, the alignment is wrong and the measured offset is the one to trust."
msgstr "Тајмкод броји од поноћи и тамо почиње изнова. Датотеке се стављају на једну осу пре него што се ишта одузме, иначе снимак после поноћи изгледа скоро дан удаљен од оног пре. Ако су ови заиста снимљени различитих дана, поравнање је погрешно и измерени померај је онај коме треба веровати."

msgid "Channel %d is against the stop: %s times three samples or more in a row, the longest %s (%s ms), the first at %s."
msgstr "Канал %d је на граници: %s пута три или више узастопних узорака, најдужи %s (%s ms), први на %s."

msgid "Counted here, sample by sample, at the rate the file was recorded at: a run of three or more samples on the highest value an integer format can hold. One or two are rounding and are not reported. What is cut off there is gone and no processing brings it back -- but the recording is still the recording, and this holds nothing up. Only integer formats are counted. 32 bit float has no stop at full scale, so there is nothing there to count."
msgstr "Овде бројано, узорак по узорак, брзином којом је датотека снимљена: низ од три или више узорака на највишој вредности коју целобројни формат може да прими. Један или два су заокруживање и не пријављују се. Оно што је тамо одсечено изгубљено је и никаква обрада га не враћа -- али снимак је и даље снимак, и ово ништа не зауставља. Броје се само целобројни формати. 32 bit float нема границу на пуној скали, па тамо нема шта да се броји."

msgid "boxes no longer readable"
msgstr "боксови се више не могу читати"

msgid "bring up to date -- both Timelines are deleted and\n       rebuilt, the media pool stays as it is"
msgstr "ажурирај -- оба Timeline-а се бришу и\n       поново граде, media pool остаје какав јесте"

msgid "cannot be read back (%s)"
msgstr "не може поново да се прочита (%s)"

msgid "checking ..."
msgstr "провера ..."

msgid "complete"
msgstr "потпуно"

msgid "create a new project alongside (name with suffix)"
msgstr "направи нови пројекат поред (име са суфиксом)"

msgid "curl ended with %d"
msgstr "curl се завршио са %d"

msgid "did not arrive: %s"
msgstr "нису стигли: %s"

msgid "does not belong: %s"
msgstr "не припада: %s"

msgid "does not exist: %s"
msgstr "не постоји: %s"

msgid "does the material fit together?"
msgstr "да ли се материјал слаже?"

msgid "does the preset fit the run?"
msgstr "да ли пресет одговара покретању?"

msgid "downloaded file is only %s bytes"
msgstr "бајтова у преузетој датотеци: само %s"

msgid "gap of %s per timecode, too far apart for one recording"
msgstr "празнина од %s по тајмкоду, предалеко за један снимак"

msgid "gets audio from"
msgstr "добија аудио од"

msgid "hear assigned audio"
msgstr "слушај додељени аудио"

msgid "keep our names and upload everything again -- this costs\n       credit"
msgstr "задржи наша имена и отпреми све поново -- ово троши\n       кредит"

msgid "leave it and put the new Timelines alongside --\n       the existing ones stay"
msgstr "остави га и стави нове Timeline-ове поред --\n       постојећи остају"

msgid "missing -- the container carries no colour tagging"
msgstr "недостаје -- контејнер не носи ознаку боје"

msgid "missing: %s"
msgstr "недостаје: %s"

msgid "moov has not grown"
msgstr "moov није порастао"

msgid "moov is no longer in its place"
msgstr "moov више није на свом месту"

msgid "moov no longer ends at the end of the file"
msgstr "moov се више не завршава на крају датотеке"

msgid "multi-part, no timecode -- gaps in between cannot be detected."
msgstr "вишеделно, без тајмкода -- празнине између њих не могу да се открију."

msgid "new file name"
msgstr "ново име датотеке"

msgid "next to each video file"
msgstr "поред сваке видео датотеке"

msgid "no audio data from %s"
msgstr "нема аудио података из %s"

msgid "no audio track present"
msgstr "нема аудио траке"

msgid "no audio: %s"
msgstr "нема аудија: %s"

msgid "no download address for %s"
msgstr "нема адресе за преузимање за %s"

msgid "no information"
msgstr "нема података"

msgid "no information in the file"
msgstr "нема података у датотеци"

msgid "no match in the middle either (%s)"
msgstr "нема поклапања ни у средини (%s)"

msgid "no place found where exactly one person speaks -- the separation cannot be measured."
msgstr "није нађено место где говори тачно једна особа -- раздвајање не може да се измери."

msgid "no production id in the response"
msgstr "нема идентификатора продукције у одговору"

msgid "no production id in the response: %s"
msgstr "нема идентификатора продукције у одговору: %s"

msgid "no timecode"
msgstr "нема тајмкода"

msgid "no video track"
msgstr "нема видео траке"

msgid "no video track in %s"
msgstr "нема видео траке у %s"

msgid "none switched on"
msgstr "ниједан није укључен"

msgid "not checked yet"
msgstr "још није проверено"

msgid "not in the media pool"
msgstr "није у media pool-у"

msgid "not measurable."
msgstr "није мерљиво."

msgid "not measurable: %s"
msgstr "није мерљиво: %s"

msgid "not needed with HLG"
msgstr "није потребно уз HLG"

msgid "not readable (%s) -- unchecked."
msgstr "нечитљиво (%s) -- непроверено."

msgid "not readable: %s"
msgstr "нечитљиво: %s"

msgid "nothing loaded yet"
msgstr "још ништа није учитано"

