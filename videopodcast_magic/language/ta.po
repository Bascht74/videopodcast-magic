msgstr "Media Pool-இல் இல்லை"

msgid "not measurable."
msgstr "அளவிட முடியாது."

msgid "not measurable: %s"
msgstr "அளவிட முடியாது: %s"

msgid "not needed with HLG"
msgstr "HLG-உடன் தேவையில்லை"

msgid "not readable (%s) -- unchecked."
msgstr "படிக்க முடியாது (%s) -- சரிபார்க்கப்படவில்லை."

msgid "not readable: %s"
msgstr "படிக்க முடியாது: %s"

msgid "nothing loaded yet"
msgstr "இன்னும் எதுவும் ஏற்றப்படவில்லை"

msgid "nothing selected"
msgstr "எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

msgid "off"
msgstr "ஆஃப்"

msgid "one Timeline"
msgstr "ஒரு Timeline"

msgid "only %s long, the longest recording has %s."
msgstr "நீளம் %s மட்டுமே, மிக நீளமான பதிவின் நீளம் %s."

msgid "overlap of %s per timecode"
msgstr "டைம்கோடின்படி %s மேற்பொருந்துதல்"

