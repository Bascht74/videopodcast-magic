msgid "cannot be read back (%s)"
msgstr "மீண்டும் படிக்க முடியவில்லை (%s)"

msgid "checking ..."
msgstr "சரிபார்க்கிறது ..."

msgid "complete"
msgstr "முழுமையானது"

msgid "create a new project alongside (name with suffix)"
msgstr "அருகிலேயே புதிய திட்டப்பணியை உருவாக்கு (பின்னொட்டுடன் பெயர்)"

