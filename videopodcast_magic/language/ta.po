msgstr[0] "%s தடம், %s, %s kHz, %s"
msgstr[1] "%s தடங்கள், %s, %s kHz, %s"

msgid "%s: sits at %s (target %s) after %d ms, %d attempt"
msgid_plural "%s: sits at %s (target %s) after %d ms, %d attempts"
msgstr[0] "%s: %s இல் நிற்கிறது (இலக்கு %s), %d ms கழித்து, %d முயற்சி"
msgstr[1] "%s: %s இல் நிற்கிறது (இலக்கு %s), %d ms கழித்து, %d முயற்சிகள்"

msgid ", %s file does not fit"
msgid_plural ", %s files do not fit"
msgstr[0] ", %s கோப்பு பொருந்தவில்லை"
msgstr[1] ", %s கோப்புகள் பொருந்தவில்லை"

msgid "Remove %s audio file from the list?\n\n%s"
msgid_plural "Remove all %s audio files from the list?\n\n%s"
msgstr[0] "பட்டியலிலிருந்து %s ஆடியோ கோப்பை அகற்றவா?\n\n%s"
msgstr[1] "பட்டியலிலிருந்து %s ஆடியோ கோப்புகள் அனைத்தையும் அகற்றவா?\n\n%s"

msgid "Remove %s video file from the list?\n\n%s"
msgid_plural "Remove all %s video files from the list?\n\n%s"
msgstr[0] "பட்டியலிலிருந்து %s வீடியோ கோப்பை அகற்றவா?\n\n%s"
msgstr[1] "பட்டியலிலிருந்து %s வீடியோ கோப்புகள் அனைத்தையும் அகற்றவா?\n\n%s"

msgid "%s audio recording"
msgid_plural "%s audio recordings"
msgstr[0] "%s ஆடியோ பதிவு"
msgstr[1] "%s ஆடியோ பதிவுகள்"

msgid "%s camera"
msgid_plural "%s cameras"
msgstr[0] "%s கேமரா"
msgstr[1] "%s கேமராக்கள்"

msgid "%s hint"
msgid_plural "%s hints"
msgstr[0] "%s குறிப்பு"
msgstr[1] "%s குறிப்புகள்"

msgid "%s point"
msgid_plural "%s points"
msgstr[0] "%s அம்சம்"
msgstr[1] "%s அம்சங்கள்"

msgid "%s video file"
msgid_plural "%s video files"
msgstr[0] "%s வீடியோ கோப்பு"
msgstr[1] "%s வீடியோ கோப்புகள்"

msgid "%s  + %s continuation"
msgid_plural "%s  + %s continuations"
msgstr[0] "%s  + %s தொடர்ச்சி"
msgstr[1] "%s  + %s தொடர்ச்சிகள்"

msgid "This makes %s video file, about %s. Target: %s"
msgid_plural "This makes %s video files, about %s. Target: %s"
msgstr[0] "இதனால் %s வீடியோ கோப்பு உருவாகும், சுமார் %s. சேருமிடம்: %s"
msgstr[1] "இதனால் %s வீடியோ கோப்புகள் உருவாகும், சுமார் %s. சேருமிடம்: %s"

msgid "  From %s: %s voice."
msgid_plural "  From %s: %s voices."
msgstr[0] "  %s மூலம்: %s குரல்."
msgstr[1] "  %s மூலம்: %s குரல்கள்."

msgid "  %-20s %s in %s passage"
msgid_plural "  %-20s %s in %s passages"
msgstr[0] "  %-20s %s, %s பகுதியில்"
msgstr[1] "  %-20s %s, %s பகுதிகளில்"

msgid "  %s cannot be classified: %s -- placed by its clock alone"
msgstr "  %s-ஐ வகைப்படுத்த முடியவில்லை: %s -- அதன் கடிகாரத்தை மட்டும் வைத்து இடம் தரப்பட்டது"

msgid "  %s: its sound matches by %s, under the floor of %s -- placed by its clock alone"
msgstr "  %s: அதன் ஆடியோ %s அளவில் பொருந்துகிறது, அடிமட்டம் %s-க்குக் கீழே -- அதன் கடிகாரத்தை மட்டும் வைத்து இடம் தரப்பட்டது"

msgid "  Caution: this project is not complete -- Resolve refused these tracks twice:"
msgstr "  கவனம்: இந்தத் திட்டப்பணி முழுமையடையவில்லை -- Resolve இந்தத் தடங்களை இருமுறை மறுத்தது:"

msgid "  Offset:          %s   (from its timecode alone -- its sound could not place it, so nothing is checked)"
msgstr "  ஆஃப்செட்:              %s   (அதன் டைம்கோடை மட்டும் வைத்து -- அதன் ஆடியோவால் இதை வைக்க முடியவில்லை, எனவே எதுவும் சரிபார்க்கப்படவில்லை)"

msgid "  Resolve refused audio track A%d twice on the Timeline \"%s\" -- the cameras are laid on the %s audio tracks there are."
msgstr "  Resolve ஆடியோ தடம் A%d-ஐ Timeline \"%s\"-இல் இருமுறை மறுத்தது -- கேமராக்கள் அங்குள்ள %s ஆடியோ தடங்களில் வைக்கப்படுகின்றன."

msgid "  Resolve refused video track V%d twice -- the Timeline \"%s\" lacks %s."
msgstr "  Resolve வீடியோ தடம் V%d-ஐ இருமுறை மறுத்தது -- Timeline \"%s\"-இல் இது இல்லை: %s."

msgid "  Status:      %s"
msgstr "  நிலை:              %s"

msgid "  The sound of %s matched too weakly to trust -- placed by the timecode alone."
msgstr "  நம்பும் அளவுக்கு ஆடியோ பொருந்தவில்லை: %s -- டைம்கோடை மட்டும் வைத்து இடம் தரப்பட்டது."

msgid "%s\n   does not fit the other files: sound not recognised,\n   nothing to set its timecode against.\n   %s"
msgstr "%s\n   மற்ற கோப்புகளுடன் பொருந்தவில்லை: ஆடியோ அடையாளம் காணப்படவில்லை,\n   அதன் டைம்கோடை ஒப்பிட எதுவும் இல்லை.\n   %s"

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and no camera the sound placed carries a timecode to set its own against. One of those needs a timecode that fits this one, and that has to be set with another program."
msgstr "%s கோப்பை எங்கும் வைக்க முடியாது: அதன் ஆடியோவுக்கு மற்ற மூலப்பதிவுகளுடன் பொதுவானது எதுவும் இல்லை, மேலும் ஆடியோ மூலம் வைக்கப்பட்ட எந்தக் கேமராவிலும் இதன் டைம்கோடை ஒப்பிடக்கூடிய டைம்கோடு இல்லை. அவற்றில் ஒன்றுக்கு இதனுடன் பொருந்தும் டைம்கோடு தேவை, அதை வேறொரு நிரல் மூலம் அமைக்க வேண்டும்."

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against, so it cannot be cut into the episode: set to Intro."
msgstr "%s மூலப்பொருளில் எதனுடனும் பொருந்தவில்லை, மேலும் ஆடியோ மூலம் வைக்கப்பட்ட எந்தக் கேமராவிலும் இதன் டைம்கோடை ஒப்பிடக்கூடிய டைம்கோடு இல்லை, எனவே எபிசோடுக்குள் வெட்டிச் சேர்க்க முடியாது: அறிமுகமாக அமைக்கப்பட்டது."

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against; the intro is taken: left out."
msgstr "%s மூலப்பொருளில் எதனுடனும் பொருந்தவில்லை, மேலும் ஆடியோ மூலம் வைக்கப்பட்ட எந்தக் கேமராவிலும் இதன் டைம்கோடை ஒப்பிடக்கூடிய டைம்கோடு இல்லை; அறிமுகம் ஏற்கனவே உள்ளது: விடப்பட்டது."

msgid "API Key:"
msgstr "API விசை:"

msgid "In point"
msgstr "இன் புள்ளி"

msgid "Left out; %s or %s is one click away."
msgstr "விலக்கப்பட்டது; %s அல்லது %s ஒரே ஒரு கிளிக் தொலைவில் உள்ளது."

msgid "Out point"
msgstr "அவுட் புள்ளி"

msgid "Presets:"
msgstr "முன்னமைவுகள்:"

msgid "Registry"
msgstr "பதிவகம்"

msgid "Removing AUDIO or VIDEO takes everything under it."
msgstr "\"ஆடியோ\" அல்லது \"வீடியோ\" பகுதியை அகற்றினால் அதன் கீழுள்ள அனைத்தும் அகற்றப்படும்."

msgid "VIDEO"
msgstr "வீடியோ"

msgid "a finished clip"
msgstr "முடிந்த கிளிப்"

msgid "cannot be cut into the episode -- only before or after it"
msgstr "எபிசோடுக்குள் வெட்ட முடியாது -- முன்னோ பின்னோ மட்டும்"

msgid "moved off the wide shot"
msgstr "வைட் ஷாட்டிலிருந்து நீக்கப்பட்டது"

msgid "neither its sound nor a timecode puts it on the axis"
msgstr "அதன் ஆடியோவோ டைம்கோடோ அதை அச்சில் வைக்கவில்லை"

msgid "no audio track"
msgstr "ஆடியோ இல்லை"

msgid "no speaker"
msgstr "பேச்சாளரில்லை"

msgid "not used"
msgstr "பயன்படாது"

msgid "placed with its camera, by that camera's clock"
msgstr "அதன் கேமராவுடன், அந்தக் கேமராவின் கடிகாரப்படி வைக்கப்பட்டது"

msgid "the file stays out"
msgstr "கோப்பு வெளியே"

msgid "the only sound"
msgstr "ஒரே ஆடியோ"

msgid "  Resolve refused audio track A%d twice -- the Timeline \"%s\" lacks the sound of %s."
msgstr "  Resolve ஆடியோ தடம் A%d-ஐ இருமுறை மறுத்தது -- Timeline \"%s\"-இல் %s-இன் ஆடியோ இல்லை."

msgid "  Resolve refused video track V%d twice -- the Timeline \"%s\" lacks the picture of %s."
msgstr "  Resolve வீடியோ தடம் V%d-ஐ இருமுறை மறுத்தது -- Timeline \"%s\"-இல் %s-இன் படம் இல்லை."
