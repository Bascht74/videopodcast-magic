msgid "recompute with the chosen preset -- the files stay\n       where they are, costs no credit"
msgstr "தேர்ந்தெடுத்த முன்னமைவுடன் மீண்டும் கணக்கிடு -- கோப்புகள்\n       இருக்கும் இடத்திலேயே இருக்கும், கிரெடிட் செலவாகாது"

msgid "reset"
msgstr "மீட்டமை"

msgid "running ..."
msgstr "இயங்குகிறது ..."

