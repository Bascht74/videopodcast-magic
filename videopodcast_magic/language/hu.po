msgstr "  A projektfájlt nem sikerült írni: %s"

msgid "  Project file not writable (%s)\n"
msgstr "  A projektfájl nem írható (%s)\n"

msgid "  Range:             %s LU (speech is usually 3 to 7 LU)"
msgstr "  Tartomány:         %s LU (beszédnél 3-7 LU a szokásos)"

msgid "  Reference: %s (%s, longest running time)"
msgstr "  Referencia: %s (%s, a leghosszabb futásidő)"

msgid "  Remains:           %s dB on every track, that is %s LUFS instead of %s"
msgstr "  Marad:             %s dB minden sávon, azaz %s LUFS %s helyett"

