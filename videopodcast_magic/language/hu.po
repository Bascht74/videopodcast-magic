msgstr "  A Resolve egyetlen képet sem vett át -- a Timeline üres. Semmi\n  más nem épül rá."

msgid "  Result: %s (%s) -- stays next to the video file\n"
msgstr "  Eredmény: %s (%s) -- a videófájl mellett marad\n"

