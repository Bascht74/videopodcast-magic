msgstr "  Lejátszó: a hang nem fut (%s) -- még egy próbálkozás."

msgid "  Please give a number between 1 and %d."
msgstr "  Adjon meg egy számot 1 és %d között."

msgid "  Production at auphonic.com:   %s"
msgstr "  Produkció az auphonic.com-on:   %s"

