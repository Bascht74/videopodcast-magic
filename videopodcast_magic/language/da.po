msgstr "Der mangler filer der -- uden en ny upload kan intet beregnes.\n  Med --auphonic-resume upload uploader scriptet igen; det koster kredit."

msgid "For HDR the usual choice is HEVC (Main 10), AV1 or VP9 Profile 2. YouTube takes H.264 too, but it needs more bitrate."
msgstr "Til HDR er det sædvanlige valg HEVC (Main 10), AV1 eller VP9 Profile 2. YouTube tager også H.264, men det kræver mere bitrate."

msgid "For ten bits HEVC needs the Main 10 profile. In Resolve it sits under Deliver as \"Profile\"."
msgstr "Til ti bit behøver HEVC profilen Main 10. I Resolve ligger den under Deliver som \"Profile\"."

msgid "%s fps, not the %s in the file -- %s fewer frames in the same length."
msgstr "%s fps, ikke de %s der står i filen -- %s billeder færre på samme længde."

msgid "%s fps, not the %s in the file -- %s more frames in the same length."
msgstr "%s fps, ikke de %s der står i filen -- %s billeder mere på samme længde."

msgid "Frame spacing varies by %s %% -- the frame timing is uneven."
msgstr "Billedafstanden varierer med %s %% -- billedtakten er ujævn."

msgid "Free space there: %s"
msgstr "Ledig plads der: %s"

