msgstr "किसी ने समय पर जवाब नहीं दिया"

msgid "the answer did not keep the floor"
msgstr "उत्तर देने वाला बोलता नहीं रहा"

msgid "nobody was speaking at the question"
msgstr "प्रश्न के समय कोई नहीं बोल रहा था"

msgid "from the finished run -- %s speakers, %s"
msgstr "पूरे हुए रन से -- %s वक्ता, %s"

msgid "measured from the recordings -- %s speakers, %s"
msgstr "रिकॉर्डिंग से मापा गया -- %s वक्ता, %s"

