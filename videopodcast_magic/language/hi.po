msgid_plural "  From %s: %s voices."
msgstr[0] "  %s से: %s आवाज़।"
msgstr[1] "  %s से: %s आवाज़ें।"

msgid "  %s word came back without a time and was left out."
msgid_plural "  %s words came back without a time and were left out."
msgstr[0] "  %s शब्द बिना समय के लौटा और छोड़ दिया गया।"
msgstr[1] "  %s शब्द बिना समय के लौटे और छोड़ दिए गए।"

msgid "%s file was finished before that and is whole: %s"
msgid_plural "%s files were finished before that and are whole: %s"
msgstr[0] "%s फ़ाइल उससे पहले पूरी हो चुकी थी और पूरी है: %s"
msgstr[1] "%s फ़ाइलें उससे पहले पूरी हो चुकी थीं और पूरी हैं: %s"

msgid "%s point"
msgid_plural "%s points"
msgstr[0] "%s बिंदु"
msgstr[1] "%s बिंदु"

msgid "Cut by speaker"
msgstr "वक्ता के अनुसार कट"

msgid "Sync only"
msgstr "केवल सिंक"

msgid "Project type"
msgstr "परियोजना प्रकार"

msgid "No project type chosen yet."
msgstr "अभी कोई परियोजना प्रकार नहीं चुना गया।"

msgid "What is this production to become?"
msgstr "इस प्रोडक्शन को क्या बनना है?"

msgid "\"%s\": the cameras on one time axis and a cut by who is speaking.\n\"%s\": the cameras on one time axis, nothing more -- no speakers, no cut."
msgstr "\"%s\": कैमरे एक समय अक्ष पर और इस आधार पर कट कि कौन बोल रहा है।\n\"%s\": कैमरे एक समय अक्ष पर, इससे अधिक कुछ नहीं -- न वक्ता, न कट।"

msgid "Sync only: no cut. The handover carries the multicam timeline alone; the Resolve project is created from the Output tab."
msgstr "केवल सिंक: कोई कट नहीं। सौंपने वाली फ़ाइल में केवल मल्टीकैम Timeline है; Resolve परियोजना \"आउटपुट\" टैब से बनाई जाती है।"

msgid "Project type: Sync only -- no speakers, no transcript, no cut; the handover carries the multicam timeline alone."
msgstr "परियोजना प्रकार: केवल सिंक -- न वक्ता, न ट्रांसक्रिप्ट, न कट; सौंपने वाली फ़ाइल में केवल मल्टीकैम Timeline है।"

msgid "\n  Sync only: no cut by speaker was asked for.\n  Only the Timeline for the multicam clip is built."
msgstr "\n  केवल सिंक: वक्ता के अनुसार कट नहीं माँगा गया।\n  केवल मल्टीकैम क्लिप के लिए Timeline बनाई जाती है।"

msgid "  %s video tracks, named after the camera files:"
msgstr "  %s वीडियो ट्रैक, कैमरा फ़ाइलों के नाम पर:"

msgid "Sync only takes one audio recording; this is one more: %s"
msgstr "केवल सिंक में एक ही ऑडियो रिकॉर्डिंग ली जाती है; यह एक और है: %s"

msgid "Sync only: the handover is worked out again; there is no cut to redo. Resolve must be running."
msgstr "केवल सिंक: सौंपने वाली फ़ाइल फिर से निकाली जाती है; दोबारा करने को कोई कट नहीं है। Resolve चल रहा होना चाहिए।"

msgid "%s has not started yet"
msgstr "%s अभी शुरू नहीं हुआ"

msgid "%s   --   the sound cannot be played"
msgstr "%s   --   ध्वनि नहीं चलाई जा सकती"

msgid "sound placed by clock -- measurement pending"
msgstr "घड़ी के अनुसार ध्वनि रखी गई -- माप बाकी है"

msgid "\nSPEAKER LEVELS"
msgstr "\nवक्ताओं के स्तर"

msgid "Measuring %s"
msgstr "%s मापा जा रहा है"

msgid "  %-20s not measurable -- left as it is"
msgstr "  %-20s मापा नहीं जा सकता -- जैसा है वैसा रहता है"

msgid "  %-20s %s LUFS -- nothing on it, left as it is"
msgstr "  %-20s %s LUFS -- इस पर कुछ नहीं, जैसा है वैसा रहता है"

msgid "  %-20s %s LUFS  ->  %s dB"
msgstr "  %-20s %s LUFS  ->  %s dB"

msgid "  Only one voice -- nothing to match it against."
msgstr "  केवल एक आवाज़ -- मिलाने को कुछ नहीं।"

msgid "  Common level:      %s LUFS, the median of the voices"
msgstr "  साझा स्तर:           %s LUFS, आवाज़ों की माध्यिका"

msgid "--new-name names %s, which is not one of the camera files of this run."
msgstr "--new-name में %s दिया गया है, जो इस रन की कैमरा फ़ाइलों में से कोई नहीं है।"

msgid "The new name for %s is empty; give a plain file name or leave --new-name out."
msgstr "%s के लिए नया नाम खाली है; कोई सादा फ़ाइल नाम दें या --new-name हटा दें।"

msgid "The new name \"%s\" for %s holds \"%s\", a folder or drive separator; give a plain file name."
msgstr "नया नाम \"%s\" (%s के लिए) में \"%s\" है, जो फ़ोल्डर या ड्राइव का विभाजक है; कोई सादा फ़ाइल नाम दें।"

msgid "The new name \"%s\" for %s begins with a dot, which makes a hidden file or a folder; give a plain file name."
msgstr "नया नाम \"%s\" (%s के लिए) बिंदु से शुरू होता है, जिससे छिपी फ़ाइल या फ़ोल्डर बनता है; कोई सादा फ़ाइल नाम दें।"

msgid "Two cameras would be written as one file, %s: %s and %s."
msgstr "दो कैमरे एक ही फ़ाइल के रूप में लिखे जाते, %s: %s और %s।"

msgid "--new-name gives %s two names, \"%s\" and \"%s\"; give each file one."
msgstr "--new-name %s को दो नाम देता है, \"%s\" और \"%s\"; हर फ़ाइल को केवल एक नाम दें।"

msgid "The assignment file names the cameras here, so --new-name would be dropped; give the names there or leave --new-name out."
msgstr "यहाँ कैमरों के नाम नियतन फ़ाइल देती है, इसलिए --new-name छोड़ दिया जाता; नाम वहीं दें या --new-name हटा दें।"

msgid "With cameras only, each file is named after the tracks taken from its sound, so --new-name would be dropped; leave --new-name out."
msgstr "केवल कैमरों के साथ हर फ़ाइल का नाम उसकी ध्वनि से लिए गए ट्रैकों पर रखा जाता है, इसलिए --new-name छोड़ दिया जाता; --new-name हटा दें।"

msgid "work without Auphonic"
msgstr "Auphonic के बिना काम करें"

msgid "Only after a question that is not the main speaker's, when somebody else takes over at once and keeps the floor.\n\"do not go early\" means no early camera change: the picture follows the sound here as it does everywhere else."
msgstr "केवल ऐसे प्रश्न के बाद जो मुख्य वक्ता का नहीं है, जब कोई और तुरंत बोलना शुरू करे और बोलता रहे।\n\"पहले न जाएँ\" का अर्थ है: कैमरा पहले नहीं बदलता, चित्र यहाँ भी हर जगह की तरह ध्वनि के पीछे चलता है।"

msgid "\"Alternating\" remembers what the last break of this monologue showed. The listener only gets the picture when someone on that camera was heard in the last 20 seconds; otherwise the wide shot."
msgstr "\"बारी-बारी से\" याद रखता है कि इस एकालाप को पिछली बार तोड़ते समय क्या दिखाया गया था। श्रोता को चित्र तभी मिलता है जब उस कैमरे पर पिछले 20 सेकंड में कोई सुनाई दिया हो; अन्यथा वाइड शॉट।"

msgid "Cutting into a jumble looks frantic."
msgstr "आवाज़ों की गड़बड़ में काटना हड़बड़ी भरा लगता है।"

msgid "A breath in the middle of a sentence and the end of a thought are both silence, and the program cannot tell them apart. Only the length can: \"Short gap up to\" says how long a silence may be and still count as a breath."
msgstr "वाक्य के बीच की साँस और किसी विचार का अंत, दोनों चुप्पी हैं, और प्रोग्राम उन्हें अलग नहीं कर सकता। केवल लंबाई कर सकती है: \"छोटा अंतराल तक\" बताता है कि चुप्पी कितनी लंबी हो सकती है और फिर भी साँस मानी जाए।"

msgid "Guessing puts the wrong person on screen for seconds; the wide shot is right in every case. Somebody is speaking here -- where nobody is, \"Nobody speaks\" decides."
msgstr "अनुमान लगाने से सेकंडों तक गलत व्यक्ति परदे पर रहता है; वाइड शॉट हर हाल में सही है। यहाँ कोई बोल रहा है -- जहाँ कोई नहीं बोलता, वहाँ \"कोई नहीं बोलता\" तय करता है।"

msgid "A negative value makes the picture lead the sound."
msgstr "ऋणात्मक मान से चित्र ध्वनि से आगे चलता है।"

msgid "Zero is where the asker stops, not where the answer starts: the pause between them belongs to the question. Applies only where \"After a question\" asks for it, and the Edit Change Delay is not added again."
msgstr "शून्य वहाँ है जहाँ प्रश्न पूछने वाला रुकता है, वहाँ नहीं जहाँ उत्तर शुरू होता है: बीच का विराम प्रश्न का हिस्सा है। यह केवल वहीं लागू होता है जहाँ \"प्रश्न के बाद\" इसे माँगता है, और Edit Change Delay फिर से नहीं जोड़ा जाता।"

msgid "The soft limit of the pair: from here the program waits for a sentence boundary and puts the wide shot there, not on the clock. 0 turns it off. \"Wide shot at the latest\" is the hard limit, where it cuts without one."
msgstr "इन दोनों की नरम सीमा: यहाँ से प्रोग्राम वाक्य की सीमा की प्रतीक्षा करता है और वाइड शॉट वहीं रखता है, घड़ी के अनुसार नहीं। 0 इसे बंद करता है। \"वाइड शॉट अधिकतम विलंब\" कठोर सीमा है, जहाँ वाक्य की सीमा के बिना भी काटा जाता है।"

msgid "The hard limit of the pair: where no sentence boundary has turned up since \"Wide shot after\", the longest speech pause stands in for one, and at this point the cut happens whatever is being said."
msgstr "इन दोनों की कठोर सीमा: यदि \"वाइड शॉट के बाद\" से कोई वाक्य की सीमा नहीं आई, तो सबसे लंबा बोलने का विराम उसकी जगह लेता है, और इस बिंदु पर काटा जाता है, चाहे उस समय कुछ भी कहा जा रहा हो।"

msgid "It then runs to the end of the sentence. Below five seconds the look reads as a twitch."
msgstr "फिर यह वाक्य के अंत तक चलता है। पाँच सेकंड से कम में यह झलक एक झटके जैसी लगती है।"

msgid "Where the end of the sentence lies beyond it, the last clause break before it ends the shot -- it is not cut off mid-sentence."
msgstr "यदि वाक्य का अंत इस सीमा के बाद पड़ता है, तो उससे पहले की अंतिम उपवाक्य-सीमा शॉट समाप्त करती है -- वाक्य के बीच में नहीं काटा जाता।"

msgid "Shorter shots fall into the following one."
msgstr "छोटे शॉट अगले शॉट में मिल जाते हैं।"

msgid "A short \"yes\" does not move the picture. Without this a block of half a second draws the camera over, and the minimum edit duration then holds it there for seconds."
msgstr "एक छोटा \"हाँ\" चित्र को नहीं हिलाता। इसके बिना आधे सेकंड का एक खंड कैमरे को अपनी ओर खींच लेता है, और फिर न्यूनतम शॉट अवधि उसे सेकंडों तक वहीं रोके रखती है।"

msgid "Only where \"Nobody speaks\" is set to hold a short gap. A gap up to this long changes nothing, a longer one goes to the wide shot. Above two seconds the picture begins to stand on someone silent for over five seconds."
msgstr "केवल वहाँ जहाँ \"कोई नहीं बोलता\" छोटा अंतराल बनाए रखने पर सेट है। इतनी लंबाई तक का अंतराल कुछ नहीं बदलता, इससे लंबा वाइड शॉट पर जाता है। दो सेकंड से ऊपर चित्र किसी चुप व्यक्ति पर पाँच सेकंड से अधिक टिकने लगता है।"

msgid "BT.2020 constant"
msgstr "BT.2020 स्थिर"

msgid "reserved"
msgstr "आरक्षित"

msgid "\n  To convert: in the media pool right-click \"%s Multicam\" >\n  \"Convert Timeline to Multicam Clip\" > \"Use Source Audio Channels\".\n  One way only -- but a new run rebuilds the Timeline at any time.\n  Angles:%s\n  Everything else -- audio choice, colour groups, framing -- is in the\n  manual, docs/resolve.md.\n"
msgstr "\n  बदलने के लिए: Media Pool में \"%s Multicam\" पर राइट-क्लिक >\n  \"Convert Timeline to Multicam Clip\" > \"Use Source Audio Channels\"।\n  यह केवल एक दिशा में होता है -- पर नया रन Timeline को कभी भी फिर से बनाता है।\n  एंगल:%s\n  बाकी सब -- ऑडियो का चुनाव, रंग समूह, फ़्रेमिंग -- नियमावली में है,\n  docs/resolve.md।\n"

msgid "Possible reasons:\n  1. Resolve is not running -- the interface answers only while the program runs.\n  2. Preferences > System > General: external scripting is set to \"None\" instead of \"Local\".\n  3. Free edition: external scripting is reported to be reserved for the Studio edition since version 19.1. I found no official statement -- this check measures it instead of claiming it."
msgstr "संभावित कारण:\n  1. Resolve नहीं चल रहा -- स्क्रिप्टिंग इंटरफ़ेस केवल तभी उत्तर देता है जब प्रोग्राम चल रहा हो।\n  2. Preferences > System > General: external scripting \"Local\" के बजाय \"None\" पर सेट है।\n  3. मुफ़्त संस्करण: बताया जाता है कि Resolve 19.1 से external scripting केवल Studio संस्करण के लिए है। मुझे कोई आधिकारिक बयान नहीं मिला -- यह जाँच इसका दावा करने के बजाय इसे मापती है।"

msgid "  %s cannot be classified: %s -- placed by its clock alone"
msgstr "  %s का वर्गीकरण नहीं हो सकता: %s -- केवल उसकी घड़ी से रखा गया"

msgid "  %s: its sound matches by %s, under the floor of %s -- placed by its clock alone"
msgstr "  %s: उसकी ध्वनि %s तक मेल खाती है, न्यूनतम %s से नीचे -- केवल उसकी घड़ी से रखा गया"

msgid "  Offset:          %s   (from its timecode alone -- its sound could not place it, so nothing is checked)"
msgstr "  ऑफ़सेट:         %s   (केवल उसके टाइमकोड से -- उसकी ध्वनि उसे नहीं रख सकी, इसलिए कुछ जाँचा नहीं जाता)"

msgid "  Resolve refused audio track A%d twice on the Timeline \"%s\" -- the cameras are laid on the %s audio tracks there are."
msgstr "  Resolve ने ऑडियो ट्रैक A%d को Timeline \"%s\" पर दो बार अस्वीकार किया -- कैमरे मौजूद %s ऑडियो ट्रैकों पर रखे गए हैं।"

msgid "  Resolve refused video track V%d twice -- the Timeline \"%s\" lacks %s."
msgstr "  Resolve ने वीडियो ट्रैक V%d दो बार अस्वीकार किया -- Timeline \"%s\" में यह नहीं है: %s।"

msgid "  Status:      %s"
msgstr "  स्थिति:        %s"

msgid "  The sound of %s matched too weakly to trust -- placed by the timecode alone."
msgstr "  %s की ध्वनि इतनी कमज़ोर मेल खाई कि उस पर भरोसा नहीं -- केवल टाइमकोड से रखा गया।"

msgid "%s\n   does not fit the other files: sound not recognised,\n   nothing to set its timecode against.\n   %s"
msgstr "%s\n   बाकी फ़ाइलों से मेल नहीं खाता: ध्वनि नहीं पहचानी गई,\n   उसका टाइमकोड मिलाने के लिए कुछ नहीं।\n   %s"

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and no camera the sound placed carries a timecode to set its own against. One of those needs a timecode that fits this one, and that has to be set with another program."
msgstr "%s को रखा नहीं जा सकता: इसकी ध्वनि बाकी सामग्री से कुछ भी मेल नहीं खाती, और जिन कैमरों को ध्वनि ने रखा, उनमें से किसी में ऐसा टाइमकोड नहीं जिससे इसका अपना मिलाया जा सके। उनमें से एक को ऐसा टाइमकोड चाहिए जो इससे मेल खाए, और वह किसी दूसरे प्रोग्राम से लगाना होगा।"

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against, so it cannot be cut into the episode: set to Intro."
msgstr "%s सामग्री में किसी से मेल नहीं खाता, और जिन कैमरों को ध्वनि ने रखा, उनमें से किसी में ऐसा टाइमकोड नहीं जिससे इसका अपना मिलाया जा सके, इसलिए इसे एपिसोड में काटकर नहीं डाला जा सकता: इंट्रो पर सेट किया गया।"

msgid "%s fits nothing in the material, and no camera the sound placed carries a timecode to set its own against; the intro is taken: left out."
msgstr "%s सामग्री में किसी से मेल नहीं खाता, और जिन कैमरों को ध्वनि ने रखा, उनमें से किसी में ऐसा टाइमकोड नहीं जिससे इसका अपना मिलाया जा सके; इंट्रो पहले से तय है: छोड़ दिया गया।"

msgid "API Key:"
msgstr "API Key:"

msgid "In point"
msgstr "इन पॉइंट"

msgid "Left out; %s or %s is one click away."
msgstr "बाहर रखा गया; %s या %s एक क्लिक दूर है।"

msgid "Out point"
msgstr "आउट पॉइंट"

msgid "Presets:"
msgstr "प्रीसेट:"

msgid "Registry"
msgstr "Registry"

msgid "VIDEO"
msgstr "वीडियो"

msgid "a finished clip"
msgstr "तैयार क्लिप"

msgid "cannot be cut into the episode -- only before or after it"
