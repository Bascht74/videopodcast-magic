msgid "  Error while writing: %s"
msgstr "  लिखते समय त्रुटि: %s"

msgid "  iXML for %s not written: %s"
msgstr "  %s के लिए iXML नहीं लिखा गया: %s"

msgid "Each shot in the colour of its camera. Hover for camera and duration, click to jump."
msgstr "हर शॉट अपने कैमरे के रंग में। कैमरा और अवधि के लिए माउस ले जाएँ, जाने के लिए क्लिक करें।"

msgid "Show twice as much (minus key, or the wheel over the band)"
msgstr "दोगुना दिखाएँ (माइनस कुंजी, या पट्टी पर व्हील)"

msgid "Show half as much, around the current position (plus key, or the wheel over the band)"
msgstr "आधा दिखाएँ, वर्तमान स्थिति के आसपास (प्लस कुंजी, या पट्टी पर व्हील)"

msgid "The whole length again (0 key)"
msgstr "फिर से पूरी लंबाई (कुंजी 0)"

msgid "Play forward, twice as fast on every press -- the L key."
msgstr "आगे चलाएँ, हर दबाव पर दोगुनी गति -- L कुंजी।"

msgid "after the device change"
msgstr "डिवाइस बदलने के बाद"

msgid "Audio at programme time"
msgstr "कार्यक्रम समय पर ऑडियो"

msgid "External preview -- the app does not know this format"
msgstr "बाहरी पूर्वावलोकन -- ऐप यह फ़ॉर्मेट नहीं जानता"

msgid "Play and pause -- the space bar works too."
msgstr "चलाएँ और रोकें -- स्पेस बार भी काम करता है।"

msgid "The recording assigned to this camera instead of the camera audio."
msgstr "कैमरा ऑडियो के बजाय इस कैमरे को सौंपी गई रिकॉर्डिंग।"

msgid "No player is built in here -- playback runs in ffplay in its own window."
msgstr "यहाँ कोई प्लेयर अंतर्निहित नहीं -- प्लेबैक ffplay में उसकी अपनी विंडो में चलता है।"

msgid "/not seekable"
msgstr "/सीक योग्य नहीं"

msgid "%s: should go to %s%s -- %s"
msgstr "%s: %s%s पर जाना चाहिए -- %s"

msgid "%s: setPosition(%s), attempt %d, then at %s"
msgstr "%s: setPosition(%s), प्रयास %d, फिर %s पर"

msgid "  Player: %s"
msgstr "  प्लेयर: %s"

msgid "Video 1"
msgstr "वीडियो 1"

msgid "Video 2"
msgstr "वीडियो 2"

msgid "Volume. 100 is as loud as it goes -- Qt takes nothing above that."
msgstr "वॉल्यूम। 100 सबसे ऊँचा है -- Qt इससे ऊपर कुछ नहीं लेता।"

msgid "%s reports %s"
msgstr "%s सूचित करता है %s"

msgid "  Player: audio output switches to %s"
msgstr "  प्लेयर: ऑडियो आउटपुट %s पर जाता है"

msgid "--- jump to %s programme time%s ---"
msgstr "--- कार्यक्रम समय %s पर जाएँ%s ---"

msgid "  Player: the audio is not running (%s) -- one more attempt."
msgstr "  प्लेयर: ऑडियो नहीं चल रहा (%s) -- एक और प्रयास।"

msgid "--- point set, programme time runs from %s ---"
msgstr "--- बिंदु तय, कार्यक्रम समय %s से चलता है ---"

msgid "Clock %7.2f%s | B1[%s] %s | B2[%s] %s | Audio %s %s"
msgstr "घड़ी %7.2f%s | B1[%s] %s | B2[%s] %s | ऑडियो %s %s"

msgid "Prepare pane %d for %s"
msgstr "पैन %d को %s के लिए तैयार करें"

msgid "  --  this file is outside"
msgstr "  --  यह फ़ाइल बाहर है"

msgid "%s virtual"
msgstr "%s आभासी"

msgid "%s   --   the app does not know this format"
msgstr "%s   --   ऐप यह फ़ॉर्मेट नहीं जानता"

msgid "  Player: %s stays at %s instead of %s -- given up after %s attempts (%s)"
msgstr "  प्लेयर: %s %s पर रुका है, %s के बजाय -- %s प्रयासों के बाद छोड़ा (%s)"

msgid "the default device"
msgstr "डिफ़ॉल्ट डिवाइस"

msgid "Audio file %s"
msgstr "ऑडियो फ़ाइल %s"

msgid "Fast forward, %s times speed"
msgstr "तेज़ आगे, %s गुना गति"

msgid "Pane %d on %s"
msgstr "पैन %d %s पर"

msgid "Pane %d loads %s (%s)"
msgstr "पैन %d %s लोड करता है (%s)"

msgid "   --   audio only"
msgstr "   --   केवल ऑडियो"

msgid "  (this file starts later)"
msgstr "  (यह फ़ाइल बाद में शुरू होती है)"

msgid "Playing %s -- the processed track from auphonic.com,\nbrought to broadcast level. The same audio as in the camera cut."
msgstr "%s चल रहा है -- auphonic.com से संसाधित ट्रैक,\nप्रसारण स्तर पर। वही ऑडियो जो कैमरा कट में है।"

msgid "Playing %s -- the raw recording.\nIt is much quieter than the processed audio; once the tracks from auphonic.com\nare there, the preview takes those."
msgstr "%s चल रहा है -- कच्ची रिकॉर्डिंग।\nयह संसाधित ऑडियो से काफ़ी धीमी है; auphonic.com से ट्रैक आते ही\nपूर्वावलोकन उन्हें लेता है।"

msgid "%s: not seekable yet, will follow (%s)"
msgstr "%s: अभी सीक योग्य नहीं, बाद में होगा (%s)"

msgid " SEEKING"
msgstr " खोज रहा"

msgid "MUTED"
msgstr "म्यूट"

msgid "  Player: %s reports an error -- %s"
msgstr "  प्लेयर: %s त्रुटि बताता है -- %s"

msgid " target %.2f"
msgstr " लक्ष्य %.2f"

msgid "volume %.2f"
msgstr "वॉल्यूम %.2f"

msgid "the source folder"
msgstr "स्रोत फ़ोल्डर"

msgid "Loudness of the finished episode"
msgstr "तैयार एपिसोड की लाउडनेस"

msgid "Free space there: %s"
msgstr "वहाँ खाली जगह: %s"

msgid "About %s missing. Free up space or choose another folder with --out. The temporary files during the run go somewhere else again, into the system temp folder."
msgstr "लगभग %s कम है। जगह खाली करें या --out से कोई दूसरा फ़ोल्डर चुनें। रन के दौरान की अस्थायी फ़ाइलें फिर किसी और जगह जाती हैं, सिस्टम के temp फ़ोल्डर में।"

msgid "The estimate is rough, so this is not room enough. Free up space or choose another folder with --out."
msgstr "अनुमान मोटा है, इसलिए यह जगह पर्याप्त नहीं। जगह खाली करें या --out से कोई दूसरा फ़ोल्डर चुनें।"

msgid "Disk space"
msgstr "डिस्क स्थान"

msgid "How loud the finished episode is made. The same gain goes on every\ntrack, so the balance between the speakers is kept.\n\"Take from source files\" adjusts nothing at all: auphonic.com goes\non doing what its preset says, and without auphonic.com the sound\nstays as it is in the source files."
msgstr "तैयार एपिसोड कितना तेज़ बनाया जाए। हर ट्रैक पर वही गेन\nलगता है, इसलिए वक्ताओं के बीच संतुलन बना रहता है।\n\"स्रोत फ़ाइलों से लें\" कुछ भी नहीं बदलता: auphonic.com वही\nकरता है जो उसका प्रीसेट कहता है, और auphonic.com के बिना ऑडियो\nवैसा ही रहता है जैसा स्रोत फ़ाइलों में है।"

msgid "Algorithms"
msgstr "एल्गोरिदम"

msgid "%s checked"
msgstr "%s जाँचे गए"

msgid "    --anyway is set: it runs despite the points above."
msgstr "    --anyway सेट है: ऊपर के बिंदुओं के बावजूद चलता है।"

msgid "does the material fit together?"
msgstr "क्या सामग्री आपस में मेल खाती है?"

msgid " -- nothing to fault."
msgstr " -- कोई कमी नहीं।"

msgid "Note: "
msgstr "टिप्पणी: "

msgid "fixed: "
msgstr "ठीक किया: "

msgid "Caution: "
msgstr "सावधान: "

msgid "%s fps -- %s, %dx%d, %s frames in %s"
msgstr "%s fps -- %s, %dx%d, %s फ़्रेम %s में"

msgid "Uneven frame timing cannot be evened out through the audio. If the sample points spread during alignment as well, convert to a fixed frame rate."
msgstr "असमान फ़्रेम समय को ऑडियो के ज़रिए बराबर नहीं किया जा सकता। यदि संरेखण में नमूना बिंदु भी बिखरते हैं, तो स्थिर फ़्रेम दर में बदलें।"

msgid "Frame rates"
msgstr "फ़्रेम दरें"

msgid "The Timeline gets one fixed rate -- the highest of them, or the next rate Resolve has above it. It converts the others; with 23.976 against 24 that is where its audio analysis tends to stall."
msgstr "Timeline को एक स्थिर दर मिलती है -- इनमें सबसे ऊँची, या उसके ऊपर Resolve की अगली दर। बाकी को वह बदल देता है; 23.976 बनाम 24 पर उसका ऑडियो विश्लेषण अक्सर वहीं अटक जाता है।"

msgid "Colour space"
msgstr "कलर स्पेस"

msgid "Used as it stands -- nothing is invented. Check in Resolve under Clip Attributes, tab Color Space: if it says \"Project\" there, the input colour space was not recognised and has to be set by hand."
msgstr "जैसा है वैसा ही लिया जाता है -- कुछ गढ़ा नहीं जाता। Resolve में Clip Attributes, टैब Color Space में देखें: यदि वहाँ \"Project\" लिखा है, तो इनपुट कलर स्पेस पहचाना नहीं गया और उसे हाथ से सेट करना होगा।"

msgid "Capture curve"
msgstr "रिकॉर्डिंग कर्व"

msgid "It is in the logs atom of the picture description -- that is how Resolve recognises the input colour space. Different curves mean different input colour spaces."
msgstr "यह चित्र-विवरण के logs एटम में होता है -- इसी से Resolve इनपुट कलर स्पेस पहचानता है। अलग-अलग कर्व का अर्थ है अलग-अलग इनपुट कलर स्पेस।"

msgid "Colour tag"
msgstr "कलर टैग"

msgid "The three numbers are primaries, curve and matrix. Different tags need different input colour spaces in Resolve -- otherwise one camera looks unlike the other."
msgstr "तीनों संख्याएँ प्राइमरी, कर्व और मैट्रिक्स हैं। अलग-अलग टैग को Resolve में अलग-अलग इनपुट कलर स्पेस चाहिए -- वरना एक कैमरा दूसरे से अलग दिखता है।"

msgid "Resolutions"
msgstr "रिज़ॉल्यूशन"

msgid "Resolve scales to the Timeline resolution. Anything smaller is scaled up and gets softer."
msgstr "Resolve, Timeline के रिज़ॉल्यूशन पर स्केल करता है। जो छोटा है, उसे बड़ा किया जाता है और वह धुंधला हो जाता है।"

msgid "Every pair of channels is judged on its own: one stereo track, or two microphones and therefore two tracks. Silent inputs drop out. The rows under the file say what was measured, and the tick overrules it."
msgstr "हर चैनल-जोड़ी को अलग से आँका जाता है: एक स्टीरियो ट्रैक, या दो माइक्रोफ़ोन और इसलिए दो ट्रैक। मौन इनपुट हटा दिए जाते हैं। फ़ाइल के नीचे की पंक्तियाँ बताती हैं कि क्या मापा गया, और टिक का निशान उस पर भारी पड़ता है।"

msgid "Counted here, sample by sample, at the rate the file was recorded at: a run of three or more samples on the highest value an integer format can hold. One or two are rounding and are not reported. What is cut off there is gone and no processing brings it back -- but the recording is still the recording, and this holds nothing up. Only integer formats are counted. 32 bit float has no stop at full scale, so there is nothing there to count."
msgstr "यहाँ सैंपल-दर-सैंपल गिना जाता है, उसी सैंपल रेट पर जिस पर फ़ाइल रिकॉर्ड हुई: तीन या अधिक सैंपल की लगातार श्रृंखला उस उच्चतम मान पर जिसे कोई पूर्णांक फ़ॉर्मेट रख सकता है। एक या दो सैंपल राउंडिंग हैं और रिपोर्ट नहीं होते। जो वहाँ कट गया, वह चला गया और कोई प्रोसेसिंग उसे वापस नहीं लाती -- पर रिकॉर्डिंग फिर भी रिकॉर्डिंग है, और इससे कुछ रुकता नहीं। केवल पूर्णांक फ़ॉर्मेट गिने जाते हैं। 32 bit float में फ़ुल स्केल पर कोई सीमा नहीं होती, इसलिए वहाँ गिनने को कुछ नहीं है।"

msgid "Midnight"
msgstr "आधी रात"

msgid "A timecode counts from midnight and starts over there. The files are put on one axis before anything is subtracted, otherwise the recording after midnight looks almost a day away from the one before. If these really were recorded on different days, the alignment is wrong and the measured offset is the one to trust."
msgstr "टाइमकोड आधी रात से गिनता है और वहीं से फिर शुरू होता है। कुछ भी घटाने से पहले फ़ाइलों को एक ही अक्ष पर रखा जाता है, वरना आधी रात के बाद की रिकॉर्डिंग पिछली से लगभग एक दिन दूर दिखती। अगर ये सचमुच अलग-अलग दिनों में रिकॉर्ड हुई थीं, तो संरेखण गलत है और मापा गया ऑफ़सेट ही भरोसेमंद है।"

msgid "Alignment goes by the measured offset; the timecode is only the cross-check."
msgstr "संरेखण मापे गए ऑफ़सेट से होता है; टाइमकोड केवल प्रति-जाँच के लिए है।"

msgid "not measurable."
msgstr "मापा नहीं जा सकता।"

msgid "no place found where exactly one person speaks -- the separation cannot be measured."
msgstr "ऐसी कोई जगह नहीं मिली जहाँ ठीक एक व्यक्ति बोलता हो -- पृथक्करण मापा नहीं जा सकता।"

msgid "3:1 rule"
msgstr "3:1 नियम"

msgid "This comes from the recording, not afterwards: the microphones sit too close together or too far from the mouth."
msgstr "यह रिकॉर्डिंग से आता है, बाद में नहीं: माइक्रोफ़ोन एक-दूसरे के बहुत पास हैं या मुँह से बहुत दूर।"

msgid "free %s, about %s needed (%s)"
msgstr "खाली %s, लगभग %s चाहिए (%s)"

msgid "taken from the source files, no --lufs given -- nothing is adjusted"
msgstr "स्रोत फ़ाइलों से लिया गया, --lufs नहीं दिया गया -- कुछ समायोजित नहीं होता"

msgid "none switched on"
msgstr "कोई चालू नहीं"

msgid "\nPREFLIGHT -- %s"
msgstr "\nपूर्व-जाँच -- %s"

msgid "\nStopped before the first long step. With --anyway it runs regardless."
msgstr "\nपहले लंबे चरण से पहले रोका गया। --anyway के साथ यह फिर भी चलता है।"

msgid "no video track"
msgstr "कोई वीडियो ट्रैक नहीं"

msgid "Frame spacing varies by %s %% -- the frame timing is uneven."
msgstr "फ़्रेमों का अंतराल %s %% तक बदलता है -- फ़्रेम टाइमिंग असमान है।"

msgid "the video files run at different rates: %s"
msgstr "वीडियो फ़ाइलें अलग-अलग फ़्रेम दरों पर चलती हैं: %s"

msgid "%s of %s video files carry no curve and no colour space in the colr box%s -- probably log material."
msgstr "%s वीडियो फ़ाइलें (कुल %s में से) colr बॉक्स में न कर्व रखती हैं न कलर स्पेस%s -- शायद Log सामग्री।"

msgid "the video files carry different recording curves: %s"
msgstr "वीडियो फ़ाइलों में अलग-अलग रिकॉर्डिंग कर्व हैं: %s"

msgid "the video files are tagged differently: %s"
msgstr "वीडियो फ़ाइलें अलग-अलग टैग की गई हैं: %s"

msgid "the video files have different picture sizes: %s"
msgstr "वीडियो फ़ाइलों के चित्र-आकार अलग-अलग हैं: %s"

msgid "%s kHz instead of %s kHz -- converted during processing."
msgstr "%s kHz है, %s kHz नहीं -- प्रोसेसिंग के दौरान बदला जाता है।"

msgid "%s channels -- cut into tracks, see the rows above."
msgstr "%s चैनल -- ट्रैकों में बाँटे जाते हैं, ऊपर की पंक्तियाँ देखें।"

msgid "Channel %d is against the stop: %s times three samples or more in a row, the longest %s (%s ms), the first at %s."
msgstr "चैनल %d सीमा पर है: %s बार लगातार तीन या अधिक सैंपल, सबसे लंबा %s (%s ms), पहला %s पर।"

msgid "Started late or stopped early -- this voice is then missing from the mix in places."
msgstr "देर से शुरू हुआ या जल्दी रुका -- तब यह आवाज़ मिक्स में जगह-जगह गायब रहती है।"

msgid "%s carries a timecode from the other side of midnight -- counted as one night, not as a day apart."
msgstr "%s में आधी रात के दूसरी ओर का टाइमकोड है -- इसे एक ही रात माना जाता है, एक दिन के अंतर के रूप में नहीं।"

msgid "Timecode %s, the other files are at %s -- this clock was not set."
msgstr "टाइमकोड %s, बाकी फ़ाइलें %s पर हैं -- यह घड़ी सेट नहीं थी।"

msgid "the recordings overlap only %s -- too little to measure."
msgstr "रिकॉर्डिंग केवल %s तक एक-दूसरे पर पड़ती हैं -- मापने के लिए बहुत कम।"

msgid "the shortest recording has only %s -- too little to measure."
msgstr "सबसे छोटी रिकॉर्डिंग केवल %s की है -- मापने के लिए बहुत कम।"

msgid "%s of %s comparisons are below %s dB -- every recording against every other, in both directions."
msgstr "%s तुलनाएँ (कुल %s में से) %s dB से नीचे हैं -- हर रिकॉर्डिंग हर दूसरी के विरुद्ध, दोनों दिशाओं में।"

msgid "Target: %s"
msgstr "गंतव्य: %s"

msgid "%s is set, and nothing is adjusted here: the tracks leave as they were recorded, and the loudness is set where they are mixed."
msgstr "%s सेट है, और यहाँ कुछ समायोजित नहीं होता: ट्रैक वैसे ही जाते हैं जैसे रिकॉर्ड हुए, और लाउडनेस वहाँ तय होती है जहाँ उन्हें मिक्स किया जाता है।"

