msgstr "  %s แทบไม่ได้พูดในช่วงเวลา -- ข้อเสนอ: ไม่ใช้"

msgid "Guest"
msgstr "แขกรับเชิญ"

msgid "Host"
msgstr "พิธีกร"

msgid "Host %d"
