msgstr "การส่งมอบและผลลัพธ์"

msgid "Show twice as much (minus key, or the wheel over the band)"
msgstr "แสดงมากขึ้นสองเท่า (ปุ่มลบ หรือหมุนล้อเมาส์บนแถบ)"

msgid "Show half as much, around the current position (plus key, or the wheel over the band)"
msgstr "แสดงครึ่งเดียว รอบตำแหน่งปัจจุบัน (ปุ่มบวก หรือหมุนล้อเมาส์บนแถบ)"

msgid "The whole length again (0 key)"
msgstr "กลับไปแสดงทั้งความยาว (ปุ่ม 0)"

msgid "  Also fetched: %s"
msgstr "  ดึงมาด้วย: %s"

msgid "Auphonic will not take the settings: %s"
msgstr "Auphonic ไม่รับการตั้งค่า: %s"

msgid "      %s channels"
msgstr "      %s ช่องสัญญาณ"

msgid "measurement running ..."
msgstr "กำลังวัด ..."

msgid "      Channel %d"
msgstr "      ช่องสัญญาณ %d"

msgid "Looking at the channels"
msgstr "กำลังตรวจดูช่องสัญญาณ"

msgid "channels not readable: %s"
msgstr "อ่านช่องสัญญาณไม่ได้: %s"

msgid "unused input -- ignored"
msgstr "อินพุตที่ไม่ได้ใช้ -- ละเว้น"

msgid "uncertain -- %s"
msgstr "ไม่แน่นอน -- %s"

msgid "set by hand -- overrides the measurement"
msgstr "ตั้งค่าเอง -- ใช้แทนผลการวัด"

msgid "both channels identical -- mono laid on both sides"
msgstr "ทั้งสองช่องเหมือนกัน -- วางโมโนไว้ทั้งสองข้าง"

msgid "probably two microphones -- about %s m apart%s"
msgstr "น่าจะเป็นไมโครโฟนสองตัว -- ห่างกันประมาณ %s m%s"

msgid ", agreed at %s of %s places"
msgstr ", ตรงกัน %s จาก %s ตำแหน่ง"

msgid "probably one stereo track -- both microphones in the same place"
msgstr "น่าจะเป็นแทร็กสเตอริโอเดียว -- ไมโครโฟนทั้งสองอยู่ที่เดียวกัน"

msgid "not recognisable -- only %s of %s places where both channels carry sound, %s needed"
msgstr "ระบุไม่ได้ -- มีเพียง %s จาก %s ตำแหน่งที่ทั้งสองช่องมีเสียง ต้องมี %s"

msgid "not recognisable -- these two agree no better than each does with the channel beside it"
msgstr "ระบุไม่ได้ -- สองช่องนี้ตรงกันไม่มากไปกว่าที่แต่ละช่องตรงกับช่องข้างเคียง"

msgid "not set"
msgstr "ไม่ได้ตั้งค่า"

msgid "The language spoken in the recording. It becomes the tag of the\nwritten audio track, and the recognition here is told to expect it.\nPreset from the system language. \"%s\" leaves the track untagged\nand lets the recognition work the language out itself."
msgstr "ภาษาที่พูดในการบันทึก ภาษานี้จะเป็นแท็กของแทร็กเสียง\nที่เขียนออกไป และการรู้จำตรงนี้จะได้รับแจ้งให้คาดว่าจะเป็นภาษานี้\nค่าเริ่มต้นมาจากภาษาของระบบ \"%s\" จะไม่ติดแท็กให้แทร็ก\nและปล่อยให้การรู้จำหาภาษาเอง"

msgid "German"
msgstr "ภาษาเยอรมัน"

msgid "English"
msgstr "ภาษาอังกฤษ"

msgid "French"
msgstr "ภาษาฝรั่งเศส"

