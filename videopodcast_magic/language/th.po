msgstr "ภาษาโปรตุเกส"

msgid "Polish"
msgstr "ภาษาโปแลนด์"

msgid "Russian"
msgstr "ภาษารัสเซีย"

msgid "Swedish"
msgstr "ภาษาสวีเดน"

msgid "Danish"
msgstr "ภาษาเดนมาร์ก"

msgid "Norwegian"
msgstr "ภาษานอร์เวย์"

msgid "Finnish"
msgstr "ภาษาฟินแลนด์"

msgid "Czech"
msgstr "ภาษาเช็ก"

