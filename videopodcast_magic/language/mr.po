msgstr "  रंग:              %d/%d/%d -- मूलरंग मॅट्रिक्समधून भरले (स्रोत: %d)"

msgid "  Colour:          %d/%d/%d carried over"
msgstr "  रंग:              %d/%d/%d कायम ठेवले"

