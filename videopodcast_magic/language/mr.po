msgstr "  या नावाची एक Timeline आहे जिच्यावर इतर कॅमेरे आहेत. ती तशीच राहते;\n  नवी तिच्या शेजारी स्वतःच्या वेगळ्या नावाने तयार होते."

msgid "  Added: %s"
msgstr "  जोडले: %s"

msgid "  Adding atoms taken back -- %s. %s"
msgstr "  ॲटम जोडणे मागे घेतले -- %s. %s"

msgid "  All needed output files already exist."
msgstr "  सर्व आवश्यक आउटपुट फाइली आधीच आहेत."

