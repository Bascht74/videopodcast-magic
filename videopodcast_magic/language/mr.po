msgstr "  %s आधीच आहे आणि त्यावर पुन्हा लिहिले जाते -- हे बनवल्याची कोणतीही नोंद या प्रॉडक्शनकडे नाही."

msgid "  %s is there from an earlier run of this production and is replaced."
msgstr "  %s या प्रॉडक्शनच्या आधीच्या रनमधून आहे आणि ते बदलले जाते."

msgid "  %s runs at %s frames/s, a rate Resolve has no Timeline for -- it is converted, not left out"
msgstr "  %s: %s फ्रेम/s, असा दर ज्यासाठी Resolve कडे कोणतीही Timeline नाही -- ते रूपांतरित केले जाते, वगळले जात नाही"

msgid "  %s is ready -- with --resolve-json it can be done later."
msgstr "  %s तयार आहे -- --resolve-json वापरून हे नंतर करता येईल."

msgid "  %s: %s, skipped"
msgstr "  %s: %s, वगळले"

msgid "  %s: how many channels it has cannot be determined (%s) -- it is not measured"
msgstr "  %s: यात किती चॅनेल आहेत हे ठरवता येत नाही (%s) -- ते मोजले जात नाही"

msgid "  (measuring only: nothing uploaded)\n"
msgstr "  (फक्त मोजमाप: काहीही अपलोड केले नाही)\n"

