msgstr "  कॅमेरा डेटा:        %s किल्ल्या कायम ठेवल्या (%s)"

msgid "  Camera data:     Caution, %s of %s keys are missing in the new file: %s"
msgstr "  कॅमेरा डेटा:        सावधान, नव्या फाइलमध्ये %s किल्ल्या नाहीत (एकूण %s पैकी): %s"

msgid "  Camera data:     the source carries none"
msgstr "  कॅमेरा डेटा:        स्रोतात एकही नाही"

