msgid "  Resolve refused video track V%d twice -- the Timeline \"%s\" lacks %s."
msgstr "  Resolve ने व्हिडिओ ट्रॅक V%d दोनदा नाकारला -- Timeline \"%s\" मध्ये हे नाही: %s."

msgid "  Status:      %s"
msgstr "  स्थिती:        %s"

