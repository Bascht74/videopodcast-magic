msgstr "fișierele video rulează la rate diferite: %s"

msgid "the video track can no longer be found"
msgstr "pista video nu mai poate fi găsită"

msgid "time axis measured -- jumps land at the same point"
msgstr "axa timpului măsurată -- salturile cad în același punct"

