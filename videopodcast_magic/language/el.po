msgstr "        Κομμάτι %d: %s"

msgid "      %-24s no file in the media pool"
msgstr "      %-24s κανένα αρχείο στο media pool"

msgid "      GetAudioMapping   empty (%r)"
msgstr "      GetAudioMapping   κενό (%r)"

msgid "    %-10s from %s, %s long%s"
msgstr "    %-10s από %s, διάρκεια %s%s"

