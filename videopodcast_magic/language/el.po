msgid "  Caution: %s and %s are both called %s. On the Timeline\n  Resolve reports only the name, so their clips cannot be told\n  apart -- rename one of the two files."
msgstr "  Προσοχή: τα %s και %s ονομάζονται και τα δύο %s. Στο Timeline\n  το Resolve αναφέρει μόνο το όνομα, οπότε τα κλιπ τους δεν ξεχωρίζουν\n  -- μετονομάστε το ένα από τα δύο αρχεία."

msgid "  Caution: %s could not be deleted -- the new Timeline therefore gets\n  an addition to its name."
msgstr "  Προσοχή: το %s δεν ήταν δυνατό να διαγραφεί -- το νέο Timeline παίρνει\n  γι' αυτό μια προσθήκη στο όνομά του."

msgid "  Caution: range      only %s LU -- very tight. Speech is usually 3 to 7 LU;\n                     below that it sounds squashed. Check how strongly the leveler\n                     is set at auphonic.com."
msgstr "  Προσοχή: εύρος      μόνο %s LU -- πολύ στενό. Στην ομιλία συνηθίζονται 3 έως 7 LU·\n                     κάτω από αυτό ακούγεται συμπιεσμένο. Ελέγξτε πόσο δυνατά είναι ρυθμισμένος\n                     ο ισοσταθμιστής στο auphonic.com."

msgid "  Caution: the production holds further tracks (%s). They go into the\n  mix -- please delete them at auphonic.com."
msgstr "  Προσοχή: η παραγωγή περιέχει κι άλλα κομμάτια (%s). Μπαίνουν στη\n  μίξη -- διαγράψτε τα στο auphonic.com."

msgid "  Caution: track %s -- it keeps its settings."
msgstr "  Προσοχή: κομμάτι %s -- διατηρεί τις ρυθμίσεις του."

msgid "  Camera atoms:    cannot be added (%s)"
msgstr "  Άτομα κάμερας:      δεν μπορούν να προστεθούν (%s)"

msgid "  Camera data:     %s keys carried over (%s)"
msgstr "  Δεδομένα κάμερας:    %s κλειδιά μεταφέρθηκαν (%s)"

msgid "  Camera data:     Caution, %s of %s keys are missing in the new file: %s"
msgstr "  Δεδομένα κάμερας:    Προσοχή, %s από %s κλειδιά λείπουν στο νέο αρχείο: %s"

msgid "  Camera data:     the source carries none"
msgstr "  Δεδομένα κάμερας:    η πηγή δεν έχει καθόλου"

msgid "  Cannot add atoms: a 64 bit box is in the way."
msgstr "  Δεν μπορούν να προστεθούν atom: ένα box 64 bit εμποδίζει."

msgid "  Cannot add atoms: moov is not at the end."
msgstr "  Δεν μπορούν να προστεθούν atom: το moov δεν είναι στο τέλος."

msgid "  Cannot add atoms: the source is %s, the target %s."
msgstr "  Δεν μπορούν να προστεθούν atom: η πηγή είναι %s, ο στόχος %s."

msgid "  Check:           not possible (%s)"
msgstr "  Έλεγχος:         δεν είναι δυνατός (%s)"

msgid "  Clock drift:     %s ppm (+/- %s), residual spread %s ms, %s of %s points"
msgstr "  Ολίσθηση ρολογιού:  %s ppm (+/- %s), υπολειπόμενη διασπορά %s ms, %s από %s σημεία"

msgid "  Clock drift:     nothing measured -- this is the reference the others are held against"
msgstr "  Ολίσθηση ρολογιού:  τίποτα δεν μετρήθηκε -- αυτή είναι η αναφορά με την οποία συγκρίνονται οι άλλες"

msgid "  Colour comparison not possible: %s"
msgstr "  Η σύγκριση χρωμάτων δεν είναι δυνατή: %s"

msgid "  Colour group %r cannot be created."
msgstr "  Η χρωματική ομάδα %r δεν μπορεί να δημιουργηθεί."

msgid "  Colour group %r cannot be created: %s"
msgstr "  Η χρωματική ομάδα %r δεν μπορεί να δημιουργηθεί: %s"

msgid "  Colour:          %d/%d/%d -- primaries filled in from the matrix (source: %d)"
msgstr "  Χρώμα:               %d/%d/%d -- τα πρωτεύοντα συμπληρώθηκαν από τον πίνακα (πηγή: %d)"

msgid "  Colour:          %d/%d/%d carried over"
msgstr "  Χρώμα:               %d/%d/%d μεταφέρθηκε"

msgid "  Colour:          Caution, %s in the source, %s in the new file"
msgstr "  Χρώμα:               Προσοχή, %s στην πηγή, %s στο νέο αρχείο"

msgid "  Cross-check:     %s from the Full-Mix, deviation %s ms (%s of %s points)%s"
msgstr "  Αντιπαραβολή:       %s από το Full-Mix, απόκλιση %s ms (%s από %s σημεία)%s"

msgid "  Cross-check:     not possible (%s)"
msgstr "  Αντιπαραβολή:       δεν είναι δυνατή (%s)"

msgid "  Data tracks:     %s carried over"
msgstr "  Κομμάτια δεδομένων:  %s μεταφέρθηκαν"

msgid "  Data tracks:     %s left out -- ffmpeg cannot write it"
msgstr "  Κομμάτια δεδομένων:  %s παραλείφθηκαν -- το ffmpeg δεν μπορεί να τα γράψει"

msgid "  Deleted: %s -- being rebuilt now."
msgstr "  Διαγράφηκε: %s -- ξαναχτίζεται τώρα."

msgid "  Drift over the running time: %s s = %s frames  -->  %s"
msgstr "  Ολίσθηση στη διάρκεια εκτέλεσης: %s δ. = %s καρέ  -->  %s"

msgid "  Existing result adopted -- nothing computed, nothing paid."
msgstr "  Το υπάρχον αποτέλεσμα υιοθετήθηκε -- τίποτα δεν υπολογίστηκε, τίποτα δεν πληρώθηκε."

msgid "  Fewer than two cameras with sound -- too few for Multitrack."
msgstr "  Λιγότερες από δύο κάμερες με ήχο -- πολύ λίγες για Multitrack."

msgid "  Finished mixdown requested as the yardstick (%s)"
msgstr "  Ζητήθηκε η τελική μίξη ως μέτρο σύγκρισης (%s)"

msgid "does not start where the block before it ends"
msgstr "δεν αρχίζει εκεί όπου τελειώνει το προηγούμενο μπλοκ"

msgid "ends before the next block starts"
msgstr "τελειώνει πριν αρχίσει το επόμενο μπλοκ"

msgid "  auphonic.com folded them. The mix keeps the two channels; what is gone is the\n  difference between the two microphones of that track."
msgstr "  Το auphonic.com τα δίπλωσε. Η μίξη κρατά τα δύο κανάλια· αυτό που χάθηκε είναι η\n  διαφορά ανάμεσα στα δύο μικρόφωνα εκείνου του κομματιού."

msgid "  Two channels, because one track is stereo"
msgstr "  Δύο κανάλια, επειδή ένα κομμάτι είναι στερεοφωνικό"

msgid "  Gap of %s at %s -- filled with silence"
msgstr "  Κενό %s στο %s -- γεμίστηκε με σιωπή"

msgid "  Overlap of %s at %s -- both sound there"
msgstr "  Επικάλυψη %s στο %s -- εκεί ακούγονται και τα δύο"

msgid "  They overlap -- several microphones at once, not blocks in a row."
msgstr "  Επικαλύπτονται -- πολλά μικρόφωνα ταυτόχρονα, όχι μπλοκ το ένα μετά το άλλο."

msgid "  Each one also goes into the video as a track of its own: %s"
msgstr "  Καθεμία μπαίνει επιπλέον στο βίντεο ως δικό της κομμάτι: %s"

msgid "  Only the mix goes into the video (--no-single-tracks)."
msgstr "  Μόνο η μίξη μπαίνει στο βίντεο (--no-single-tracks)."

msgid "  It already exists, with the same cameras in the same order -- it stays\n  untouched. Whoever wants a new one deletes it in Resolve."
msgstr "  Υπάρχει ήδη, με τις ίδιες κάμερες στην ίδια σειρά -- μένει\n  ανέγγιχτο. Όποιος θέλει νέο, το διαγράφει στο Resolve."

msgid "  Key frames of %s cannot be read (%s) -- the copy starts at the beginning of the file."
msgstr "  Τα καρέ-κλειδιά του %s δεν μπορούν να διαβαστούν (%s) -- το αντίγραφο αρχίζει από την αρχή του αρχείου."

msgid "  Level curve not possible (%s) -- without limiter"
msgstr "  Η καμπύλη στάθμης δεν είναι δυνατή (%s) -- χωρίς περιοριστή"

msgid "  Limiter:           at most %s dB, the same curve on every track%s"
msgstr "  Περιοριστής:       το πολύ %s dB, η ίδια καμπύλη σε κάθε κομμάτι%s"

msgid "  Loudness not measurable: %s"
msgstr "  Η ακουστότητα δεν μετριέται: %s"

msgid "  Loudness not measurable -- it stays as it is."
msgstr "  Η ακουστότητα δεν μπορεί να μετρηθεί -- μένει όπως είναι."

msgid "  Metrics not writable: %s"
msgstr "  Οι μετρικές δεν μπορούν να γραφτούν: %s"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  Mixdown από το auphonic.com: %s LUFS, κορυφή %s dBTP (%s)"

msgid "  No Full-Mix found -- the Timeline stays silent."
msgstr "  Δεν βρέθηκε Full-Mix -- το Timeline μένει σιωπηλό."

msgid "  No audio on the Timeline -- nothing to clean up."
msgstr "  Κανένας ήχος στο Timeline -- τίποτα να καθαριστεί."

msgid "  No cameras in the handover -- nothing to build."
msgstr "  Καμία κάμερα στην παράδοση -- τίποτα να χτιστεί."

msgid "  No clips found for colour groups."
msgstr "  Δεν βρέθηκαν κλιπ για χρωματικές ομάδες."

msgid "  No cut left -- the Timeline stays empty."
msgstr "  Δεν απέμεινε μοντάζ -- το Timeline μένει κενό."

msgid "  Not handed over: the run could not place %s, so it is no camera of this episode."
msgstr "  Δεν παραδόθηκε: η εκτέλεση δεν μπόρεσε να τοποθετήσει το %s, οπότε δεν είναι κάμερα αυτού του επεισοδίου."

msgid "  No measured offset for %s -- placed at the start of the axis."
msgstr "  Καμία μετρημένη μετατόπιση για το %s -- τοποθετήθηκε στην αρχή του άξονα."

msgid "  Nothing was found in the sound for %s -- placed by the timecode alone."
msgstr "  Δεν βρέθηκε τίποτα στον ήχο για το %s -- τοποθετήθηκε μόνο με το timecode."

msgid "  %s: the measurement puts it at %s s, the timecode at %s s -- the measurement is used."
msgstr "  %s: η μέτρηση την τοποθετεί στα %s δ., το timecode στα %s δ. -- χρησιμοποιείται η μέτρηση."

msgid "  The Timeline start %s was refused: %s"
msgstr "  Η αρχή %s του Timeline απορρίφθηκε: %s"

msgid "  The Timeline starts at %s, not at %s -- every shot sits that much further in."
msgstr "  Το Timeline ξεκινά στο %s, όχι στο %s -- κάθε πλάνο βρίσκεται τόσο πιο μέσα."

msgid "  The Timeline start %s was not accepted."
msgstr "  Η αρχή %s του Timeline δεν έγινε δεκτή."

msgid "  Start %s -- every shot is placed against it."
msgstr "  Αρχή %s -- κάθε πλάνο τοποθετείται σε σχέση με αυτήν."

msgid "  No such Timeline existed yet -- it is only built."
msgstr "  Δεν υπήρχε ακόμη τέτοιο Timeline -- απλώς χτίζεται."

msgid "  Note: this computes with the files uploaded at the time. They carry\n  the time window and the alignment of that day. Where the In point, the Out point\n  or the measured position differ now, the return check measures the\n  difference and moves the tracks into place."
msgstr "  Σημείωση: ο υπολογισμός γίνεται με τα αρχεία που μεταφορτώθηκαν τότε. Φέρουν\n  το χρονικό παράθυρο και την ευθυγράμμιση εκείνης της ημέρας. Όπου το σημείο In, το σημείο Out\n  ή η μετρημένη θέση διαφέρουν τώρα, ο έλεγχος επιστροφής μετρά τη\n  διαφορά και μετακινεί τα κομμάτια στη θέση τους."

msgid "  Note: this ffmpeg has no soxr -- clock drift can only be taken out in\n  steps of 21 ppm."
msgstr "  Σημείωση: αυτό το ffmpeg δεν έχει soxr -- η ολίσθηση ρολογιού αφαιρείται μόνο σε\n  βήματα των 21 ppm."

msgid "  Of no consequence for the sound."
msgstr "  Χωρίς σημασία για τον ήχο."

msgid "  Offset:          %s   (from the camera comparison)"
msgstr "  Μετατόπιση:         %s   (από τη σύγκριση των καμερών)"

msgid "  Only %s of %s shots are on the Timeline."
msgstr "  Μόνο %s από %s πλάνα βρίσκονται στο Timeline."

msgid "  Peaks:             %s dB above %s dBTP -- the limiter catches them"
msgstr "  Κορυφές:           %s dB πάνω από %s dBTP -- ο περιοριστής τις πιάνει"

msgid "  Player: %s reports an error -- %s"
msgstr "  Πρόγραμμα αναπαραγωγής: %s αναφέρει σφάλμα -- %s"

msgid "  Player: %s stays at %s instead of %s -- given up after %s attempts (%s)"
msgstr "  Πρόγραμμα αναπαραγωγής: %s παραμένει στο %s αντί για %s -- εγκαταλείφθηκε μετά από %s προσπάθειες (%s)"

msgid "  Player: audio output switches to %s"
msgstr "  Πρόγραμμα αναπαραγωγής: η έξοδος ήχου αλλάζει σε %s"

msgid "  Player: the audio is not running (%s) -- one more attempt."
msgstr "  Πρόγραμμα αναπαραγωγής: ο ήχος δεν τρέχει (%s) -- μία ακόμη προσπάθεια."

msgid "  Please give a number between 1 and %d."
msgstr "  Δώστε έναν αριθμό από 1 έως %d."

msgid "  Production at auphonic.com:   %s"
msgstr "  Παραγωγή στο auphonic.com:   %s"

msgid "  Production running (%s)"
msgstr "  Η παραγωγή εκτελείται (%s)"

msgid "  Project %r opened."
msgstr "  Το έργο %r ανοίχτηκε."

msgid "  Project file could not be written: %s"
msgstr "  Το αρχείο έργου δεν ήταν δυνατό να γραφτεί: %s"

msgid "  Project file not writable (%s)\n"
msgstr "  Το αρχείο έργου δεν είναι εγγράψιμο (%s)\n"

msgid "  Range:             %s LU (speech is usually 3 to 7 LU)"
msgstr "  Εύρος:             %s LU (στην ομιλία συνηθίζονται 3 έως 7 LU)"

msgid "  Reference: %s (%s, longest running time)"
msgstr "  Αναφορά: %s (%s, μεγαλύτερη διάρκεια)"

msgid "  Remains:           %s dB on every track, that is %s LUFS instead of %s"
msgstr "  Απομένει:          %s dB σε κάθε κομμάτι, δηλαδή %s LUFS αντί για %s"

msgid "  Resolve took no picture at all -- the Timeline is empty. Nothing\n  else is built on it."
msgstr "  Το Resolve δεν πήρε καμία εικόνα -- το Timeline είναι κενό. Τίποτα\n  άλλο δεν χτίζεται πάνω του."

msgid "  Result: %s (%s) -- stays next to the video file\n"
msgstr "  Αποτέλεσμα: %s (%s) -- μένει δίπλα στο αρχείο βίντεο\n"

msgid "  Not used:  %s."
msgstr "  Δεν χρησιμοποιήθηκαν:  %s."

msgid "  Question: %s in the transcript, %s became a reaction cut."
msgstr "  Ερώτηση: %s στην απομαγνητοφώνηση, %s έγιναν κοπή αντίδρασης."

msgid "  Question: no transcript, so no question was found and no reaction cut\n            happened. The words are written down from the finished mix during\n            the run; without them the setting does nothing."
msgstr "  Ερώτηση: δεν υπάρχει απομαγνητοφώνηση, οπότε δεν βρέθηκε ερώτηση και δεν\n            έγινε κοπή αντίδρασης. Οι λέξεις καταγράφονται από την τελική μίξη\n            κατά την εκτέλεση· χωρίς αυτές η ρύθμιση δεν κάνει τίποτα."

msgid "  Settings brought to preset %r"
msgstr "  Οι ρυθμίσεις μεταφέρθηκαν στην προρύθμιση %r"

msgid "  Start %s (earliest camera) -- otherwise everything would lie before the Timeline start."
msgstr "  Αρχή %s (η πρωιμότερη κάμερα) -- αλλιώς όλα θα βρίσκονταν πριν από την αρχή του Timeline."

msgid "  Not adjusted:      taken from the source files -- no gain on any track and no\n                     limiter. The sound leaves exactly as it came in."
msgstr "  Χωρίς προσαρμογή:  ελήφθη από τα αρχεία προέλευσης -- καμία ενίσχυση σε κανένα κομμάτι και\n                     κανένας περιοριστής. Ο ήχος βγαίνει ακριβώς όπως μπήκε."

msgid "  Sum of tracks:     %s LUFS, peak %s dBTP%s"
msgstr "  Σύνολο κομματιών:  %s LUFS, κορυφή %s dBTP%s"

msgid "  Target:            %s LUFS  ->  %s dB on every track"
msgstr "  Στόχος:            %s LUFS  ->  %s dB σε κάθε κομμάτι"

msgid "  The Timeline gets %s: the highest of them, or the next rate Resolve\n  has above it. Converted upwards Resolve repeats frames, downwards it\n  throws them away. Every camera keeps its own rate, and the cut counts\n  in that one."
msgstr "  Η Timeline παίρνει %s: τον υψηλότερο από αυτούς, ή τον επόμενο ρυθμό που\n  έχει το Resolve πάνω από αυτόν. Προς τα πάνω το Resolve επαναλαμβάνει καρέ,\n  προς τα κάτω τα πετάει. Κάθε κάμερα κρατά τον δικό της ρυθμό, και το μοντάζ\n  μετρά σε εκείνον."

msgid "  The Full-Mix could not be imported."
msgstr "  Το Full-Mix δεν ήταν δυνατό να εισαχθεί."

msgid "  The Full-Mix could not be inserted."
msgstr "  Το Full-Mix δεν ήταν δυνατό να εισαχθεί στο Timeline."

msgid "  The cameras carry the time window and a second at each end: %s written for %s of the %s recorded."
msgstr "  Οι κάμερες φέρουν το χρονικό παράθυρο και ένα δευτερόλεπτο σε κάθε άκρο: %s γράφτηκαν για %s από τα %s που καταγράφηκαν."

msgid "  The cameras lie close together (at most %s steps of brightness)."
msgstr "  Οι κάμερες βρίσκονται κοντά μεταξύ τους (το πολύ %s βαθμίδες φωτεινότητας)."

msgid "  The cut has changed: %s shots instead of %s."
msgstr "  Το μοντάζ άλλαξε: %s πλάνα αντί για %s."

msgid "  The record of earlier runs here cannot be read (%s), so everything already in place is reported."
msgstr "  Το αρχείο καταγραφής προηγούμενων εκτελέσεων εδώ δεν μπορεί να διαβαστεί (%s), οπότε αναφέρεται ό,τι υπάρχει ήδη."

msgid "  The cut stays as it was."
msgstr "  Το μοντάζ μένει όπως ήταν."

msgid "  The files are uploaded again -- this costs credit."
msgstr "  Τα αρχεία μεταφορτώνονται ξανά -- αυτό κοστίζει πίστωση."

msgid "  The files in the folder must be named after the speakers and belong\n  to this run. Without the folder it goes through auphonic.com again."
msgstr "  Τα αρχεία στον φάκελο πρέπει να έχουν τα ονόματα των ομιλητών και να ανήκουν\n  σε αυτήν την εκτέλεση. Χωρίς τον φάκελο περνά ξανά από το auphonic.com."

msgid "  The media pool stays as it is."
msgstr "  Το media pool μένει όπως είναι."

msgid "  The names from there are adopted:"
msgstr "  Τα ονόματα από εκεί υιοθετούνται:"

msgid "  There are %s tracks there and %s here -- that does not match."
msgstr "  Εκεί υπάρχουν %s κομμάτια και εδώ %s -- δεν ταιριάζουν."

msgid "  This camera could not be placed -- skipped"
msgstr "  Αυτή η κάμερα δεν μπόρεσε να τοποθετηθεί -- παραλείπεται"

msgid "  Time window:     %s of %s written, from %s of the camera"
msgstr "  Χρονικό παράθυρο:   %s από %s γράφτηκαν, από το %s της κάμερας"

msgid "  Timecode %s written as bext and iXML (reference: %s)"
msgstr "  Timecode %s γράφτηκε ως bext και iXML (αναφορά: %s)"

msgid "  Too much:          the limiter would have to take %s dB away. More than %s dB\n                     sounds squashed -- %s dB less gain."
msgstr "  Υπερβολικό:        ο περιοριστής θα έπρεπε να αφαιρέσει %s dB. Πάνω από %s dB\n                     ακούγεται συμπιεσμένο -- %s dB λιγότερη ενίσχυση."

msgid "  Transcript not possible (%s) -- it runs anyway."
msgstr "  Απομαγνητοφώνηση αδύνατη (%s) -- τρέχει έτσι κι αλλιώς."

msgid "  Wide shot at the edges: skipped -- the first or last announcement\n  would be too long for a greeting."
msgstr "  Γενικό πλάνο στα άκρα: παραλείφθηκε -- η πρώτη ή η τελευταία\n  αναγγελία θα ήταν πολύ μεγάλη για χαιρετισμό."

msgid "  Wide shot at the edges: until %s and from %s"
msgstr "  Γενικό πλάνο στα άκρα: έως %s και από %s"

msgid "  from %s, %s"
msgstr "  από %s, %s"

msgid "  iXML for %s not written: %s"
msgstr "  Το iXML για %s δεν γράφτηκε: %s"

msgid " at high frame rates"
msgstr " σε υψηλούς ρυθμούς καρέ"

msgid "%s  Audio starts per timecode at    %s"
msgstr "%s  Ο ήχος αρχίζει κατά το timecode στις    %s"

msgid "%s  Picture starts per timecode at  %s"
msgstr "%s  Η εικόνα αρχίζει κατά το timecode στις  %s"

msgid "%s  The audio timecode does not fit the picture at all -- probably a clock never set. The measurement is used."
msgstr "%s  Το timecode του ήχου δεν ταιριάζει καθόλου με την εικόνα -- πιθανώς ρολόι που δεν ρυθμίστηκε ποτέ. Χρησιμοποιείται η μέτρηση."

msgid "%s  The timecode does not fit what is heard. The measurement is used."
msgstr "%s  Το timecode δεν ταιριάζει με αυτό που ακούγεται. Χρησιμοποιείται η μέτρηση."

msgid "%s from %s recordings"
msgstr "%s από %s ηχογραφήσεις"

msgid "%s is missing."
msgstr "Λείπει: %s."

msgid "%s is on more than one speaker -- a name is a person, and every person needs their own."
msgstr "Το %s βρίσκεται σε περισσότερους από έναν ομιλητές -- ένα όνομα είναι ένα πρόσωπο, και κάθε πρόσωπο χρειάζεται το δικό του."

msgid "%s stands on more than one voice. A name is a person, and the cut puts a person on one camera -- two voices of one name would be one person in two places."
msgstr "%s βρίσκεται σε περισσότερες από μία φωνές. Ένα όνομα είναι ένα πρόσωπο, και το μοντάζ βάζει ένα πρόσωπο σε μία κάμερα -- δύο φωνές με ένα όνομα θα ήταν ένα πρόσωπο σε δύο θέσεις."

msgid "  This machine can install it properly: %s"
msgstr "  Αυτό το μηχάνημα μπορεί να το εγκαταστήσει σωστά: %s"

msgid "  Installing it: %s"
msgstr "  Εγκατάσταση: %s"

msgid "  On this machine: %s"
msgstr "  Σε αυτό το μηχάνημα: %s"

msgid "  Installing it: pip install %s"
msgstr "  Εγκατάσταση: pip install %s"

msgid "  %s would be installed into this Python: %s"
msgstr "  Το %s θα εγκατασταθεί σε αυτό το Python: %s"

msgid "  By hand:  %s -m pip install %s"
msgstr "  Χειροκίνητα:  %s -m pip install %s"

msgid "Could not look for a newer version: %s"
msgstr "Δεν ήταν δυνατή η αναζήτηση νεότερης έκδοσης: %s"

msgid "%s is missing. The first time it takes a few minutes."
msgstr "Λείπει το %s. Την πρώτη φορά παίρνει λίγα λεπτά."

msgid "  Run that now? [Y/n] "
msgstr "  Να εκτελεστεί τώρα; [Y/n] "

msgid "  That did not work: %s"
msgstr "  Αυτό δεν δούλεψε: %s"

msgid "  Putting it back: %s"
msgstr "  Επαναφορά: %s"

msgid "  ffmpeg.org has builds for Windows. The folder with ffmpeg.exe then has to go into PATH, or the files next to this program."
msgstr "  Το ffmpeg.org έχει έτοιμες εκδόσεις για Windows. Ο φάκελος με το ffmpeg.exe πρέπει έπειτα να μπει στο PATH, ή τα αρχεία δίπλα σε αυτό το πρόγραμμα."

msgid "  Open the page? [Y/n] "
msgstr "  Να ανοίξει η σελίδα; [Y/n] "

msgid "  The page could not be opened: %s"
msgstr "  Η σελίδα δεν ήταν δυνατό να ανοιχτεί: %s"

msgid "%s is missing -- installing it. The first time takes a few minutes."
msgstr "Λείπει το %s -- εγκαθίσταται. Την πρώτη φορά χρειάζονται λίγα λεπτά."

msgid "%sTimecode check of the audio file"
msgstr "%sΈλεγχος timecode του αρχείου ήχου"

msgid ", %s not (no free picture)"
msgstr ", %s όχι (χωρίς ελεύθερη εικόνα)"

msgid ", audio on A2"
msgstr ", ήχος στο A2"

msgid "Assignment file not readable: %s"
msgstr "Το αρχείο αντιστοίχισης δεν είναι αναγνώσιμο: %s"

msgid "Camera audio not usable: %s"
msgstr "Ο ήχος κάμερας δεν είναι χρησιμοποιήσιμος: %s"

msgid "MULTITRACK NOT POSSIBLE\n  At least two input tracks are needed, and only %s was found.\n  A track is a recording of its own, a channel of a multichannel\n  recorder, or the audio of a camera -- that counts as soon as its\n  Camera audio says \"use internal audio\". Without two of them there\n  is nothing to decouple, and the same file runs through as an\n  ordinary production."
msgstr "ΤΟ MULTITRACK ΔΕΝ ΕΙΝΑΙ ΔΥΝΑΤΟ\n  Χρειάζονται τουλάχιστον δύο κομμάτια εισόδου, και βρέθηκε μόνο %s.\n  Κομμάτι είναι μια δική του ηχογράφηση, ένα κανάλι πολυκάναλης\n  συσκευής εγγραφής ή ο ήχος μιας κάμερας -- αυτός μετράει μόλις ο\n  Ήχος κάμερας λέει \"χρήση εσωτερικού ήχου\". Χωρίς δύο από αυτά δεν\n  υπάρχει τίποτα να αποσυνδεθεί, και το ίδιο αρχείο περνά ως\n  συνηθισμένη παραγωγή."

msgid "No preset is called %r."
msgstr "Καμία προρύθμιση δεν ονομάζεται %r."

msgid "No sound in the cameras -- nothing to work with."
msgstr "Κανένας ήχος στις κάμερες -- δεν υπάρχει τίποτα για να δουλέψει."

msgid "Only one audio file and no picture -- nothing to do."
msgstr "Μόνο ένα αρχείο ήχου και καμία εικόνα -- τίποτα να γίνει."

msgid "Open project ..."
msgstr "Άνοιγμα έργου ..."

msgid "Save project"
msgstr "Αποθήκευση έργου"

msgid "Close project"
msgstr "Κλείσιμο έργου"

msgid "The project file goes into the output folder, and none is chosen yet. Please choose one."
msgstr "Το αρχείο έργου πηγαίνει στον φάκελο εξόδου, και δεν έχει επιλεγεί ακόμη κανένας. Παρακαλώ επιλέξτε έναν."

msgid "Written:\n\n  %s"
msgstr "Γράφτηκε:\n\n  %s"

msgid "Nothing was written -- there is no material yet."
msgstr "Δεν γράφτηκε τίποτα -- δεν υπάρχει υλικό ακόμη."

msgid "\nWHO ASKS -- a proposal, and nothing is set from it"
msgstr "\nΠΟΙΟΣ ΡΩΤΑΕΙ -- μια πρόταση, και τίποτα δεν ορίζεται από αυτήν"

msgid "  %-20s %s speaking, %s of %s sentences a question"
msgstr "  %-20s %s ομιλία, %s από %s προτάσεις ερώτηση"

msgid "  The order carries, the distance between them does not: measured over four episodes it never turned round, while the distance between first and last changed fourfold. It takes one voice per track; where two of them carry the same speech nothing is said at all."
msgstr "  Η σειρά κρατάει, η απόσταση μεταξύ τους όχι: μετρημένη σε τέσσερα επεισόδια δεν αντιστράφηκε ποτέ, ενώ η απόσταση πρώτου και τελευταίου άλλαξε κατά τέσσερις φορές. Προϋποθέτει μία φωνή ανά κομμάτι· όπου δύο από αυτά φέρουν την ίδια ομιλία, δεν λέγεται τίποτα."

msgid "  Who asks -- not said here: two of the tracks carry the same speech, so the questions would go to whichever recorder was turned up loudest."
msgstr "  Ποιος ρωτάει -- δεν λέγεται εδώ: δύο από τα κομμάτια φέρουν την ίδια ομιλία, οπότε οι ερωτήσεις θα πήγαιναν σε όποιο μαγνητόφωνο ήταν ανοιγμένο πιο δυνατά."

msgid "\nWHICH MICROPHONE -- a proposal, and nothing is set from it"
msgstr "\nΠΟΙΟ ΜΙΚΡΟΦΩΝΟ -- μια πρόταση, και τίποτα δεν ορίζεται από αυτήν"

msgid "  %-20s sounds like %-20s %s %% of it inside that track, %s points ahead of the next"
msgstr "  %-20s ακούγεται σαν %-20s %s %% της μέσα σε εκείνο το κομμάτι, %s μονάδες μπροστά από το επόμενο"

msgid "  It holds under one assumption: one microphone per person, and each of them carrying only that person. Where the tracks overlap too much to be told apart, or two voices point at the same microphone, nothing is said at all rather than something uncertain."
msgstr "  Ισχύει υπό μία προϋπόθεση: ένα μικρόφωνο ανά άτομο, και καθένα να φέρει μόνο εκείνο το άτομο. Όπου τα κομμάτια επικαλύπτονται τόσο που δεν ξεχωρίζουν, ή δύο φωνές δείχνουν το ίδιο μικρόφωνο, καλύτερα να μη λέγεται τίποτα παρά κάτι αβέβαιο."

msgid "\nWHAT THE VOICES COULD BE CALLED -- a proposal"
msgstr "\nΠΩΣ ΘΑ ΜΠΟΡΟΥΣΑΝ ΝΑ ΛΕΓΟΝΤΑΙ ΟΙ ΦΩΝΕΣ -- μια πρόταση"

msgid "  %-20s could be called %s"
msgstr "  %-20s θα μπορούσε να λέγεται %s"

msgid "  %s hardly speaks inside the time window -- proposed: do not use."
msgstr "  %s σχεδόν δεν μιλάει μέσα στο χρονικό παράθυρο -- πρόταση: να μη χρησιμοποιηθεί."

msgid "Guest"
msgstr "Καλεσμένος"

msgid "Host"
msgstr "Παρουσιαστής"

msgid "Host %d"
msgstr "Παρουσιαστής %d"

msgid "  Only for voices still carrying the name the program gave them; one somebody typed is never touched. The roles are read off who asks and who answers, which holds for a conversation with one guest and is a proposal, not a setting."
msgstr "  Μόνο για φωνές που φέρουν ακόμη το όνομα που τους έδωσε το πρόγραμμα· ένα που πληκτρολόγησε κάποιος δεν αγγίζεται ποτέ. Οι ρόλοι διαβάζονται από το ποιος ρωτάει και ποιος απαντά, κάτι που ισχύει για συζήτηση με έναν καλεσμένο και είναι πρόταση, όχι ρύθμιση."

msgid "Skip this version"
msgstr "Παράλειψη αυτής της έκδοσης"

msgid "Only this one. The next release asks again, and Help > Look for a newer version now asks at any time."
msgstr "Μόνο αυτή. Η επόμενη έκδοση ρωτά ξανά, και το Βοήθεια > Αναζήτηση νεότερης έκδοσης τώρα ρωτά ανά πάσα στιγμή."

msgid "  %s is there already -- not fetched twice"
msgstr "  Το %s υπάρχει ήδη -- δεν λαμβάνεται δύο φορές"

msgid "The text for %s could not be fetched."
msgstr "Το κείμενο για την %s δεν ήταν δυνατό να ληφθεί."

msgid "  Check:           one of the two tracks is not in the written file, so nothing was measured."
msgstr "  Έλεγχος:         ένα από τα δύο κομμάτια δεν είναι στο γραμμένο αρχείο, οπότε δεν μετρήθηκε τίποτα."

msgid "  Check:           the two tracks cannot be compared (match %s, %s is the floor). This says nothing about the timing."
msgstr "  Έλεγχος:         τα δύο κομμάτια δεν συγκρίνονται (ταύτιση %s, το κατώφλι είναι %s). Αυτό δεν λέει τίποτα για τον χρονισμό."

msgid "Project found"
msgstr "Βρέθηκε έργο"

msgid "Open the project"
msgstr "Άνοιγμα του έργου"

msgid "Everything comes back from it: names, separation, assignment, types, the time window. The list of files is replaced by the one the project holds."
msgstr "Όλα επανέρχονται από αυτό: ονόματα, διαχωρισμός, αντιστοίχιση, τύποι, το χρονικό παράθυρο. Η λίστα αρχείων αντικαθίσταται από αυτήν που περιέχει το έργο."

msgid "A project file lies with this material:\n\n  %s\n  written %s\n\n%s"
msgstr "Ένα αρχείο έργου βρίσκεται μαζί με αυτό το υλικό:\n\n  %s\n  γράφτηκε %s\n\n%s"

msgid "Several project files lie with this material. Which one?\n\n%s"
msgstr "Πολλά αρχεία έργου βρίσκονται μαζί με αυτό το υλικό. Ποιο από αυτά;\n\n%s"

msgid "PROJECT OPENED\n  All entries are back, nothing has been computed in this session.\n  The output folder holds the files of the last run:\n  %s\n\n  Three ways from here:\n    • below \"Open result folder\" -- look at the files from that run,\n    • below \"Create Resolve project\" -- from that run's handover file,\n      without computing anything again,\n    • above \"Start\" -- compute everything again and overwrite the files.\n"
msgstr "ΤΟ ΕΡΓΟ ΑΝΟΙΧΤΗΚΕ\n  Όλες οι καταχωρίσεις επανήλθαν, τίποτα δεν υπολογίστηκε σε αυτήν τη συνεδρία.\n  Ο φάκελος εξόδου περιέχει τα αρχεία της τελευταίας εκτέλεσης:\n  %s\n\n  Τρεις δρόμοι από εδώ:\n    • κάτω «Άνοιγμα φακέλου αποτελεσμάτων» -- δείτε τα αρχεία εκείνης της εκτέλεσης,\n    • κάτω «Δημιουργία έργου Resolve» -- από το αρχείο παράδοσης εκείνης της εκτέλεσης,\n      χωρίς να υπολογιστεί τίποτα ξανά,\n    • πάνω «Έναρξη» -- υπολογισμός όλων ξανά και αντικατάσταση των αρχείων.\n"

msgid "PROJECT SAVED\n  %s\n  This run can be opened again later -- top left\n  \"Open project ...\"\n\n"
msgstr "ΤΟ ΕΡΓΟ ΑΠΟΘΗΚΕΥΤΗΚΕ\n  %s\n  Αυτή η εκτέλεση μπορεί να ανοιχτεί ξανά αργότερα -- πάνω αριστερά\n  «Άνοιγμα έργου ...»\n\n"

msgid "Presets could not be loaded: %s"
msgstr "Δεν ήταν δυνατή η φόρτωση των προρυθμίσεων: %s"

msgid "Several cameras but no audio file. Each camera would have its own audio --\nthat is what --multitrack is for. Otherwise one camera after another."
msgstr "Πολλές κάμερες, αλλά κανένα αρχείο ήχου. Κάθε κάμερα θα είχε δικό της ήχο --\nγι' αυτό υπάρχει το --multitrack. Αλλιώς, μία κάμερα μετά την άλλη."

msgid "The file is NOT recognised as HDR."
msgstr "Το αρχείο ΔΕΝ αναγνωρίζεται ως HDR."

msgid "The file is tagged as HDR."
msgstr "Το αρχείο είναι επισημασμένο ως HDR."

