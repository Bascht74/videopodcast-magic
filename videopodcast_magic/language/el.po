msgid "  %s shots, %s s in total, without their audio."
msgstr "  Πλάνα: %s, %s δ. συνολικά, χωρίς τον ήχο τους."

msgid "  %s video tracks, %s audio tracks created (%s)"
msgstr "  Δημιουργήθηκαν -- κομμάτια βίντεο: %s, κομμάτια ήχου: %s (%s)"

msgid "  %s gets %s tracks mixed together: %s"
msgstr "  %s παίρνει %s κομμάτια μιξαρισμένα μαζί: %s"

msgid "  Audio track %d:   %s"
msgstr "  Κομμάτι ήχου %d:     %s"

msgid "  Camera atoms:    %s added -- %s"
msgstr "  Άτομα κάμερας:      %s προστέθηκαν -- %s"

msgid "    %s: %s at the front and %s at the back have no picture and are left out"
msgstr "    %s: %s στην αρχή και %s στο τέλος δεν έχουν εικόνα και παραλείπονται"

msgid "    it begins with %s and ends with %s -- the stretch every camera saw"
msgstr "    αρχίζει με %s και τελειώνει με %s -- το τμήμα που είδε κάθε κάμερα"

