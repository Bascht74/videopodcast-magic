msgstr "\nΚΑΝΟΝΙΚΟΠΟΙΗΣΗ"

msgid "  No picture: the tracks are laid against each other."
msgstr "  Καμία εικόνα: τα κομμάτια τοποθετούνται το ένα ως προς το άλλο."

msgid "  --lufs does nothing here: the tracks leave as they were recorded, and the loudness is set where they are mixed."
msgstr "  --lufs δεν κάνει τίποτα εδώ: τα κομμάτια βγαίνουν όπως ηχογραφήθηκαν, και η ακουστότητα ορίζεται εκεί όπου μιξάρονται."

msgid "\nOnly one track found a place -- there is nothing left to lay it against."
msgstr "\nΜόνο ένα κομμάτι βρήκε θέση -- δεν έμεινε τίποτα για να τοποθετηθεί απέναντί του."

msgid "  Window:              %s -- everything any track heard"
msgstr "  Παράθυρο:        %s -- ό,τι άκουσε οποιοδήποτε κομμάτι"

msgid "    %s: silence for %s at the front and %s at the back"
msgstr "    %s: σιωπή για %s στην αρχή και %s στο τέλος"

msgid "\nOnly one track is left once the blocks are joined, and multitrack needs one per voice. Where two people were taken for one recording, --apart keeps a block out of it."
msgstr "\nΜόλις ενωθούν τα μπλοκ μένει μόνο ένα κομμάτι, και το Multitrack χρειάζεται ένα ανά φωνή. Όπου δύο άνθρωποι θεωρήθηκαν μία ηχογράφηση, το --apart κρατά ένα μπλοκ έξω."

msgid "RECOGNISED PLAN"
msgstr "ΑΝΑΓΝΩΡΙΣΜΕΝΟ ΣΧΕΔΙΟ"

msgid "\nNo audio track could be aligned -- there is nothing to put on the axis."
msgstr "\nΚανένα κομμάτι ήχου δεν ευθυγραμμίστηκε -- δεν υπάρχει τίποτα να μπει στον άξονα."

msgid "\nSound and picture have only %s in common, and the alignment found %s sample points in it. That is too little to place anything on."
msgstr "\nΉχος και εικόνα έχουν κοινά μόνο %s, και η ευθυγράμμιση βρήκε σε αυτά %s σημεία δειγματοληψίας. Είναι πολύ λίγα για να τοποθετηθεί κάτι πάνω τους."

msgid "  %s: %s mixed together"
msgstr "  %s: %s μιξαρισμένα μαζί"

msgid "\nNo usable video file -- without camera audio there is no common time axis."
msgstr "\nΚανένα χρησιμοποιήσιμο αρχείο βίντεο -- χωρίς ήχο κάμερας δεν υπάρχει κοινός άξονας χρόνου."

msgid "\nPREFLIGHT -- %s"
msgstr "\nΠΡΟΕΛΕΓΧΟΣ -- %s"

msgid "\nPROCESSING: %s"
msgstr "\nΕΠΕΞΕΡΓΑΣΙΑ: %s"

msgid "\nRESOLVE -- INSPECT ONLY"
msgstr "\nRESOLVE -- ΜΟΝΟ ΕΠΙΘΕΩΡΗΣΗ"

msgid "\nRESULT"
msgstr "\nΑΠΟΤΕΛΕΣΜΑ"

msgid "\nSAVING TRACKS"
msgstr "\nΑΠΟΘΗΚΕΥΣΗ ΚΟΜΜΑΤΙΩΝ"

msgid "\nStopped: %s"
msgstr "\nΔιακοπή: %s"

