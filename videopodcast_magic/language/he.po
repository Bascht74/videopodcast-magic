msgstr "  לא ניתן ליצור את קבוצת הצבע %r: %s"

msgid "  Colour:          %d/%d/%d -- primaries filled in from the matrix (source: %d)"
msgstr "  צבע:             %d/%d/%d -- צבעי היסוד הושלמו מתוך המטריצה (מקור: %d)"

msgid "  Colour:          %d/%d/%d carried over"
msgstr "  צבע:             %d/%d/%d הועבר"

msgid "  Colour:          Caution, %s in the source, %s in the new file"
msgstr "  צבע:             זהירות, במקור %s, בקובץ החדש %s"

msgid "  Cross-check:     %s from the Full-Mix, deviation %s ms (%s of %s points)%s"
msgstr "  בדיקה צולבת:     %s לפי ה-Full-Mix, סטייה %s ms (%s מתוך %s נקודות)%s"

msgid "  Cross-check:     not possible (%s)"
msgstr "  בדיקה צולבת:     לא אפשרית (%s)"

msgid "  Data tracks:     %s carried over"
msgstr "  רצועות נתונים:   %s הועברו"

msgid "  Data tracks:     %s left out -- ffmpeg cannot write it"
msgstr "  רצועות נתונים:   %s הושמטו -- ffmpeg לא יכול לכתוב אותן"

msgid "  Deleted: %s -- being rebuilt now."
msgstr "  נמחק: %s -- נבנה מחדש כעת."

msgid "  Drift over the running time: %s s = %s frames  -->  %s"
msgstr "  סחיפה לאורך זמן הריצה: %s s = %s פריימים  -->  %s"

msgid "  Existing result adopted -- nothing computed, nothing paid."
msgstr "  נעשה שימוש בתוצאה הקיימת -- לא חושב דבר, לא שולם דבר."

msgid "  Fewer than two cameras with sound -- too few for Multitrack."
msgstr "  פחות משתי מצלמות עם שמע -- מעט מדי ל-Multitrack."

msgid "  Finished mixdown requested as the yardstick (%s)"
msgstr "  מיקס סופי מוגמר התבקש כאמת מידה (%s)"

msgid "does not start where the block before it ends"
msgstr "אינו מתחיל היכן שהמקטע הקודם מסתיים"

msgid "ends before the next block starts"
msgstr "מסתיים לפני שהמקטע הבא מתחיל"

msgid "  auphonic.com folded them. The mix keeps the two channels; what is gone is the\n  difference between the two microphones of that track."
msgstr "  auphonic.com מיזג אותם. המיקס שומר על שני הערוצים; מה שאבד הוא\n  ההבדל בין שני המיקרופונים של אותה רצועה."

msgid "  Two channels, because one track is stereo"
msgstr "  שני ערוצים, כי רצועה אחת היא סטריאו"

msgid "  Gap of %s at %s -- filled with silence"
msgstr "  פער של %s ב-%s -- מולא בשקט"

msgid "  Overlap of %s at %s -- both sound there"
msgstr "  חפיפה של %s ב-%s -- שם שניהם נשמעים"

msgid "  They overlap -- several microphones at once, not blocks in a row."
msgstr "  הם חופפים -- כמה מיקרופונים בו-זמנית, לא מקטעים ברצף."

msgid "  Each one also goes into the video as a track of its own: %s"
msgstr "  כל אחד נכנס גם לווידאו כרצועה נפרדת: %s"

msgid "  Only the mix goes into the video (--no-single-tracks)."
msgstr "  רק המיקס נכנס לווידאו (--no-single-tracks)."

msgid "  It already exists, with the same cameras in the same order -- it stays\n  untouched. Whoever wants a new one deletes it in Resolve."
msgstr "  הוא כבר קיים, עם אותן מצלמות באותו סדר -- הוא נשאר\n  ללא שינוי. כדי לקבל חדש, יש למחוק אותו ב-Resolve."

msgid "  Key frames of %s cannot be read (%s) -- the copy starts at the beginning of the file."
msgstr "  לא ניתן לקרוא את פריימי המפתח של %s (%s) -- ההעתקה מתחילה בתחילת הקובץ."

msgid "  Level curve not possible (%s) -- without limiter"
msgstr "  עקומת רמות אינה אפשרית (%s) -- ללא מגביל"

msgid "  Limiter:           at most %s dB, the same curve on every track%s"
msgstr "  מגביל:             לכל היותר %s dB, אותה עקומה בכל רצועה%s"

msgid "  Loudness not measurable: %s"
msgstr "  העוצמה הנתפסת אינה ניתנת למדידה: %s"

msgid "  Loudness not measurable -- it stays as it is."
msgstr "  העוצמה הנתפסת אינה ניתנת למדידה -- היא נשארת כפי שהיא."

msgid "  Metrics not writable: %s"
msgstr "  לא ניתן לכתוב את המדדים: %s"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  מיקס סופי מ-auphonic.com: %s LUFS, שיא %s dBTP (%s)"

msgid "  No Full-Mix found -- the Timeline stays silent."
msgstr "  לא נמצא Full-Mix -- ה-Timeline נשאר שקט."

msgid "  No audio on the Timeline -- nothing to clean up."
msgstr "  אין שמע ב-Timeline -- אין מה לנקות."

msgid "  No cameras in the handover -- nothing to build."
msgstr "  אין מצלמות בקובץ המסירה -- אין מה לבנות."

msgid "  No clips found for colour groups."
msgstr "  לא נמצאו קליפים לקבוצות צבע."

msgid "  No cut left -- the Timeline stays empty."
msgstr "  לא נותר חיתוך -- ה-Timeline נשאר ריק."

msgid "  Not handed over: the run could not place %s, so it is no camera of this episode."
msgstr "  לא נמסר: ההרצה לא הצליחה למקם את %s, ולכן זו אינה מצלמה של הפרק הזה."

msgid "  No measured offset for %s -- placed at the start of the axis."
msgstr "  אין היסט מדוד עבור %s -- המיקום בתחילת הציר."

msgid "  Nothing was found in the sound for %s -- placed by the timecode alone."
msgstr "  לא נמצא דבר בשמע של %s -- המיקום לפי קוד הזמן בלבד."

msgid "  %s: the measurement puts it at %s s, the timecode at %s s -- the measurement is used."
msgstr "  %s: לפי המדידה %s s, לפי קוד הזמן %s s -- נעשה שימוש במדידה."

msgid "  The Timeline start %s was refused: %s"
msgstr "  התחלת ה-Timeline ב-%s נדחתה: %s"

msgid "  The Timeline starts at %s, not at %s -- every shot sits that much further in."
msgstr "  ה-Timeline מתחיל ב-%s, לא ב-%s -- כל שוט מוזז באותה מידה פנימה."

msgid "  The Timeline start %s was not accepted."
msgstr "  התחלת ה-Timeline ב-%s לא התקבלה."

msgid "  Start %s -- every shot is placed against it."
msgstr "  התחלה %s -- כל שוט ממוקם ביחס אליה."

msgid "  No such Timeline existed yet -- it is only built."
msgstr "  Timeline כזה עוד לא היה קיים -- הוא רק נבנה."

msgid "  Note: this computes with the files uploaded at the time. They carry\n  the time window and the alignment of that day. Where the In point, the Out point\n  or the measured position differ now, the return check measures the\n  difference and moves the tracks into place."
msgstr "  הערה: החישוב נעשה עם הקבצים שהועלו אז. הם נושאים\n  את חלון הזמן ואת היישור של אותו יום. היכן שנקודת הכניסה, נקודת היציאה\n  או המיקום הנמדד שונים כעת, בדיקת החזרה מודדת את\n  ההפרש ומזיזה את הרצועות למקומן."

msgid "  Note: this ffmpeg has no soxr -- clock drift can only be taken out in\n  steps of 21 ppm."
msgstr "  הערה: ל-ffmpeg הזה אין soxr -- ניתן להסיר סחיפת שעון רק\n  בצעדים של 21 ppm."

msgid "  Of no consequence for the sound."
msgstr "  אין לכך השפעה על השמע."

msgid "  Offset:          %s   (from the camera comparison)"
msgstr "  היסט:            %s   (מהשוואת המצלמות)"

msgid "  Only %s of %s shots are on the Timeline."
msgstr "  רק %s מתוך %s שוטים נמצאים ב-Timeline."

msgid "  Peaks:             %s dB above %s dBTP -- the limiter catches them"
msgstr "  שיאים:             %s dB מעל %s dBTP -- המגביל תופס אותם"

msgid "  Player: %s reports an error -- %s"
msgstr "  נגן: %s מדווח על שגיאה -- %s"

msgid "  Player: %s stays at %s instead of %s -- given up after %s attempts (%s)"
msgstr "  נגן: %s -- מיקום %s במקום %s -- ויתור אחרי %s ניסיונות (%s)"

msgid "  Player: audio output switches to %s"
msgstr "  נגן: פלט השמע עובר אל %s"

msgid "  Player: the audio is not running (%s) -- one more attempt."
msgstr "  נגן: השמע לא פועל (%s) -- ניסיון נוסף."

msgid "  Please give a number between 1 and %d."
msgstr "  נא להזין מספר בין 1 ל-%d."

msgid "  Production at auphonic.com:   %s"
msgstr "  הפקה ב-auphonic.com:          %s"

msgid "  Production running (%s)"
msgstr "  ההפקה פועלת (%s)"

msgid "  Project %r opened."
msgstr "  הפרויקט %r נפתח."

msgid "  Project file could not be written: %s"
msgstr "  לא ניתן היה לכתוב את קובץ הפרויקט: %s"

msgid "  Project file not writable (%s)\n"
msgstr "  קובץ הפרויקט אינו ניתן לכתיבה (%s)\n"

msgid "  Range:             %s LU (speech is usually 3 to 7 LU)"
msgstr "  טווח:              %s LU (בדיבור בדרך כלל 3 עד 7 LU)"

msgid "  Reference: %s (%s, longest running time)"
msgstr "  ייחוס: %s (%s, זמן הריצה הארוך ביותר)"

msgid "  Remains:           %s dB on every track, that is %s LUFS instead of %s"
msgstr "  נותר:              %s dB בכל רצועה, כלומר %s LUFS במקום %s"

msgid "  Resolve took no picture at all -- the Timeline is empty. Nothing\n  else is built on it."
msgstr "  Resolve לא קיבל שום תמונה -- ה-Timeline ריק. שום דבר\n  נוסף לא נבנה עליו."

msgid "  Result: %s (%s) -- stays next to the video file\n"
msgstr "  תוצאה: %s (%s) -- נשארת ליד קובץ הווידאו\n"

msgid "  Not used:  %s."
msgstr "  לא בשימוש:  %s."

msgid "  Question: %s in the transcript, %s became a reaction cut."
msgstr "  שאלה:     %s בתמלול, %s הפכו לחיתוך תגובה."

msgid "  Question: no transcript, so no question was found and no reaction cut\n            happened. The words are written down from the finished mix during\n            the run; without them the setting does nothing."
msgstr "  שאלה:     אין תמלול, ולכן לא נמצאה שאלה ולא\n            נעשה חיתוך תגובה. המילים נכתבות מתוך המיקס המוגמר במהלך\n            ההרצה; בלעדיהן ההגדרה הזו לא עושה דבר."

msgid "  Settings brought to preset %r"
msgstr "  ההגדרות הותאמו לפריסט %r"

msgid "  Start %s (earliest camera) -- otherwise everything would lie before the Timeline start."
msgstr "  התחלה %s (המצלמה המוקדמת ביותר) -- אחרת הכול היה לפני תחילת ה-Timeline."

msgid "  Not adjusted:      taken from the source files -- no gain on any track and no\n                     limiter. The sound leaves exactly as it came in."
msgstr "  ללא התאמה:         נלקח מקובצי המקור -- ללא הגברה באף רצועה וללא\n                     מגביל. השמע יוצא בדיוק כפי שנכנס."

msgid "  Sum of tracks:     %s LUFS, peak %s dBTP%s"
msgstr "  סכום הרצועות:      %s LUFS, שיא %s dBTP%s"

msgid "  Target:            %s LUFS  ->  %s dB on every track"
msgstr "  יעד:               %s LUFS  ->  %s dB בכל רצועה"

msgid "  The Timeline gets %s: the highest of them, or the next rate Resolve\n  has above it. Converted upwards Resolve repeats frames, downwards it\n  throws them away. Every camera keeps its own rate, and the cut counts\n  in that one."
msgstr "  ה-Timeline מקבל %s: הגבוה מביניהם, או הקצב הבא ש-Resolve\n  מכיר מעליו. בהמרה כלפי מעלה Resolve חוזר על פריימים, כלפי מטה הוא\n  משליך אותם. כל מצלמה שומרת על הקצב שלה, והחיתוך סופר\n  בקצב הזה."

msgid "  The Full-Mix could not be imported."
msgstr "  לא ניתן היה לייבא את ה-Full-Mix."

msgid "  The Full-Mix could not be inserted."
msgstr "  לא ניתן היה להכניס את ה-Full-Mix."

msgid "  The cameras carry the time window and a second at each end: %s written for %s of the %s recorded."
msgstr "  המצלמות נושאות את חלון הזמן ושנייה בכל קצה: נכתבו %s עבור %s מתוך %s שהוקלטו."

msgid "  The cameras lie close together (at most %s steps of brightness)."
msgstr "  המצלמות קרובות זו לזו (לכל היותר %s דרגות בהירות)."

msgid "  The cut has changed: %s shots instead of %s."
msgstr "  החיתוך השתנה: %s שוטים במקום %s."

msgid "  The record of earlier runs here cannot be read (%s), so everything already in place is reported."
msgstr "  לא ניתן לקרוא כאן את תיעוד ההרצות הקודמות (%s), ולכן מדווח כל מה שכבר קיים."

msgid "  The cut stays as it was."
msgstr "  החיתוך נשאר כפי שהיה."

msgid "  The files are uploaded again -- this costs credit."
msgstr "  הקבצים מועלים שוב -- זה עולה קרדיט."

msgid "  The files in the folder must be named after the speakers and belong\n  to this run. Without the folder it goes through auphonic.com again."
msgstr "  הקבצים בתיקייה חייבים להיקרא בשמות הדוברים ולהשתייך\n  להרצה הזו. בלי התיקייה זה עובר שוב דרך auphonic.com."

msgid "  The media pool stays as it is."
msgstr "  ה-Media Pool נשאר כפי שהוא."

msgid "  The names from there are adopted:"
msgstr "  השמות משם אומצו:"

msgid "  There are %s tracks there and %s here -- that does not match."
msgstr "  שם יש %s רצועות וכאן %s -- זה לא תואם."

msgid "  This camera could not be placed -- skipped"
msgstr "  לא ניתן היה למקם את המצלמה הזו -- דולגה"

msgid "  Time window:     %s of %s written, from %s of the camera"
msgstr "  חלון זמן:        נכתבו %s מתוך %s, החל מ-%s של המצלמה"

msgid "  Timecode %s written as bext and iXML (reference: %s)"
msgstr "  קוד הזמן %s נכתב כ-bext ו-iXML (ייחוס: %s)"

msgid "  Too much:          the limiter would have to take %s dB away. More than %s dB\n                     sounds squashed -- %s dB less gain."
msgstr "  יותר מדי:          המגביל היה צריך להוריד %s dB. יותר מ-%s dB\n                     נשמע דחוס -- %s dB פחות הגברה."

msgid "  Transcript not possible (%s) -- it runs anyway."
msgstr "  תמלול אינו אפשרי (%s) -- ההרצה ממשיכה בכל זאת."

msgid "  Wide shot at the edges: skipped -- the first or last announcement\n  would be too long for a greeting."
msgstr "  שוט רחב בקצוות: דולג -- ההכרזה הראשונה או האחרונה\n  הייתה ארוכה מדי לברכה."

msgid "  Wide shot at the edges: until %s and from %s"
msgstr "  שוט רחב בקצוות: עד %s ומ-%s"

msgid "  from %s, %s"
msgstr "  מתוך %s, %s"

msgid "  iXML for %s not written: %s"
msgstr "  iXML עבור %s לא נכתב: %s"

msgid " at high frame rates"
msgstr " בקצבי פריימים גבוהים"

msgid "%s  Audio starts per timecode at    %s"
msgstr "%s  תחילת השמע לפי קוד הזמן:        %s"

msgid "%s  Picture starts per timecode at  %s"
msgstr "%s  תחילת התמונה לפי קוד הזמן:      %s"

msgid "%s  The audio timecode does not fit the picture at all -- probably a clock never set. The measurement is used."
msgstr "%s  קוד הזמן של השמע אינו מתאים לתמונה כלל -- כנראה שעון שמעולם לא כוון. נעשה שימוש במדידה."

msgid "%s  The timecode does not fit what is heard. The measurement is used."
msgstr "%s  קוד הזמן אינו מתאים למה שנשמע. נעשה שימוש במדידה."

msgid "%s from %s recordings"
msgstr "%s מ-%s הקלטות"

msgid "%s is missing."
msgstr "חסר: %s."

msgid "%s is on more than one speaker -- a name is a person, and every person needs their own."
msgstr "שם על יותר מדובר אחד: %s -- שם הוא אדם, ולכל אדם נדרש שם משלו."

msgid "%s stands on more than one voice. A name is a person, and the cut puts a person on one camera -- two voices of one name would be one person in two places."
msgstr "שם על יותר מקול אחד: %s. שם הוא אדם, והחיתוך מציב אדם על מצלמה אחת -- שני קולות באותו שם היו אדם אחד בשני מקומות."

msgid "  This machine can install it properly: %s"
msgstr "  המחשב הזה יכול להתקין אותו כראוי: %s"

msgid "  Installing it: %s"
msgstr "  התקנה: %s"

msgid "  On this machine: %s"
msgstr "  במחשב הזה: %s"

msgid "  Installing it: pip install %s"
msgstr "  התקנה: pip install %s"

msgid "  %s would be installed into this Python: %s"
msgstr "  %s יותקן ב-Python הזה: %s"

msgid "  By hand:  %s -m pip install %s"
msgstr "  ידנית:  %s -m pip install %s"

msgid "Could not look for a newer version: %s"
msgstr "לא ניתן היה לחפש גרסה חדשה יותר: %s"

