msgstr "        רצועה %d: %s"

msgid "      %-24s no file in the media pool"
msgstr "      %-24s אין קובץ ב-Media Pool"

msgid "      GetAudioMapping   empty (%r)"
msgstr "      GetAudioMapping   ריק (%r)"

msgid "    %-10s from %s, %s long%s"
msgstr "    %-10s מ-%s, באורך %s%s"

msgid "    %-14s <-> %-14s sound path %4s ms (%s m), offset %6s ms, drift %5s ppm (%s points, %s ms left over)%s"
msgstr "    %-14s <-> %-14s מסלול הצליל %4s ms (%s m), היסט %6s ms, סחיפה %5s ppm (%s נקודות, %s ms שארית)%s"

msgid "    %-20s <- nothing suitable found"
msgstr "    %-20s <- לא נמצא דבר מתאים"

msgid "    Careful: %s. There is no picture there;"
msgstr "    זהירות: %s. אין שם תמונה;"

