msgstr "    לא נמצאו קליפים."

msgid "    No matching codec found. Available: %s"
msgstr "    לא נמצא קודק מתאים. זמינים: %s"

msgid "    Render settings rejected."
msgstr "    הגדרות הרינדור נדחו."

msgid "    the measured window is therefore kept."
msgstr "    לכן נשמר חלון הזמן שנמדד."

msgid "  %s shots, %s s in total, without their audio."
msgstr "  %s שוטים, %s s בסך הכול, ללא השמע שלהם."

msgid "  %s video tracks, %s audio tracks created (%s)"
msgstr "  נוצרו %s רצועות וידאו, %s רצועות שמע (%s)"

msgid "  %s gets %s tracks mixed together: %s"
msgstr "  ל-%s ממוקסות יחד %s רצועות: %s"

msgid "  Audio track %d:   %s"
msgstr "  רצועת שמע %d:     %s"

msgid "  Camera atoms:    %s added -- %s"
msgstr "  אטומי מצלמה:     נוספו %s -- %s"

msgid "    %s: %s at the front and %s at the back have no picture and are left out"
msgstr "    %s: ל-%s בהתחלה ול-%s בסוף אין תמונה, והם מושמטים"

msgid "    it begins with %s and ends with %s -- the stretch every camera saw"
msgstr "    הוא מתחיל ב-%s ומסתיים ב-%s -- הקטע שכל מצלמה ראתה"

msgid "\nStopping. The run ends as soon as it can do so without leaving a file half written -- one moment.\n"
