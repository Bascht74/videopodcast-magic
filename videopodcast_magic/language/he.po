msgstr "  כל קובצי הפלט הדרושים כבר קיימים."

msgid "  Atom %s skipped: %s bytes are too much for it."
msgstr "  האטום %s דולג: %s בתים הם יותר מדי עבורו."

msgid "  Audio: Full-Mix in one piece on A1 (%s)."
msgstr "  שמע: Full-Mix ברצף אחד על A1 (%s)."

msgid "  Caution: %s steps of brightness difference -- visible when switching."
msgstr "  זהירות: הפרש בהירות של %s דרגות -- נראה בעת המעבר בין מצלמות."

msgid "  Caution: %s and %s are both called %s. On the Timeline\n  Resolve reports only the name, so their clips cannot be told\n  apart -- rename one of the two files."
msgstr "  זהירות: %s ו-%s נקראים שניהם %s. ב-Timeline\n  Resolve מציין רק את השם, ולכן אי אפשר להבחין בין\n  הקליפים שלהם -- יש לשנות את השם של אחד משני הקבצים."

msgid "  Caution: %s could not be deleted -- the new Timeline therefore gets\n  an addition to its name."
msgstr "  זהירות: לא ניתן היה למחוק את %s -- לכן ה-Timeline החדש מקבל\n  תוספת לשמו."

msgid "  Caution: range      only %s LU -- very tight. Speech is usually 3 to 7 LU;\n                     below that it sounds squashed. Check how strongly the leveler\n                     is set at auphonic.com."
msgstr "  זהירות: טווח       רק %s LU -- צר מאוד. בדיבור בדרך כלל 3 עד 7 LU;\n                     מתחת לזה הצליל נשמע דחוס. יש לבדוק כמה חזק מוגדר ה-Leveler\n                     ב-auphonic.com."

msgid "  Caution: the production holds further tracks (%s). They go into the\n  mix -- please delete them at auphonic.com."
msgstr "  זהירות: בהפקה יש רצועות נוספות (%s). הן נכנסות\n  למיקס -- נא למחוק אותן ב-auphonic.com."

msgid "  Caution: track %s -- it keeps its settings."
msgstr "  זהירות: רצועה %s -- ההגדרות שלה נשמרות."

msgid "  Camera atoms:    cannot be added (%s)"
msgstr "  אטומי מצלמה:     לא ניתן להוסיף (%s)"

msgid "  Camera data:     %s keys carried over (%s)"
msgstr "  נתוני מצלמה:     הועברו %s מפתחות (%s)"

msgid "  Camera data:     Caution, %s of %s keys are missing in the new file: %s"
msgstr "  נתוני מצלמה:     זהירות, %s מתוך %s מפתחות חסרים בקובץ החדש: %s"

msgid "  Camera data:     the source carries none"
msgstr "  נתוני מצלמה:     במקור אין כאלה"

msgid "  Cannot add atoms: a 64 bit box is in the way."
msgstr "  לא ניתן להוסיף אטומים: תיבת 64 ביט חוסמת את הדרך."

msgid "  Cannot add atoms: moov is not at the end."
msgstr "  לא ניתן להוסיף אטומים: moov אינו בסוף."

msgid "  Cannot add atoms: the source is %s, the target %s."
msgstr "  לא ניתן להוסיף אטומים: המקור הוא %s, היעד %s."

msgid "  Check:           not possible (%s)"
msgstr "  בדיקה:           לא אפשרית (%s)"

msgid "  Clock drift:     %s ppm (+/- %s), residual spread %s ms, %s of %s points"
msgstr "  סחיפת שעון:      %s ppm (+/- %s), פיזור שיורי %s ms, %s מתוך %s נקודות"

msgid "  Clock drift:     nothing measured -- this is the reference the others are held against"
msgstr "  סחיפת שעון:      לא נמדד דבר -- זה הייחוס שמולו נמדדים האחרים"

msgid "  Colour comparison not possible: %s"
msgstr "  השוואת צבעים אינה אפשרית: %s"

