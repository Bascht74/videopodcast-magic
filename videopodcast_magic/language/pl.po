msgstr "Przy tym materiale leży plik projektu:\n\n  %s\n  zapisany %s\n\n%s"

msgid "Several project files lie with this material. Which one?\n\n%s"
msgstr "Przy tym materiale leży kilka plików projektu. Który?\n\n%s"

