msgstr[0] " -- %s ਫ਼ਾਈਲ ਬਾਕੀਆਂ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀ"
msgstr[1] " -- %s ਫ਼ਾਈਲਾਂ ਬਾਕੀਆਂ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀਆਂ"

msgid "Cameras"
msgstr "ਕੈਮਰੇ"

msgid "%s have the same size and running time -- possibly one recording twice."
msgstr "ਇੱਕੋ ਆਕਾਰ ਅਤੇ ਚੱਲਣ-ਸਮਾਂ: %s -- ਸ਼ਾਇਦ ਇੱਕੋ ਰਿਕਾਰਡਿੰਗ ਦੋ ਵਾਰ।"

msgid "ffprobe no longer opens the file"
msgstr "ffprobe ਹੁਣ ਫ਼ਾਈਲ ਨਹੀਂ ਖੋਲ੍ਹਦਾ"

msgid "ffmpeg and ffprobe are missing."
msgstr "ਮੌਜੂਦ ਨਹੀਂ: ffmpeg ਅਤੇ ffprobe।"

msgid "  %s holds a separation of a recording that has changed or gone since, or of another model -- it is not used."
msgstr "  %s ਵਿੱਚ ਅਜਿਹੀ ਰਿਕਾਰਡਿੰਗ ਦਾ ਬੁਲਾਰਾ-ਨਿਖੇੜਾ ਹੈ ਜੋ ਉਦੋਂ ਤੋਂ ਬਦਲ ਗਈ ਹੈ ਜਾਂ ਹੁਣ ਮੌਜੂਦ ਨਹੀਂ, ਜਾਂ ਕਿਸੇ ਹੋਰ ਮਾਡਲ ਦਾ -- ਇਹ ਵਰਤਿਆ ਨਹੀਂ ਜਾਂਦਾ।"

