msgstr "\nਕੋਈ ਪ੍ਰੀਸੈੱਟ ਨਹੀਂ ਚੁਣਿਆ ਗਿਆ: %s"

msgid "\nStopped before the first long step. With --anyway it runs regardless."
msgstr "\nਪਹਿਲੇ ਲੰਮੇ ਕਦਮ ਤੋਂ ਪਹਿਲਾਂ ਰੋਕਿਆ ਗਿਆ। --anyway ਨਾਲ ਇਹ ਫਿਰ ਵੀ ਚੱਲਦਾ ਹੈ।"

msgid "                   Resolve may then not recognise the input colour space."
msgstr "                   ਤਦ Resolve ਸ਼ਾਇਦ ਇਨਪੁੱਟ ਕਲਰ ਸਪੇਸ ਨਾ ਪਛਾਣੇ।"

msgid "               Audio %s at %s -- there it meets the %s word."
msgstr "               ਆਡੀਓ: %s %s 'ਤੇ -- ਉੱਥੇ ਇਹ %s ਸ਼ਬਦ ਨਾਲ ਮਿਲਦਾ ਹੈ।"

msgid "      %-24s track V%d, from frame %d (%s s to the start), %s%s"
msgstr "      %-24s ਟਰੈਕ V%d, ਫ਼ਰੇਮ %d ਤੋਂ (ਸ਼ੁਰੂਆਤ ਤੱਕ %s s), %s%s"

msgid "      Both clips stay uncut; they overlap the content.\n      The dissolve sits in the overlap -- exactly where is your decision in Resolve.\n      (The Resolve scripting interface cannot create transitions.)"
msgstr "      ਦੋਵੇਂ ਕਲਿੱਪਾਂ ਬਿਨਾਂ ਕੱਟੇ ਰਹਿੰਦੀਆਂ ਹਨ; ਉਹ ਸਮੱਗਰੀ ਨਾਲ ਓਵਰਲੈਪ ਕਰਦੀਆਂ ਹਨ।\n      ਡਿਜ਼ੌਲਵ ਇਸ ਓਵਰਲੈਪ ਵਿੱਚ ਹੈ -- ਠੀਕ ਕਿੱਥੇ, ਇਹ Resolve ਵਿੱਚ ਤੁਹਾਡਾ ਫ਼ੈਸਲਾ ਹੈ।\n      (Resolve ਦਾ ਸਕ੍ਰਿਪਟਿੰਗ ਇੰਟਰਫ਼ੇਸ ਟ੍ਰਾਂਜ਼ਿਸ਼ਨ ਨਹੀਂ ਬਣਾ ਸਕਦਾ।)"

msgid "      GetAudioMapping   fails: %s"
msgstr "      GetAudioMapping   ਅਸਫਲ: %s"

msgid "      WARNING: weak match for %s (%s, %s is the floor). The two may not belong together."
msgstr "      ਚੇਤਾਵਨੀ: ਕਮਜ਼ੋਰ ਮੇਲ: %s (%s, ਹੇਠਲੀ ਹੱਦ %s ਹੈ)। ਹੋ ਸਕਦਾ ਹੈ ਇਹ ਦੋਵੇਂ ਇੱਕ-ਦੂਜੇ ਦੇ ਨਾ ਹੋਣ।"

msgid "this pair of files"
msgstr "ਫ਼ਾਈਲਾਂ ਦਾ ਇਹ ਜੋੜਾ"

msgid "    %-20s %s ms / %s ppm -- that cannot be right, track\n    %-20s stays where it is."
msgstr "    %-20s %s ms / %s ppm -- ਇਹ ਠੀਕ ਨਹੀਂ ਹੋ ਸਕਦਾ, ਟਰੈਕ\n    %-20s ਜਿੱਥੇ ਹੈ ਉੱਥੇ ਹੀ ਰਹਿੰਦਾ ਹੈ।"

msgid "    %-20s <- %s  (%s, name similarity %s)"
msgstr "    %-20s <- %s  (%s, ਨਾਂ ਦੀ ਸਮਾਨਤਾ %s)"

msgid "    %-20s <- %s  (%s, trimmed to the time window, name similarity %s)"
msgstr "    %-20s <- %s  (%s, ਸਮਾਂ-ਦਾਇਰੇ ਤੱਕ ਛਾਂਟਿਆ, ਨਾਂ ਦੀ ਸਮਾਨਤਾ %s)"

msgid "    %-20s <- %s  BUT %s -- neither the time window (%s) nor the\n    %-20s    whole measured range (%s). This belongs to another run."
msgstr "    %-20s <- %s  ਪਰ %s -- ਨਾ ਸਮਾਂ-ਦਾਇਰਾ (%s) ਅਤੇ ਨਾ ਹੀ\n    %-20s    ਪੂਰੀ ਮਾਪੀ ਗਈ ਰੇਂਜ (%s)। ਇਹ ਕਿਸੇ ਹੋਰ ਰਨ ਦਾ ਹੈ।"

msgid "    %-20s no file with a matching name"
msgstr "    %-20s ਮਿਲਦੇ ਨਾਂ ਵਾਲੀ ਕੋਈ ਫ਼ਾਈਲ ਨਹੀਂ"

msgid "    %-20s shifted by %s ms%s"
msgstr "    %-20s %s ms ਖਿਸਕਾਇਆ ਗਿਆ%s"

msgid "    %-22s %s exists already -- rendered to %s instead, so the\n%searlier delivery stays."
msgstr "    %-22s %s ਪਹਿਲਾਂ ਹੀ ਮੌਜੂਦ ਹੈ -- ਇਸ ਦੀ ਬਜਾਏ %s ਵਿੱਚ ਰੈਂਡਰ ਕੀਤਾ, ਤਾਂ ਜੋ\n%sਪਿਛਲੀ ਡਿਲੀਵਰੀ ਬਣੀ ਰਹੇ।"

msgid "    %-22s %s kbit/s  (YouTube recommendation for %s%s)"
msgstr "    %-22s %s kbit/s  (%s%s ਲਈ YouTube ਦੀ ਸਿਫ਼ਾਰਸ਼)"

msgid "    %-22s AAC, %s kHz, two channel  (bitrate cannot be set remotely --\n%s%s kbit/s are the recommendation for stereo)"
msgstr "    %-22s AAC, %s kHz, ਦੋ ਚੈਨਲ  (ਬਿਟਰੇਟ ਦੂਰੋਂ ਸੈੱਟ ਨਹੀਂ ਹੋ ਸਕਦਾ --\n%s%s kbit/s ਸਟੀਰੀਓ ਲਈ ਸਿਫ਼ਾਰਸ਼ ਹੈ)"

msgid "    %-22s rejected -- no spelling was accepted.\n%sSet by hand in Resolve under Deliver > Advanced\n%sSettings: Color space tag Rec.2020, Gamma tag %s."
msgstr "    %-22s ਰੱਦ -- ਕੋਈ ਵੀ ਲਿਖਤ-ਰੂਪ ਸਵੀਕਾਰ ਨਹੀਂ ਹੋਇਆ।\n%sResolve ਵਿੱਚ Deliver > Advanced Settings ਹੇਠ ਹੱਥ ਨਾਲ\n%sਸੈੱਟ ਕਰੋ: Color space tag Rec.2020, Gamma tag %s।"

msgid "    %-22s stays at \"Same as Project\" -- the project names\n%sno HDR curve. To check in Resolve under\n%sProject Settings > Color Management > Output Color Space."
msgstr "    %-22s \"Same as Project\" 'ਤੇ ਰਹਿੰਦਾ ਹੈ -- ਪ੍ਰੋਜੈਕਟ ਕੋਈ\n%sHDR ਕਰਵ ਨਹੀਂ ਦੱਸਦਾ। Resolve ਵਿੱਚ ਇੱਥੇ ਜਾਂਚੋ:\n%sProject Settings > Color Management > Output Color Space।"

msgid "    %-24s Deleting failed."
msgstr "    %-24s ਮਿਟਾਉਣਾ ਅਸਫਲ ਰਿਹਾ।"

msgid "    %-24s Deleting failed: %s"
msgstr "    %-24s ਮਿਟਾਉਣਾ ਅਸਫਲ ਰਿਹਾ: %s"

msgid "    %-24s Linking failed: %s"
msgstr "    %-24s ਲਿੰਕ ਕਰਨਾ ਅਸਫਲ ਰਿਹਾ: %s"

msgid "    %-24s Unlinking had no effect -- the surplus audio tracks\n    %-24s stay in place."
msgstr "    %-24s ਅਨਲਿੰਕ ਕਰਨ ਦਾ ਕੋਈ ਅਸਰ ਨਹੀਂ ਹੋਇਆ -- ਵਾਧੂ ਆਡੀਓ ਟਰੈਕ\n    %-24s ਆਪਣੀ ਥਾਂ ਰਹਿੰਦੇ ਹਨ।"

msgid "    %-24s audio from A%d kept, %d more deleted"
msgstr "    %-24s A%d ਤੋਂ ਆਡੀਓ ਰੱਖਿਆ, %d ਹੋਰ ਮਿਟਾਏ"

