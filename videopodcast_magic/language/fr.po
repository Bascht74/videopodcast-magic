msgstr "  Contre-épreuve :     %s d’après le Full-Mix, écart %s ms (%s points sur %s)%s"

msgid "  Cross-check:     not possible (%s)"
msgstr "  Contre-épreuve :     impossible (%s)"

msgid "  Data tracks:     %s carried over"
msgstr "  Pistes de données :  %s reprises"

