msgstr "  اللون:           %d/%d/%d -- الألوان الأساسية مُكمَّلة من المصفوفة (المصدر: %d)"

msgid "  Colour:          %d/%d/%d carried over"
msgstr "  اللون:           %d/%d/%d نُقل"

