msgstr "فجوة بطول %s حسب الكود الزمني، متباعدة جدًا لتسجيل واحد"

msgid "already in another recording"
msgstr "موجود بالفعل في تسجيل آخر"

msgid "  Number: "
msgstr "  الرقم: "

msgid "  -->  aligned, clock drift %s ppm taken out"
msgstr "  -->  تمت المحاذاة، أُزيل انحراف الساعة %s ppm"

msgid "   Caution: measurement unusable"
msgstr "   تنبيه: القياس غير صالح"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  المزيج النهائي من auphonic.com: %s LUFS، الذروة %s dBTP (%s)"

msgid "  Range:             %s LU (speech is usually 3 to 7 LU)"
msgstr "  النطاق:            %s LU (الكلام عادةً من 3 إلى 7 LU)"

msgid "  Level curve not possible (%s) -- without limiter"
msgstr "  منحنى المستوى غير ممكن (%s) -- بدون محدِّد"

msgid "does not start where the block before it ends"
msgstr "لا تبدأ حيث تنتهي الكتلة التي قبلها"

msgid "ends before the next block starts"
msgstr "تنتهي قبل أن تبدأ الكتلة التالية"

msgid "  Key frames of %s cannot be read (%s) -- the copy starts at the beginning of the file."
msgstr "  لا يمكن قراءة الإطارات المفتاحية لـ %s (%s) -- تبدأ النسخة من بداية الملف."

msgid "  %-20s not measurable: %s"
msgstr "  %-20s غير قابل للقياس: %s"

msgid " (fine: %s ms)"
msgstr " (دقيق: %s مللي ث)"

msgid ", range %s LU"
msgstr "، النطاق %s LU"

msgid " (auphonic.com takes the same amount)"
msgstr " (يأخذ auphonic.com القدر نفسه)"

msgid "  Caution: range      only %s LU -- very tight. Speech is usually 3 to 7 LU;\n                     below that it sounds squashed. Check how strongly the leveler\n                     is set at auphonic.com."
msgstr "  تنبيه: النطاق      %s LU فقط -- ضيق جدًا. الكلام عادةً من 3 إلى 7 LU؛\n                     وما دون ذلك يبدو مضغوطًا. تحقق من شدة ضبط الـ leveler\n                     في auphonic.com."

msgid "both channels identical -- mono laid on both sides"
msgstr "القناتان متطابقتان -- أحادي موضوع على الجانبين"

msgid "probably two microphones -- about %s m apart%s"
msgstr "على الأرجح ميكروفونان -- بينهما نحو %s م%s"

msgid "not recognisable -- only %s of %s places where both channels carry sound, %s needed"
msgstr "غير قابل للتعرف -- فقط %s من %s موضعًا تحمل فيه القناتان صوتًا، والمطلوب %s"

msgid "not recognisable -- these two agree no better than each does with the channel beside it"
msgstr "غير قابل للتعرف -- هاتان لا تتفقان أفضل مما تتفق كل منهما مع القناة المجاورة لها"

msgid "probably one stereo track -- both microphones in the same place"
msgstr "على الأرجح مسار ستيريو واحد -- الميكروفونان في المكان نفسه"

msgid "                   Resolve may then not recognise the input colour space."
msgstr "                   قد لا يتعرف Resolve عندها على فضاء ألوان الإدخال."

msgid "  Camera data:     the source carries none"
msgstr "  بيانات الكاميرا: المصدر لا يحمل أيًا منها"

msgid "boxes no longer readable"
msgstr "لم تعد الصناديق قابلة للقراءة"

msgid "moov is no longer in its place"
msgstr "moov لم يعد في مكانه"

msgid "moov no longer ends at the end of the file"
msgstr "moov لم يعد ينتهي عند نهاية الملف"

msgid "the media data is no longer where it was"
msgstr "بيانات الوسائط لم تعد حيث كانت"

