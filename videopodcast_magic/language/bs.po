msgstr "nije potrebno uz HLG"

msgid "not readable (%s) -- unchecked."
msgstr "nečitljivo (%s) -- neprovjereno."

msgid "not readable: %s"
msgstr "nečitljivo: %s"

msgid "nothing loaded yet"
msgstr "još ništa nije učitano"

msgid "nothing selected"
msgstr "ništa nije odabrano"

msgid "off"
msgstr "isključeno"

msgid "one Timeline"
msgstr "jedan Timeline"

msgid "only %s long, the longest recording has %s."
msgstr "samo %s dugo, najduži snimak ima %s."

msgid "overlap of %s per timecode"
msgstr "preklapanje od %s po vremenskom kodu"

msgid "per track"
msgstr "po traci"

msgid "preset does not fit the run"
msgstr "predefinirana postavka ne odgovara prolazu"

msgid "previous block is shorter than the rest"
msgstr "prethodni blok kraći je od ostalih"

msgid "processed tracks found -- nothing is uploaded"
msgstr "pronađene obrađene trake -- ništa se ne prenosi"

msgid "production finished, but no output file"
msgstr "produkcija završena, ali nema izlazne datoteke"

msgid "recompute with the chosen preset -- the files stay\n       where they are, costs no credit"
msgstr "ponovo izračunati s odabranom predefiniranom postavkom -- datoteke\n       ostaju gdje jesu, ne troši kredit"

msgid "reset"
msgstr "poništi"

msgid "running ..."
msgstr "u toku ..."

msgid "selected"
msgstr "odabrano"

msgid "shorter shots are merged in"
msgstr "kraći kadrovi se stapaju"

msgid "stays out"
msgstr "ostaje izostavljena"

msgid "stored file %s"
msgstr "sačuvana datoteka %s"

msgid "take the existing result (nothing computed, nothing paid)"
msgstr "preuzeti postojeći rezultat (ništa se ne računa, ništa se ne plaća)"

msgid "take the names from there and carry on with them --\n       no upload, costs nothing"
msgstr "preuzeti nazive odande i nastaviti s njima --\n       ništa se ne prenosi, ne košta ništa"

msgid "the Multitrack preset has no track stored."
msgstr "predefinirana postavka Multitrack nema sačuvanu nijednu traku."

msgid "the finished mixdown"
msgstr "gotov mixdown"

msgid "the individual tracks"
msgstr "pojedinačne trake"

msgid "the individual tracks, packed"
msgstr "pojedinačne trake, zapakirane"

msgid "the media data is no longer where it was"
msgstr "medijski podaci više nisu ondje gdje su bili"

msgid "the mix of all tracks"
msgstr "miks svih traka"

msgid "the mixdown as the yardstick"
msgstr "mixdown kao mjerilo"

msgid "the old moov is back in place"
msgstr "stari moov vraćen je na mjesto"

msgid "the picture changes this much later than the sound"
msgstr "za toliko kasnije od zvuka mijenja se slika"

msgid "the preset masters to %s LUFS, the calculation uses %s."
msgstr "predefinirana postavka masterira na %s LUFS, izračun koristi %s."

msgid "the preset masters to %s LUFS -- that stands, nothing of ours adjusts."
msgstr "predefinirana postavka masterira na %s LUFS -- to vrijedi, s naše strane ništa se ne prilagođava."

msgid "taken from the source files, no --lufs given -- nothing is adjusted"
msgstr "preuzeto iz izvornih datoteka, --lufs nije zadan -- ništa se ne prilagođava"

msgid "the answer did not keep the floor"
msgstr "odgovor nije zadržao riječ"

msgid "the main speaker asked"
