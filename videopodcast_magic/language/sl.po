msgstr "prednastavitev se ne ujema z zagonom"

msgid "previous block is shorter than the rest"
msgstr "prejšnji blok je krajši od ostalih"

msgid "processed tracks found -- nothing is uploaded"
msgstr "najdene so obdelane sledi -- nič se ne naloži"

msgid "production finished, but no output file"
msgstr "produkcija je končana, a ni izhodne datoteke"

msgid "recompute with the chosen preset -- the files stay\n       where they are, costs no credit"
msgstr "znova izračunaj z izbrano prednastavitvijo -- datoteke ostanejo\n       kjer so, ne stane dobroimetja"

msgid "reset"
msgstr "ponastavi"

msgid "running ..."
msgstr "teče ..."

