msgstr "izbrano"

msgid "shorter shots are merged in"
msgstr "krajši kadri se združijo"

msgid "stays out"
msgstr "ostane zunaj"

msgid "stored file %s"
msgstr "shranjena datoteka %s"

msgid "take the existing result (nothing computed, nothing paid)"
msgstr "prevzemi obstoječi rezultat (nič se ne računa, nič se ne plača)"

msgid "take the names from there and carry on with them --\n       no upload, costs nothing"
msgstr "prevzemi imena od tam in nadaljuj z njimi --\n       brez nalaganja, nič ne stane"

msgid "the Multitrack preset has no track stored."
msgstr "prednastavitev Multitrack nima shranjene sledi."

msgid "the finished mixdown"
msgstr "končni miks"

msgid "the individual tracks"
msgstr "posamezne sledi"

msgid "the individual tracks, packed"
msgstr "posamezne sledi, zapakirane"

msgid "the media data is no longer where it was"
msgstr "medijski podatki niso več tam, kjer so bili"

msgid "the mix of all tracks"
msgstr "miks vseh sledi"

msgid "the mixdown as the yardstick"
msgstr "končni miks kot merilo"

msgid "the old moov is back in place"
msgstr "stari moov je spet na svojem mestu"

msgid "the picture changes this much later than the sound"
msgstr "slika se zamenja toliko pozneje kot zvok"

msgid "the preset masters to %s LUFS, the calculation uses %s."
msgstr "prednastavitev masterira na %s LUFS, izračun uporablja %s."

msgid "the preset masters to %s LUFS -- that stands, nothing of ours adjusts."
msgstr "prednastavitev masterira na %s LUFS -- to velja, z naše strani se nič ne prilagodi."

msgid "taken from the source files, no --lufs given -- nothing is adjusted"
msgstr "prevzeto iz izvornih datotek, --lufs ni podan -- nič se ne prilagodi"

