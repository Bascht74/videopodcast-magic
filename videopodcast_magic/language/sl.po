msgstr "v datoteki ni podatkov"

msgid "no place found where exactly one person speaks -- the separation cannot be measured."
msgstr "ni mesta, kjer govori natanko ena oseba -- ločevanja ni mogoče izmeriti."

msgid "no production id in the response"
msgstr "v odgovoru ni ID-ja produkcije"

msgid "no production id in the response: %s"
msgstr "v odgovoru ni ID-ja produkcije: %s"

msgid "no timecode"
msgstr "brez časovne kode"

msgid "no video track"
msgstr "ni video sledi"

msgid "no video track in %s"
msgstr "v %s ni video sledi"

