msgstr "moov ni več na svojem mestu"

msgid "moov no longer ends at the end of the file"
msgstr "moov se ne konča več na koncu datoteke"

msgid "multi-part, no timecode -- gaps in between cannot be detected."
msgstr "večdelno, brez časovne kode -- vrzeli vmes ni mogoče zaznati."

msgid "new file name"
msgstr "novo ime datoteke"

msgid "next to each video file"
msgstr "poleg vsake video datoteke"

