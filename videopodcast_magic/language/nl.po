msgstr "Daar ontbreken bestanden -- zonder nieuwe upload valt er niets te berekenen.\n  Met --auphonic-resume upload uploadt het script opnieuw; dit kost tegoed."

msgid "For HDR the usual choice is HEVC (Main 10), AV1 or VP9 Profile 2. YouTube takes H.264 too, but it needs more bitrate."
msgstr "Voor HDR is de gebruikelijke keuze HEVC (Main 10), AV1 of VP9 Profile 2. YouTube neemt ook H.264 aan, maar dat vraagt meer bitrate."

msgid "For ten bits HEVC needs the Main 10 profile. In Resolve it sits under Deliver as \"Profile\"."
msgstr "Voor tien bits heeft HEVC het profiel Main 10 nodig. In Resolve staat het onder Deliver als \"Profile\"."

msgid "%s fps, not the %s in the file -- %s fewer frames in the same length."
msgstr "%s fps, niet de %s uit het bestand -- %s frames minder op dezelfde lengte."

msgid "%s fps, not the %s in the file -- %s more frames in the same length."
msgstr "%s fps, niet de %s uit het bestand -- %s frames meer op dezelfde lengte."

msgid "Frame spacing varies by %s %% -- the frame timing is uneven."
msgstr "De afstand tussen frames varieert met %s %% -- de frametiming is ongelijkmatig."

