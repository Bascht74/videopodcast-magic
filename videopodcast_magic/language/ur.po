msgstr "، اس کا آڈیو ٹریک مسترد ہوا"

msgid "Format"
msgstr "فارمیٹ"

msgid "Removing %s or %s takes everything under it."
msgstr "\"%s\" یا \"%s\" ہٹانے سے اس کے نیچے کی ہر چیز ہٹ جاتی ہے۔"

msgid "Timecode %s"
msgstr "ٹائم کوڈ %s"

msgid "mono"
msgstr "مونو"

msgid "placed with its camera"
msgstr "اپنے کیمرے کے ساتھ رکھا گیا"

msgid "stereo"
msgstr "اسٹیریو"

msgid " -- %s file does not fit the others"
msgid_plural " -- %s files do not fit the others"
msgstr[0] " -- %s فائل باقیوں سے میل نہیں کھاتی"
msgstr[1] " -- %s فائلیں باقیوں سے میل نہیں کھاتیں"

msgid "Cameras"
msgstr "کیمرے"

msgid "%s have the same size and running time -- possibly one recording twice."
msgstr "ایک جیسا سائز اور دورانیہ: %s -- شاید ایک ہی ریکارڈنگ دو بار۔"

msgid "ffprobe no longer opens the file"
msgstr "ffprobe اب فائل نہیں کھولتا"

msgid "ffmpeg and ffprobe are missing."
msgstr "موجود نہیں: ffmpeg اور ffprobe۔"

msgid "  %s holds a separation of a recording that has changed or gone since, or of another model -- it is not used."
msgstr "  %s میں ایسی ریکارڈنگ کی مقررین کی علیحدگی ہے جو تب سے بدل گئی یا موجود نہیں، یا کسی اور ماڈل کی -- اسے استعمال نہیں کیا جاتا۔"

msgid "%s kHz, %s bit, %s, %s"
msgstr "%s kHz، %s بٹ، %s، %s"

msgid "%s kHz, 32 bit float, %s, %s"
msgstr "%s kHz، 32 بٹ فلوٹنگ پوائنٹ، %s، %s"

msgid "%.0f LUFS (%s)"
msgstr "%.0f LUFS (%s)"

msgid "%.0f LUFS"
msgstr "%.0f LUFS"

msgid "Matrix %s"
msgstr "میٹرکس %s"

msgid "%d bit"
msgstr "%d بٹ"

msgid "%d bit -- not readable"
msgstr "%d بٹ -- ناقابلِ خواندگی"

msgid "%s  --  Software %s"
msgstr "%s  --  سافٹ ویئر %s"

msgid "colr box"
msgstr "colr باکس"

msgid "Codec"
msgstr "کوڈیک"

msgid "Bitrate"
msgstr "بٹ ریٹ"

msgid "    %-22s %dx%d, %s fps"
msgstr "    %-22s %dx%d، %s fps"

msgid "\n  TIMELINES"
msgstr "\n  TIMELINES"

msgid "\n  Import"
msgstr "\n  امپورٹ"

msgid "%s/%s %s ms %s ppm"
msgstr "%s/%s %s ms %s ppm"

msgid "Language of the sound"
msgstr "آڈیو کی زبان"

msgid "In the sound"
msgstr "آڈیو میں"

msgid "Speech"
msgstr "بول چال"

msgid "Mixed"
msgstr "مخلوط"

msgid "Speech: placed by its loudness alone. A recording that shares nothing\nwith the cameras is refused. Mixed: music or a mix lies under the voices,\nand where the loudness finds nothing the phase may place it.\nUnder \"%s\" it is always mixed."
msgstr "بول چال: صرف لاؤڈنیس کے مطابق رکھی جاتی ہے۔ جس ریکارڈنگ میں کیمروں کے ساتھ کچھ بھی\nمشترک نہ ہو، وہ رد کر دی جاتی ہے۔ مخلوط: آوازوں کے نیچے موسیقی یا مکس ہوتا ہے،\nاور جہاں لاؤڈنیس کو کچھ نہ ملے، وہاں فیز اسے رکھ سکتا ہے۔\n\"%s\" کے تحت یہ ہمیشہ مخلوط ہوتی ہے۔"

msgid "  %s: its sound matches by %s, and by %s at another place as well -- placed by its clock alone"
msgstr "  %s: اس کا آڈیو %s کی حد تک میل کھاتا ہے، اور کسی دوسری جگہ بھی %s کی حد تک -- صرف اس کی گھڑی کے مطابق جگہ دی گئی"

msgid "  shortened to at most %s each -- the first announcement ends at %s, the last begins at %s"
msgstr "  ہر ایک کو زیادہ سے زیادہ %s تک مختصر کیا گیا -- پہلا اعلان %s پر ختم ہوتا ہے، آخری %s پر شروع ہوتا ہے"

msgid "Another project lies in this folder under that name, %s -- this one stays in %s."
msgstr "اس فولڈر میں اس نام سے ایک اور پروجیکٹ موجود ہے، %s -- یہ پروجیکٹ %s میں رہتا ہے۔"

msgid "the picture did not change to the answerer there"
msgstr "وہاں تصویر جواب دینے والے کی طرف نہیں بدلی"

msgid "the answer was counted with the question before"
msgstr "جواب کو پچھلے سوال کے ساتھ گنا گیا"

msgid "%s lies in the --auphonic-done folder, among the tracks auphonic.com returned. Who speaks is worked out on the raw recordings, so name the raw one here instead."
msgstr "%s --auphonic-done فولڈر میں ہے، ان ٹریکوں کے درمیان جو auphonic.com نے واپس کیے۔ کون بول رہا ہے یہ خام ریکارڈنگز سے طے ہوتا ہے، اس لیے یہاں اس کی بجائے خام ریکارڈنگ دیں۔"

msgid "%s\n   sound not recognised; placed as the run places it"
msgstr "%s\n   آڈیو پہچانا نہیں گیا؛ جیسے رن رکھتا ہے ویسے رکھا گیا"

msgid "sound not recognised, placed by its timecode"
msgstr "آڈیو پہچانا نہیں گیا، اس کے ٹائم کوڈ سے رکھا گیا"

msgid "  %s recordings and no picture: each is joined on its own and they are not laid against each other. --multitrack puts them on one time axis."
msgstr "  %s ریکارڈنگز اور کوئی تصویر نہیں: ہر ایک الگ سے جوڑی جاتی ہے اور انہیں ایک دوسرے کے ساتھ ہم آہنگ نہیں کیا جاتا۔ --multitrack انہیں ایک وقتی محور پر رکھتا ہے۔"
