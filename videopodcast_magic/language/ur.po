msgstr "%s کی جانچ ہوئی"

msgid "%s of %s comparisons are below %s dB -- every recording against every other, in both directions."
msgstr "%s موازنے (کل %s میں سے) %s dB سے نیچے ہیں -- ہر ریکارڈنگ ہر دوسری کے مقابل، دونوں سمتوں میں۔"

