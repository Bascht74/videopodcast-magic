msgstr "منتخب"

msgid "Clock %7.2f%s | B1[%s] %s | B2[%s] %s | Audio %s %s"
msgstr "گھڑی %7.2f%s | B1[%s] %s | B2[%s] %s | آڈیو %s %s"

msgid "Close"
msgstr "بند کریں"

