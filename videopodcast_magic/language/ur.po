msgstr "  پیمائشی اعداد لکھے نہیں جا سکے: %s"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  auphonic.com سے مکس ڈاؤن: %s LUFS، پیک %s dBTP (%s)"

msgid "  No Full-Mix found -- the Timeline stays silent."
msgstr "  کوئی Full-Mix نہیں ملا -- Timeline خاموش رہتا ہے۔"

msgid "  No audio on the Timeline -- nothing to clean up."
msgstr "  Timeline پر کوئی آڈیو نہیں -- صاف کرنے کو کچھ نہیں۔"

msgid "  No cameras in the handover -- nothing to build."
msgstr "  حوالگی فائل میں کوئی کیمرا نہیں -- بنانے کو کچھ نہیں۔"

msgid "  No clips found for colour groups."
msgstr "  رنگ گروپوں کے لیے کوئی کلپ نہیں ملا۔"

