msgstr "%s طے کیا گیا؛ %s ایک کلک کی دوری پر ہے۔"

msgid "Left out, %s being taken already; %s is one click away."
msgstr "باہر رکھا گیا، کیونکہ %s پہلے سے لیا جا چکا ہے؛ %s ایک کلک کی دوری پر ہے۔"

msgid "Its sound cannot be used."
msgstr "اس کا آڈیو استعمال نہیں ہو سکتا۔"

msgid "%s\n   sound not recognised; placed by its timecode"
msgstr "%s\n   آڈیو پہچانا نہیں گیا؛ اس کے ٹائم کوڈ سے رکھا گیا"

msgid "%s   --   the app does not know this format"
msgstr "%s   --   ایپ یہ فارمیٹ نہیں جانتی"

msgid "%s  (%s)  --  %s  --  %s blocks"
msgstr "%s  (%s)  --  %s  --  %s بلاک"

msgid "%s -- what should happen with it?\nThe details are in the log."
msgstr "%s -- اس کے ساتھ کیا کیا جائے؟\nتفصیلات لاگ میں ہیں۔"

msgid "%s kHz instead of %s kHz -- converted during processing."
msgstr "%s kHz، %s kHz کی بجائے -- پروسیسنگ کے دوران تبدیل کیا جاتا ہے۔"

msgid "%s cannot be placed: its sound has nothing in common with the rest of the material, and the file carries no timecode. It needs one that fits the other recordings, and that has to be set with another program."
msgstr "%s کو رکھا نہیں جا سکتا: اس کے آڈیو میں باقی مواد سے کچھ مشترک نہیں، اور فائل میں کوئی ٹائم کوڈ نہیں۔ اسے ایسا ٹائم کوڈ چاہیے جو دوسری ریکارڈنگز سے میل کھائے، اور وہ کسی دوسرے پروگرام سے لگانا ہوگا۔"

msgid "%s fits nothing in the material and is far shorter than the rest: proposed as the intro, which is put at the front and never measured."
msgstr "%s مواد میں کسی چیز سے میل نہیں کھاتی اور باقی سے کہیں چھوٹی ہے: انٹرو کے طور پر تجویز کی گئی، جو شروع میں رکھا جاتا ہے اور کبھی ناپا نہیں جاتا۔"

msgid "%s is set, and nothing is adjusted here: the tracks leave as they were recorded, and the loudness is set where they are mixed."
msgstr "%s طے ہے، اور یہاں کچھ ایڈجسٹ نہیں کیا جاتا: ٹریک ویسے ہی باہر جاتے ہیں جیسے ریکارڈ ہوئے تھے، اور لاؤڈنیس وہاں طے ہوتی ہے جہاں انہیں مکس کیا جاتا ہے۔"

msgid "%s can be placed again and is back in the run."
msgstr "%s کو دوبارہ رکھا جا سکتا ہے اور وہ پھر سے رن میں شامل ہے۔"

msgid "%s could not be installed.\nBy hand:  %s -m pip install %s"
msgstr "%s انسٹال نہیں ہو سکا۔\nہاتھ سے:  %s -m pip install %s"

msgid "%s has no audio track."
msgstr "%s میں کوئی آڈیو ٹریک نہیں۔"

msgid "%s in %s"
msgstr "%s: %s میں"

msgid "%s in %s's microphone: %s dB quieter than in their own."
msgstr "%s، %s کے مائیکروفون میں: اپنے مائیکروفون سے %s dB آہستہ۔"

msgid "%s is in %s -- the file is now in the player."
msgstr "%s، %s میں ہے -- فائل اب پلیئر میں ہے۔"

msgid "%s is not on the axis of the episode: it is set in front of the material or after it, not cut into it. In point and Out point belong to what lies between."
msgstr "%s قسط کے محور پر نہیں: اسے مواد سے پہلے یا بعد میں رکھا جاتا ہے، اس کے اندر کاٹ کر نہیں۔ اِن پوائنٹ اور آؤٹ پوائنٹ اس کا حصہ ہیں جو درمیان میں ہے۔"

msgid "%s is in none of the video files. Is there a timecode that fits the material?"
msgstr "%s کسی ویڈیو فائل میں نہیں۔ کیا کوئی ٹائم کوڈ ہے جو مواد سے میل کھاتا ہو؟"

