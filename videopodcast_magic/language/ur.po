msgstr "%s ویڈیو فائلوں (کل %s میں سے) کے colr باکس میں نہ کوئی منحنی ہے نہ کلر اسپیس%s -- غالباً Log مواد۔"

msgid "%r is a Timecode, but there is no picture here and so no camera to count it from. Then only a value from the window start works, such as +12:30."
msgstr "%r ایک ٹائم کوڈ ہے، لیکن یہاں کوئی تصویر نہیں اور اس لیے کوئی کیمرا نہیں جس سے اسے گنا جائے۔ تب صرف وقتی دائرے کے آغاز سے کوئی قدر کام کرتی ہے، جیسے +12:30۔"

msgid "%r is a Timecode, but the time axis hangs on no clock: no file here carries one, the reference camera %s included. Then only a value from the window start works, such as +12:30."
msgstr "%r ایک ٹائم کوڈ ہے، لیکن وقتی محور کسی گھڑی سے بندھا نہیں: یہاں کسی فائل میں ٹائم کوڈ نہیں، حوالہ جاتی کیمرا %s سمیت۔ تب صرف وقتی دائرے کے آغاز سے کوئی قدر کام کرتی ہے، جیسے +12:30۔"

msgid "%r is not a Multitrack preset"
msgstr "%r کوئی Multitrack پری سیٹ نہیں"

msgid "%r is not a number."
msgstr "%r کوئی عدد نہیں۔"

msgid "%s\n   does not fit the other files: sound not recognised, no timecode.\n   %s"
msgstr "%s\n   دوسری فائلوں سے میل نہیں کھاتی: آڈیو پہچانا نہیں گیا، کوئی ٹائم کوڈ نہیں۔\n   %s"

