msgstr "Auphonic نے خرابی کی اطلاع دی: %s"

msgid "Bleed"
msgstr "رساؤ"

msgid "Blocks"
msgstr "بلاک"

msgid "Both at once does not work: the returning tracks would go to one value, our own mix to the other. Either set --lufs %.0f or change the preset."
msgstr "دونوں ایک ساتھ نہیں ہو سکتے: واپس آنے والے ٹریک ایک قدر پر جاتے، ہمارا اپنا مکس دوسری پر۔ یا تو --lufs %.0f لگائیں یا پری سیٹ تبدیل کریں۔"

msgid "Camera"
msgstr "کیمرا"

msgid "Camera audio, %s to go ..."
msgstr "کیمرا آڈیو، %s باقی ..."

msgid "%s -- preview  (length %s)"
msgstr "%s -- پیش نظارہ  (دورانیہ %s)"

msgid "Why the run cannot start"
msgstr "رن کیوں شروع نہیں ہو سکتا"

msgid "Cannot start yet: %s"
msgstr "ابھی شروع نہیں ہو سکتا: %s"

msgid "Change rejected: %s"
msgstr "تبدیلی مسترد: %s"

msgid "Check again"
msgstr "دوبارہ جانچیں"

msgid "Check the connection to Resolve again"
msgstr "Resolve سے کنکشن دوبارہ جانچیں"

msgid "Check itself failed: %s"
msgstr "جانچ خود ناکام ہوئی: %s"

msgid "Check the key and fetch Presets."
msgstr "کلید جانچیں اور پری سیٹ لائیں۔"

