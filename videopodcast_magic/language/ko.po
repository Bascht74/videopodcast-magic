msgstr "%s에 비디오 트랙이 없음"

msgid "none switched on"
msgstr "켜진 것 없음"

msgid "not checked yet"
msgstr "아직 확인하지 않음"

msgid "not in the media pool"
msgstr "Media Pool에 없음"

msgid "not measurable."
msgstr "측정할 수 없습니다."

msgid "not measurable: %s"
msgstr "측정할 수 없음: %s"

msgid "not needed with HLG"
msgstr "HLG에서는 필요 없음"

msgid "not readable (%s) -- unchecked."
msgstr "읽을 수 없음 (%s) -- 확인 안 됨."

msgid "not readable: %s"
msgstr "읽을 수 없음: %s"

msgid "nothing loaded yet"
msgstr "아직 불러온 것 없음"

msgid "nothing selected"
msgstr "선택된 것 없음"

msgid "off"
msgstr "끔"

msgid "one Timeline"
msgstr "Timeline 한 개"

msgid "only %s long, the longest recording has %s."
msgstr "길이가 %s뿐입니다. 가장 긴 녹음은 %s입니다."

msgid "overlap of %s per timecode"
msgstr "타임코드상 겹침 %s"

msgid "per track"
msgstr "트랙별"

msgid "preset does not fit the run"
msgstr "프리셋이 이번 실행에 맞지 않습니다"

msgid "previous block is shorter than the rest"
msgstr "앞 블록이 나머지보다 짧음"

msgid "processed tracks found -- nothing is uploaded"
msgstr "처리된 트랙을 찾았습니다 -- 아무것도 업로드하지 않습니다"

msgid "production finished, but no output file"
msgstr "프로덕션이 끝났지만 출력 파일이 없습니다"

msgid "recompute with the chosen preset -- the files stay\n       where they are, costs no credit"
msgstr "선택한 프리셋으로 다시 계산 -- 파일은 그대로\n       두며, 크레딧이 들지 않음"

msgid "reset"
msgstr "초기화"

msgid "running ..."
msgstr "실행 중 ..."

msgid "selected"
msgstr "선택됨"

msgid "stays out"
msgstr "제외됨"

msgid "stored file %s"
msgstr "저장된 파일 %s"

msgid "take the existing result (nothing computed, nothing paid)"
msgstr "기존 결과 사용 (계산 없음, 비용 없음)"

msgid "take the names from there and carry on with them --\n       no upload, costs nothing"
msgstr "그곳의 이름을 가져와 그대로 계속 --\n       업로드 없음, 비용 없음"

msgid "the Multitrack preset has no track stored."
msgstr "Multitrack 프리셋에 저장된 트랙이 없습니다."

msgid "the finished mixdown"
msgstr "완성된 믹스다운"

msgid "the individual tracks"
msgstr "개별 트랙"

msgid "the individual tracks, packed"
