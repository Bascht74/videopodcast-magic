msgstr "\n완료. 아래 \"결과 폴더 열기\"로 결과를 볼 수 있습니다.\n모두 맞으면 \"Resolve 프로젝트 만들기\"가 이것으로 프로젝트를 만듭니다.\n"

msgid "\nHDR CHECK  %s"
msgstr "\nHDR 확인  %s"

