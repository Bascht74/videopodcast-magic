msgstr "  Jis jau yra, su tomis pačiomis kameromis ta pačia tvarka -- jis lieka\n  nepaliestas. Norėdami naujo, ištrinkite jį programoje Resolve."

msgid "  Key frames of %s cannot be read (%s) -- the copy starts at the beginning of the file."
msgstr "  Failo %s pagrindinių kadrų perskaityti neįmanoma (%s) -- kopija prasideda nuo failo pradžios."

msgid "  Level curve not possible (%s) -- without limiter"
msgstr "  Lygio kreivė neįmanoma (%s) -- be ribotuvo"

msgid "  Limiter:           at most %s dB, the same curve on every track%s"
msgstr "  Ribotuvas:         daugiausia %s dB, ta pati kreivė kiekviename takelyje%s"

msgid "  Loudness not measurable: %s"
msgstr "  Garsumas neišmatuojamas: %s"

msgid "  Loudness not measurable -- it stays as it is."
msgstr "  Garsumas neišmatuojamas -- lieka kaip yra."

msgid "  Metrics not writable: %s"
msgstr "  Metrikų įrašyti neįmanoma: %s"

msgid "  Mixdown from auphonic.com: %s LUFS, peak %s dBTP (%s)"
msgstr "  Galutinis miksas iš auphonic.com: %s LUFS, smailė %s dBTP (%s)"

msgid "  No Full-Mix found -- the Timeline stays silent."
msgstr "  Full-Mix nerastas -- Timeline lieka be garso."

msgid "  No audio on the Timeline -- nothing to clean up."
msgstr "  Timeline neturi garso -- nėra ką tvarkyti."

msgid "  No cameras in the handover -- nothing to build."
msgstr "  Perdavime nėra kamerų -- nėra ką kurti."

msgid "  No clips found for colour groups."
msgstr "  Spalvų grupėms klipų nerasta."

msgid "  No cut left -- the Timeline stays empty."
msgstr "  Neliko nė vienos atkarpos -- Timeline lieka tuščias."

msgid "  Not handed over: the run could not place %s, so it is no camera of this episode."
msgstr "  Neperduota: vykdymui nepavyko išdėstyti: %s, todėl tai ne šio epizodo kamera."

msgid "  No measured offset for %s -- placed at the start of the axis."
msgstr "  Nėra išmatuoto poslinkio: %s -- padėta laiko ašies pradžioje."

msgid "  Nothing was found in the sound for %s -- placed by the timecode alone."
msgstr "  Garse nieko nerasta: %s -- išdėstyta tik pagal laiko kodą."

msgid "  %s: the measurement puts it at %s s, the timecode at %s s -- the measurement is used."
msgstr "  %s: pagal matavimą %s s, pagal laiko kodą %s s -- naudojamas matavimas."

msgid "  The Timeline start %s was refused: %s"
msgstr "  Timeline pradžia %s atmesta: %s"

msgid "  The Timeline starts at %s, not at %s -- every shot sits that much further in."
msgstr "  Timeline prasideda ties %s, ne ties %s -- kiekvienas planas atsiduria tiek pat toliau."

msgid "  The Timeline start %s was not accepted."
msgstr "  Timeline pradžia %s nepriimta."

msgid "  Start %s -- every shot is placed against it."
msgstr "  Pradžia %s -- pagal ją išdėstomas kiekvienas planas."

msgid "  No such Timeline existed yet -- it is only built."
msgstr "  Tokio Timeline dar nebuvo -- jis tik kuriamas."

msgid "  Note: this computes with the files uploaded at the time. They carry\n  the time window and the alignment of that day. Where the In point, the Out point\n  or the measured position differ now, the return check measures the\n  difference and moves the tracks into place."
msgstr "  Pastaba: skaičiuojama su tuo metu įkeltais failais. Juose yra\n  tos dienos laiko langas ir sulygiavimas. Jei pradžios taškas, pabaigos taškas\n  ar išmatuota padėtis dabar skiriasi, grąžinimo patikra išmatuoja\n  skirtumą ir perkelia takelius į vietą."

msgid "  Note: this ffmpeg has no soxr -- clock drift can only be taken out in\n  steps of 21 ppm."
msgstr "  Pastaba: šis ffmpeg neturi soxr -- laikrodžio dreifą galima pašalinti tik\n  21 ppm žingsniais."

msgid "  Of no consequence for the sound."
msgstr "  Garsui tai neturi reikšmės."

msgid "  Offset:          %s   (from the camera comparison)"
msgstr "  Poslinkis:          %s   (pagal kamerų palyginimą)"

msgid "  Only %s of %s shots are on the Timeline."
msgstr "  Timeline yra tik %s iš %s planų."

msgid "  Peaks:             %s dB above %s dBTP -- the limiter catches them"
msgstr "  Smailės:           %s dB virš %s dBTP -- ribotuvas jas sulaiko"

msgid "  Player: %s reports an error -- %s"
msgstr "  Grotuvas: %s praneša apie klaidą -- %s"

msgid "  Player: %s stays at %s instead of %s -- given up after %s attempts (%s)"
msgstr "  Grotuvas: %s lieka ties %s vietoj %s -- nutraukta po bandymų: %s (%s)"

msgid "  Player: audio output switches to %s"
msgstr "  Grotuvas: garso išvestis perjungiama į %s"

msgid "  Player: the audio is not running (%s) -- one more attempt."
msgstr "  Grotuvas: garsas negroja (%s) -- dar vienas bandymas."

msgid "  Please give a number between 1 and %d."
msgstr "  Įveskite skaičių nuo 1 iki %d."

msgid "  Production at auphonic.com:   %s"
msgstr "  Produkcija svetainėje auphonic.com:   %s"

msgid "  Production running (%s)"
msgstr "  Produkcija vykdoma (%s)"

msgid "  Project %r opened."
msgstr "  Projektas %r atidarytas."

msgid "  Project file could not be written: %s"
msgstr "  Projekto failo įrašyti nepavyko: %s"

msgid "  Project file not writable (%s)\n"
msgstr "  Projekto failo įrašyti neįmanoma (%s)\n"

msgid "  Range:             %s LU (speech is usually 3 to 7 LU)"
msgstr "  Diapazonas:        %s LU (kalbai įprasta nuo 3 iki 7 LU)"

msgid "  Reference: %s (%s, longest running time)"
msgstr "  Atskaita: %s (%s, ilgiausia trukmė)"

msgid "  Remains:           %s dB on every track, that is %s LUFS instead of %s"
msgstr "  Lieka:             %s dB kiekviename takelyje, t. y. %s LUFS vietoj %s"

msgid "  Resolve took no picture at all -- the Timeline is empty. Nothing\n  else is built on it."
msgstr "  Resolve nepriėmė jokio vaizdo -- Timeline tuščias. Nieko\n  daugiau ant jo nekuriama."

msgid "  Result: %s (%s) -- stays next to the video file\n"
msgstr "  Rezultatas: %s (%s) -- lieka šalia vaizdo įrašo failo\n"

msgid "  Not used:  %s."
msgstr "  Nepanaudota:  %s."

msgid "  Question: %s in the transcript, %s became a reaction cut."
msgstr "  Klausimai: transkripcijoje %s, iš jų reakcijos planais tapo %s."

msgid "  Question: no transcript, so no question was found and no reaction cut\n            happened. The words are written down from the finished mix during\n            the run; without them the setting does nothing."
msgstr "  Klausimai: transkripcijos nėra, todėl nerastas nė vienas klausimas ir nebuvo\n            reakcijos planų. Žodžiai užrašomi iš baigto mikso vykdymo\n            metu; be jų šis nustatymas nieko nedaro."

msgid "  Settings brought to preset %r"
msgstr "  Nustatymai suderinami su išankstiniu nustatymu %r"

msgid "  Start %s (earliest camera) -- otherwise everything would lie before the Timeline start."
msgstr "  Pradžia %s (anksčiausia kamera) -- kitaip viskas būtų prieš Timeline pradžią."

msgid "  Not adjusted:      taken from the source files -- no gain on any track and no\n                     limiter. The sound leaves exactly as it came in."
msgstr "  Nekoreguota:       paimta iš šaltinio failų -- jokio stiprinimo jokiame takelyje ir jokio\n                     ribotuvo. Garsas išeina lygiai toks, koks atėjo."

msgid "  Sum of tracks:     %s LUFS, peak %s dBTP%s"
msgstr "  Takelių suma:      %s LUFS, smailė %s dBTP%s"

msgid "  Target:            %s LUFS  ->  %s dB on every track"
msgstr "  Tikslas:           %s LUFS  ->  %s dB kiekviename takelyje"

msgid "  The Timeline gets %s: the highest of them, or the next rate Resolve\n  has above it. Converted upwards Resolve repeats frames, downwards it\n  throws them away. Every camera keeps its own rate, and the cut counts\n  in that one."
msgstr "  Timeline gauna %s: didžiausią iš jų arba artimiausią didesnį dažnį,\n  kurį turi Resolve. Konvertuodamas aukštyn Resolve kartoja kadrus, žemyn --\n  juos išmeta. Kiekviena kamera išlaiko savo dažnį, ir montažas skaičiuoja\n  pagal jį."

msgid "  The Full-Mix could not be imported."
msgstr "  Full-Mix nepavyko importuoti."

msgid "  The Full-Mix could not be inserted."
msgstr "  Full-Mix nepavyko įterpti."

msgid "  The cameras carry the time window and a second at each end: %s written for %s of the %s recorded."
msgstr "  Kamerose lieka laiko langas ir po sekundę kiekviename gale: įrašyta %s, tai %s iš %s įrašytos trukmės."

msgid "  The cameras lie close together (at most %s steps of brightness)."
msgstr "  Kameros artimos viena kitai (ryškumo pakopų skirtumas ne didesnis kaip %s)."

msgid "  The cut has changed: %s shots instead of %s."
msgstr "  Montažas pasikeitė: planų %s vietoj %s."

msgid "  The record of earlier runs here cannot be read (%s), so everything already in place is reported."
msgstr "  Įrašo apie ankstesnius vykdymus čia perskaityti neįmanoma (%s), todėl pranešama apie viską, kas jau yra."

msgid "  The cut stays as it was."
msgstr "  Montažas lieka koks buvo."

msgid "  The files are uploaded again -- this costs credit."
msgstr "  Failai įkeliami iš naujo -- tai kainuoja kreditų."

msgid "  The files in the folder must be named after the speakers and belong\n  to this run. Without the folder it goes through auphonic.com again."
msgstr "  Aplanke esantys failai turi būti pavadinti kalbėtojų vardais ir priklausyti\n  šiam vykdymui. Be aplanko viskas vėl eina per auphonic.com."

msgid "  The media pool stays as it is."
msgstr "  Media Pool lieka koks yra."

msgid "  The names from there are adopted:"
msgstr "  Perimami ten esantys pavadinimai:"

msgid "  There are %s tracks there and %s here -- that does not match."
msgstr "  Ten takelių: %s, čia: %s -- tai nesutampa."

msgid "  This camera could not be placed -- skipped"
msgstr "  Šios kameros nepavyko išdėstyti -- praleista"

msgid "  Time window:     %s of %s written, from %s of the camera"
msgstr "  Laiko langas:       įrašyta %s iš %s, nuo %s kameros įraše"

msgid "  Timecode %s written as bext and iXML (reference: %s)"
msgstr "  Laiko kodas %s įrašytas kaip bext ir iXML (atskaita: %s)"

msgid "  Too much:          the limiter would have to take %s dB away. More than %s dB\n                     sounds squashed -- %s dB less gain."
msgstr "  Per daug:          ribotuvui tektų nuimti %s dB. Daugiau nei %s dB\n                     skamba suspaustai -- %s dB mažiau stiprinimo."

msgid "  Transcript not possible (%s) -- it runs anyway."
msgstr "  Transkripcija neįmanoma (%s) -- vykdymas tęsiamas."

msgid "  Wide shot at the edges: skipped -- the first or last announcement\n  would be too long for a greeting."
msgstr "  Bendrasis planas kraštuose: praleista -- pirmasis ar paskutinis pranešimas\n  būtų per ilgas pasisveikinimui."

msgid "  Wide shot at the edges: until %s and from %s"
msgstr "  Bendrasis planas kraštuose: iki %s ir nuo %s"

msgid "  from %s, %s"
msgstr "  iš failo %s, %s"

msgid "  iXML for %s not written: %s"
msgstr "  Failo %s iXML neįrašytas: %s"

msgid " at high frame rates"
msgstr " esant dideliam kadrų dažniui"

msgid "%s  Audio starts per timecode at    %s"
msgstr "%s  Garso pradžia pagal laiko kodą  %s"

msgid "%s  Picture starts per timecode at  %s"
msgstr "%s  Vaizdo pradžia pagal laiko kodą %s"

msgid "%s  The audio timecode does not fit the picture at all -- probably a clock never set. The measurement is used."
msgstr "%s  Garso laiko kodas visiškai neatitinka vaizdo -- tikriausiai laikrodis niekada nebuvo nustatytas. Naudojamas matavimas."

msgid "%s  The timecode does not fit what is heard. The measurement is used."
msgstr "%s  Laiko kodas neatitinka to, kas girdima. Naudojamas matavimas."

msgid "%s from %s recordings"
msgstr "%s (įrašų: %s)"

msgid "%s is missing."
msgstr "Trūksta: %s."

msgid "%s is on more than one speaker -- a name is a person, and every person needs their own."
msgstr "Daugiau nei vienam kalbėtojui priskirta: %s -- vardas yra asmuo, ir kiekvienam asmeniui reikia savo vardo."

msgid "%s stands on more than one voice. A name is a person, and the cut puts a person on one camera -- two voices of one name would be one person in two places."
msgstr "Daugiau nei vienam balsui priskirta: %s. Vardas yra asmuo, o montažas asmenį priskiria vienai kamerai -- du to paties vardo balsai būtų vienas asmuo dviejose vietose."

msgid "  This machine can install it properly: %s"
msgstr "  Šis kompiuteris gali tai tinkamai įdiegti: %s"

msgid "  Installing it: %s"
msgstr "  Diegiama: %s"

msgid "  On this machine: %s"
msgstr "  Šiame kompiuteryje: %s"

msgid "  Installing it: pip install %s"
msgstr "  Diegiama: pip install %s"

msgid "  %s would be installed into this Python: %s"
msgstr "  %s: diegimo vieta būtų šis Python: %s"

msgid "  By hand:  %s -m pip install %s"
msgstr "  Rankiniu būdu:  %s -m pip install %s"

msgid "Could not look for a newer version: %s"
msgstr "Nepavyko patikrinti, ar yra naujesnė versija: %s"

