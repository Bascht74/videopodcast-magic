msgstr "\nTRANSKRIPCIJA"

msgid "  %s words: %s %% to one voice, %s %% to two, %s %% in a gap"
msgstr "  Žodžiai: %s -- %s %% vienam balsui, %s %% dviem, %s %% pauzėje"

