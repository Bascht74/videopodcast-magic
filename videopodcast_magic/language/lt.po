msgstr "Bendrasis planas"

msgid "Wide shot %d"
msgstr "Bendrasis planas %d"

msgid "(wide shot)"
msgstr "(bendrasis planas)"

msgid "No speaker"
msgstr "Nėra kalbėtojo"

msgid "Listener"
msgstr "Klausytojas"

msgid "Alternating"
msgstr "Pakaitomis"

msgid "No camera change"
