msgid "%s: not there"
msgstr "%s: అక్కడ లేదు"

msgid "%s: setPosition(%s), attempt %d, then at %s"
msgstr "%s: setPosition(%s), ప్రయత్నం %d, ఆ తర్వాత %s వద్ద"

