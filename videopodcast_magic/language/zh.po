msgstr "模型文件 %s 与其校验和不符。"

msgid "The speaker separation reports: %s"
msgstr "说话人分离报告：%s"

msgid " computed"
msgstr " 计算所得"

msgid " virtual"
msgstr " 虚拟"

msgid "the tracks are too much alike to separate"
msgstr "音轨过于相似，无法分离"

msgid "  Who asks -- not said here: two of the tracks carry the same speech, so the questions would go to whichever recorder was turned up loudest."
msgstr "  谁在提问 -- 此处不作判断：有两条音轨含有相同的话语，问题会被归给音量调得最大的录音机。"

msgid "  %-20s %s speaking, %s of %s sentences a question"
msgstr "  %-20s 说话 %s，%s / %s 句为提问"

msgid "  %-20s sounds like %-20s %s %% of it inside that track, %s points ahead of the next"
msgstr "  %-20s 听起来像 %-20s %s %% 在该音轨内，领先下一个 %s 个点"

