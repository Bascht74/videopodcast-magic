# What .github/workflows/stress.yml runs when a branch named stress/...
# is pushed. One KEY=value per line, no quotes, no spaces around the =.
# The workflow's header says what one run costs.

# The one test, by name, without _test.py -- as run.sh takes it.
TEST=voice_both_splits_stand
# Jobs per system. Each is a runner of its own.
SHARDS=10
# Copies of the test running at once on one runner: this is the load.
# A runner has four cores; the hang came at five to eight copies in a
# container on this Mac.
PARALLEL=6
# How often each copy runs, one after another.
ROUNDS=6
# Hard limit for one run of the test, in seconds. The test ends a stuck
# window itself at 120 s and writes its stacks, then opens the second
# window -- 126 s was measured for such a run -- so this sits above that.
LIMIT=200
# Extra busy loops on each runner, beside the copies. 0 is none.
BURN=0
# Systems, separated by blanks: ubuntu-26.04 windows-latest macos-latest.
OSES=ubuntu-26.04 windows-latest
PYTHON=3.14
# Empty: PySide6 as requirements.txt has it, the newest, as the suite
# installs it. A version (6.12.0) pins it.
PYSIDE6=
